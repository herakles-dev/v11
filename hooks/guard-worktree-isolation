#!/bin/bash
# V11 Hook: guard-worktree-isolation (PostToolUse — Task|Agent, TaskList)
#
# improvements/12 H1: isolation:"worktree" can silently no-op — the Agent
# tool accepts the param, returns success, and creates no worktree. No
# error, no warning, no signal of any kind (confirmed live: A1's commit
# d1a2db6 landed on a production branch after a requested worktree spawn).
# Nothing built since (scripts/worktree-sweep only judges mergeability of an
# ALREADY-REGISTERED worktree) has a code path for "isolation was requested
# but never happened." spec.md Decision #3: fix must be hook-enforced, not
# prompt-only.
#
# Verified this session (direct transcript inspection, not assumed):
# tool_input.isolation IS exposed on both foreground and background Agent
# calls (it's the original call param, always present).
#
# Design (two trigger points, one hook file):
#   1. Task|Agent fire (spawn time — always fires, sync or async): record
#      an expectation row with a worktree-COUNT baseline taken THIS
#      instant. Deliberately does NOT try to check "did it work" in the
#      SAME hook invocation — for a foreground completion, tool_response
#      already reflects the finished agent, so a "before" and "after"
#      count taken back-to-back within one hook fire are the same
#      measurement twice (proven false-positive in manual testing: an
#      agent that correctly used its worktree still tripped the alert,
#      because both counts were sampled AFTER the worktree already
#      existed). There is no reliable Pre-hook baseline either — parallel
#      Agent spawns in one turn can fire multiple PreToolUse events before
#      any PostToolUse returns, so a single shared scratch file would
#      cross-contaminate. Recording-only here sidesteps both problems.
#   2. TaskList fire (periodic — reuses guard-agent-stall's existing
#      trigger point rather than inventing new polling infra): reconcile
#      every still-pending expectation (sync or async alike) older than a
#      grace period against the CURRENT worktree count. By the time the
#      orchestrator's next TaskList call lands, real wall-clock time has
#      passed since the spawn-time baseline, making the comparison
#      meaningful regardless of whether the spawn was sync or async.
#
# This is a coarse, count-based signal (not a perfect per-agent
# correlation — no such correlation key is exposed) — appropriate for the
# actual failure mode being defended against: isolation being SYSTEMICALLY
# broken (never creates any worktree, ever), not a rare per-spawn flake.
# "Exact mechanism... gets worked out during implementation, not this
# spec" (spec.md Decision #3) — this is that implementation.
#
# S2-R6: the TaskList reconcile is one python3 pass over the host-global
# registry (hooks/lib/worktree_registry.py; was 4-6 jq + date per row: ~550
# forks / ~8 s per TaskList at 150 rows).
# Only `pending` rows are judged, with the same rules and the same alert and
# advisory text; terminal rows are copied through byte-for-byte. The same
# pass prunes terminal rows older than V11_WORKTREE_REGISTRY_TTL_DAYS, and a
# pending row is judged only by a TaskList in the repo that recorded it
# (V11_WORKTREE_GUARD_SCOPE) — the counts it is compared with are that repo's.
#
# Exit codes: 0 always (PostToolUse hooks never block; advisory only).
# Rollback: V11_WORKTREE_ISOLATION_GUARD=off (default on) disables entirely.
#   V11_WORKTREE_GRACE_SECONDS (120): age before a pending row is judged.
#   V11_WORKTREE_REGISTRY_TTL_DAYS (14; 0 = never): prune age for
#     alerted/resolved rows. Pending rows are never pruned on this cap.
#   V11_WORKTREE_GUARD_SCOPE (repo): =all judges every pending row against
#     the current repo, whichever repo recorded it (pre-S2-R6).
#   V11_WORKTREE_PENDING_TTL_DAYS (30; 0 = never): review #11 MED-1 — a
#     pending row is otherwise judged only by a TaskList that both sees
#     NEED_GIT and (under SCOPE=repo) matches its repo_root, so a repo that
#     never runs TaskList again would leave its row in the host-global
#     registry forever. This cap prunes a pending row past this age
#     regardless of scope, silently (no alert).
#
# Review #11 LOW-2: the TaskList reconcile's read-modify-replace of the
# registry races this same file's append below (a spawn recording its
# expectation). Both sides take a non-blocking flock on a sibling
# $REGISTRY.lock; see hooks/lib/worktree_registry.py for the reconcile
# side. The append (below) is best-effort: it appends either way, lock or
# no lock, since losing the append would silently drop the expectation
# it exists to record — the lock only avoids the common case of
# colliding with an in-flight reconcile.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

if [ "$1" == "--test" ]; then
    echo "guard-worktree-isolation v1 (improvements/12 H1)"
    exit 0
fi

[ "${V11_WORKTREE_ISOLATION_GUARD:-on}" == "off" ] && exit 0

v11_parse_input

GRACE_SECONDS="${V11_WORKTREE_GRACE_SECONDS:-120}"
[[ "$GRACE_SECONDS" =~ ^-?[0-9]+$ ]] || GRACE_SECONDS=120
TTL_DAYS="${V11_WORKTREE_REGISTRY_TTL_DAYS:-14}"
[[ "$TTL_DAYS" =~ ^[0-9]+$ ]] || TTL_DAYS=14
PENDING_TTL_DAYS="${V11_WORKTREE_PENDING_TTL_DAYS:-30}"
[[ "$PENDING_TTL_DAYS" =~ ^[0-9]+$ ]] || PENDING_TTL_DAYS=30
REGISTRY="$METRICS_DIR/worktree-expectations.jsonl"

# Count non-main worktrees for the repo at $1. Empty/non-numeric on any
# failure (not a git repo, git missing, etc.) normalizes to 0 — the whole
# check degrades to a harmless no-op for non-git working directories.
_worktree_count() {
    local root="${1:-.}" n
    n="$(git -C "$root" worktree list 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"
    [[ "$n" =~ ^[0-9]+$ ]] && printf '%s' "$n" || printf '0'
}

_repo_root() {
    local cwd="${V11_CWD:-$(pwd)}"
    git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$cwd"
}

# PostToolUse exit-0 stdout/stderr reaches only the transcript; only a JSON
# object on stdout reaches the model. Emit at most ONE such object, and only
# when there is a message. V11_WORKTREE_GUARD_CONTEXT=off keeps legacy
# plain-text-only behaviour.
_emit_context() {
    [ -n "$1" ] || return 0
    [ "${V11_WORKTREE_GUARD_CONTEXT:-on}" = "off" ] && return 0
    # Pure-bash JSON string escape: no fork (S2-R6 fork budget on TaskList).
    local m="$1"
    m="${m//\\/\\\\}"
    m="${m//\"/\\\"}"
    m="${m//$'\n'/\\n}"
    m="${m//$'\t'/\\t}"
    m="${m//$'\r'/\\r}"
    m="${m//[$'\001'-$'\037']/}"
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$m"
}

ADVISORY=""

case "$V11_TOOL_NAME" in

  Task|Agent)
    ISOLATION="$(printf '%s' "$V11_RAW_INPUT" | jq -r '.tool_input.isolation // empty' 2>/dev/null)"
    [ "$ISOLATION" != "worktree" ] && exit 0

    REPO_ROOT="$(_repo_root)"
    AGENT_ID="$(printf '%s' "$V11_RAW_INPUT" | jq -r '.tool_response.agentId // empty' 2>/dev/null)"
    SUBAGENT_TYPE="$(printf '%s' "$V11_RAW_INPUT" | jq -r '.tool_input.subagent_type // "unknown"' 2>/dev/null)"
    DESCRIPTION="$(printf '%s' "$V11_RAW_INPUT" | jq -r '.tool_input.description // ""' 2>/dev/null | head -c 200)"
    IS_ASYNC="$(printf '%s' "$V11_RAW_INPUT" | jq -r '.tool_response.isAsync // false' 2>/dev/null)"
    [ "$IS_ASYNC" == "true" ] && IS_ASYNC_JSON=true || IS_ASYNC_JSON=false
    V11_PROJECT="$(v11_read_active_project 2>/dev/null || true)"
    COUNT_AT_SPAWN="$(_worktree_count "$REPO_ROOT")"
    HEAD_AT_SPAWN="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "unknown")"

    # Base advisory: the harness may base the worktree on origin's default
    # branch, so a local HEAD ahead of origin means the agent starts stale.
    # Advisory only; any git failure skips silently (<=3 git calls).
    if [ "${V11_WORKTREE_BASE_CHECK:-on}" != "off" ] && [ "$HEAD_AT_SPAWN" != "unknown" ]; then
        _oref="$(git -C "$REPO_ROOT" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
        if [ -z "$_oref" ]; then
            _br="$(git -C "$REPO_ROOT" symbolic-ref -q --short HEAD 2>/dev/null || true)"
            if [ -n "$_br" ] && git -C "$REPO_ROOT" rev-parse -q --verify "refs/remotes/origin/$_br" >/dev/null 2>&1; then
                _oref="origin/$_br"
            fi
        fi
        if [ -n "$_oref" ]; then
            _ahead="$(git -C "$REPO_ROOT" rev-list --count "$_oref"..HEAD 2>/dev/null || true)"
            _min="${V11_WORKTREE_BASE_WARN_MIN:-1}"
            [[ "$_min" =~ ^[0-9]+$ ]] || _min=1
            if [[ "$_ahead" =~ ^[0-9]+$ ]] && [ "$_ahead" -ge "$_min" ] && [ "$_ahead" -gt 0 ]; then
                ADVISORY="$(printf 'WORKTREE BASE ADVISORY: local HEAD %s is %s commits ahead of %s.\n' "${HEAD_AT_SPAWN:0:8}" "$_ahead" "$_oref"
                printf '  If the harness bases this worktree on %s, the agent starts %s commits stale. Make the agent'"'"'s first step: git reset --keep %s\n' "$_oref" "$_ahead" "$HEAD_AT_SPAWN")"
            fi
        fi
    fi

    mkdir -p "$METRICS_DIR"
    # Review #11 LOW-2: best-effort flock against a concurrent TaskList
    # reconcile (hooks/lib/worktree_registry.py) rewriting the registry out
    # from under this append. Bounded wait, and the append runs either way
    # (lock held or not) — dropping the row on a missed lock would be worse
    # than the rare clobber it guards against.
    {
        flock -x -w 2 200 2>/dev/null
        jq -nc \
            --arg ts "$(date -Iseconds)" \
            --arg agent_id "$AGENT_ID" \
            --arg subagent_type "$SUBAGENT_TYPE" \
            --arg description "$DESCRIPTION" \
            --arg project "$V11_PROJECT" \
            --arg repo_root "$REPO_ROOT" \
            --arg head_at_spawn "$HEAD_AT_SPAWN" \
            --argjson is_async "$IS_ASYNC_JSON" \
            --argjson count_at_spawn "$COUNT_AT_SPAWN" \
            '{ts:$ts, agent_id:$agent_id, subagent_type:$subagent_type,
              description:$description, project:$project, repo_root:$repo_root,
              head_at_spawn:$head_at_spawn,
              is_async:$is_async, count_at_spawn:$count_at_spawn, status:"pending"}' \
            >> "$REGISTRY" 2>/dev/null
    } 200>"$REGISTRY.lock" 2>/dev/null
    # Deliberately no immediate check here — see header note. Reconciliation
    # happens uniformly at the next TaskList fire, once real time has passed.
    if [ -n "$ADVISORY" ]; then
        if [ "${V11_WORKTREE_GUARD_CONTEXT:-on}" = "off" ]; then
            printf '%s\n' "$ADVISORY"
        else
            printf '%s\n' "$ADVISORY" >&2
            _emit_context "$ADVISORY"
        fi
    fi
    ;;

  TaskList)
    [ -f "$REGISTRY" ] || exit 0

    # git runs only when a row may still be pending: the hook writes a
    # terminal row with "status":"alerted" or "status":"resolved" in it. A
    # pending row this scan misses is left pending (NEED_GIT=0), never
    # judged without the git facts.
    NEED_GIT=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|*'"status":"alerted"'*|*'"status":"resolved"'*) ;;
            *) NEED_GIT=1; break ;;
        esac
    done < "$REGISTRY"

    REPO_ROOT="${V11_CWD:-$PWD}"
    NOW_COUNT=0
    CURRENT_HEAD="unknown"
    if [ "$NEED_GIT" = "1" ]; then
        # One rev-parse for both: line 1 is the toplevel, line 2 HEAD (the
        # literal "HEAD" on an unborn branch; no output outside a repo). The
        # 2>/dev/null sits on a group: inside $(...) it costs bash a fork.
        { _rp="$(git -C "$REPO_ROOT" rev-parse --show-toplevel HEAD)"; } 2>/dev/null
        [[ "${_rp%%$'\n'*}" == /* ]] && REPO_ROOT="${_rp%%$'\n'*}"
        [[ "${_rp#*$'\n'}" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] && CURRENT_HEAD="${_rp#*$'\n'}"
        # Non-main worktrees = the newlines left once $(...) strips the last.
        { _wt="$(git -C "$REPO_ROOT" worktree list)"; } 2>/dev/null
        _wt="${_wt//[!$'\n']/}"
        NOW_COUNT="${#_wt}"
    fi
    # One python3 pass: judges the pending rows, prints the alerts, prunes,
    # and rewrites the registry (tmp + rename) only when something changed.
    # Measured on 150 rows: ~30 ms, where one jq 1.6 pass spends ~35 ms
    # compiling the same logic before it reads a row.
    _lib="${BASH_SOURCE[0]%/*}"
    [ "$_lib" = "${BASH_SOURCE[0]}" ] && _lib=.
    command -v python3 >/dev/null 2>&1 || exit 0
    # The registry writes its alerts to stderr and, unless
    # V11_WORKTREE_GUARD_CONTEXT=off, also as one additionalContext JSON object
    # on stdout (worktree_registry.py). Doing it there keeps this path at one
    # python3 fork, with no temp file shared across sessions.
    python3 -I -S "$_lib/lib/worktree_registry.py" "$REGISTRY" "$NEED_GIT" \
        "$REPO_ROOT" "$NOW_COUNT" "$CURRENT_HEAD" "$GRACE_SECONDS" "$TTL_DAYS" \
        "${V11_WORKTREE_GUARD_SCOPE:-repo}" "$PENDING_TTL_DAYS"
    ;;

esac

exit 0
