#!/bin/bash
# V11 Hook: detect-project
# PreToolUse hook that detects project context from file paths during Read operations.
# Sets active project file for session tracking.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

if [ "$1" == "--test" ]; then
    echo "detect-project v1"
    exit 0
fi

# Parse stdin into V11_* globals (file_path, tool_name, etc.)
v11_parse_input

# Skip if no file path detected
[ -z "$V11_FILE_PATH" ] && exit 0

# Detect project from file path
v11_detect_project

# Skip if metadata/infrastructure file
v11_is_metadata_file "$V11_FILE_PATH" && exit 0

# Write active project if detected (P4: dual-write to global + session-scoped)
# B1 (2026-05-14): sticky-first-touch. Once THIS session has been bound to a
# project (session-scoped active-project is non-empty), subsequent Reads in
# another project's CWD must NOT silently re-bind the session.
#
# CRITICAL: check the session-scoped file *directly*, not via
# v11_read_active_project. The latter falls back to the global file, which
# may carry a stale value from a prior session — using it as the sticky
# signal would leave fresh sessions unable to bind when the global is stale
# and disagrees with the current CWD-derived project.
#
# Explicit project switches go through scripts/v11-bootstrap-session which
# calls v11_write_active_project directly, bypassing this gate.
if [ -n "$V11_PROJECT" ]; then
    _SCOPED_FILE=""
    _SESSION_BOUND_PROJECT=""
    if [ -n "${V11_SESSION_ID:-}" ]; then
        _SCOPED_FILE="$METRICS_DIR/sessions/$V11_SESSION_ID/active-project"
        if [ -f "$_SCOPED_FILE" ] && [ -s "$_SCOPED_FILE" ]; then
            _SESSION_BOUND_PROJECT=$(head -n 1 "$_SCOPED_FILE" 2>/dev/null | tr -d '[:space:]')
        fi
    fi

    # Allow write when: (a) no session UUID (CLI/test fallback to global semantics),
    # (b) this session has never been bound, or (c) re-touching the same project.
    if [ -z "$_SESSION_BOUND_PROJECT" ] || [ "$_SESSION_BOUND_PROJECT" = "$V11_PROJECT" ]; then
        v11_write_active_project "$V11_PROJECT"

        # Stamp session-start on first touch — write-once, never overwrite
        _START_FILE="$SESSIONS_ROOT/$V11_PROJECT/.session-start"
        if [ -d "$SESSIONS_ROOT/$V11_PROJECT" ] && [ ! -f "$_START_FILE" ]; then
            printf '%s\n' "$(date -Iseconds)" > "$_START_FILE" 2>/dev/null || true
        fi

        # V11.17 Fix 4: Surface pending handoff once per session.
        # Goal: if a prior session left a handoff-tasks.json with open tasks,
        # the receiving session learns about it on first Read instead of
        # waiting for the user to type /v11. Rate-limited per V11_SESSION_ID
        # via marker file. Opt-out: V11_HANDOFF_NUDGE=off.
        if [ "${V11_HANDOFF_NUDGE:-}" != "off" ] && [ -n "${V11_SESSION_ID:-}" ]; then
            _HO_TASKS="$SESSIONS_ROOT/$V11_PROJECT/handoff-tasks.json"
            _NUDGE_MARKER="$METRICS_DIR/sessions/$V11_SESSION_ID/.handoff-surfaced"
            if [ -f "$_HO_TASKS" ] && [ -s "$_HO_TASKS" ] && [ ! -f "$_NUDGE_MARKER" ]; then
                _OPEN_COUNT=$(jq -r '(.open_tasks // []) | length' "$_HO_TASKS" 2>/dev/null || echo 0)
                [[ "$_OPEN_COUNT" =~ ^[0-9]+$ ]] || _OPEN_COUNT=0
                if [ "$_OPEN_COUNT" -gt 0 ]; then
                    echo "[V11] $_OPEN_COUNT open task(s) in handoff for $V11_PROJECT. Run /v11 to auto-rehydrate." >&2
                    mkdir -p "$(dirname "$_NUDGE_MARKER")" 2>/dev/null || true
                    : > "$_NUDGE_MARKER" 2>/dev/null || true
                fi
            fi
        fi
        # V11.19 Fix: Surface pending review-queue count once per session.
        # Companion to the V11.17 handoff nudge. The orchestrator now has a
        # durable signal that completed-without-review work exists; without
        # this nudge the queue is silent until /v11 is typed.
        # Opt-out: V11_REVIEW_NUDGE=off.
        if [ "${V11_REVIEW_NUDGE:-}" != "off" ] && [ -n "${V11_SESSION_ID:-}" ]; then
            _RQ_NUDGE_MARKER="$METRICS_DIR/sessions/$V11_SESSION_ID/.review-surfaced-$V11_PROJECT"
            if [ ! -f "$_RQ_NUDGE_MARKER" ]; then
                # Source common.sh once if helpers aren't available.
                # In the normal hook path, hooks/lib/common.sh has NOT been
                # sourced into detect-project yet (this hook doesn't use other
                # common.sh helpers), so we source here.
                if ! declare -f v11_review_queue_pending_count >/dev/null 2>&1; then
                    # shellcheck source=lib/common.sh
                    source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" 2>/dev/null || true
                fi
                if declare -f v11_review_queue_pending_count >/dev/null 2>&1; then
                    _RQ_PENDING=$(v11_review_queue_pending_count "$V11_PROJECT" 2>/dev/null || echo "0")
                    [[ "$_RQ_PENDING" =~ ^[0-9]+$ ]] || _RQ_PENDING=0
                    if [ "$_RQ_PENDING" -gt 0 ]; then
                        echo "[V11] $_RQ_PENDING pending review(s) for $V11_PROJECT — run scripts/review-queue pending $V11_PROJECT (or spawn adversarial-lite-reviewer)." >&2
                        mkdir -p "$(dirname "$_RQ_NUDGE_MARKER")" 2>/dev/null || true
                        : > "$_RQ_NUDGE_MARKER" 2>/dev/null || true
                    fi
                fi
            fi
        fi
        # L2.3b (v11-handoff-cross-session-loop, sprint-02): rehydrate
        # verification. Piggyback on the same hook that fires the handoff
        # nudge above — same session-scope, same first-Read timing. Compare
        # sessions/{project}/.loop-baseline.json.expected_open_tasks_count
        # (recorded at emit by the SENDING session, L1.3b) vs the live
        # per-session task-state.json count. On divergence, discriminate the
        # failure_mode and append a rehydrate_missed event to
        # ~/.agent-metrics/loop-events.jsonl via scripts/lib/loop_events.py.
        # Fire-once via marker: .rehydrate-verify-done. Opt-out:
        # V11_REHYDRATE_VERIFY=off.
        #
        # Failure_mode discrimination (from the 2026-09-01 dogfood + user steer):
        #   manual_override  — live TaskList already carries work; user wins
        #   gate_off         — V11_AUTO_REHYDRATE=off (user disabled rehydrate)
        #   skill_not_invoked— .handoff-surfaced marker exists AND live count=0
        #                      (the dogfood signature: /v11 didn't route)
        #   identity_mismatch— counts match but (session, task_id) sets differ
        #                      (v11.24 Bug-H-class ghost-task resurrection)
        #   script_error     — every other divergence (fallback)
        # Outer guard: enter when ANY of L2.1/L2.2/L2.3 is enabled. Sub-features
        # gate independently inside the block. Refined from initial
        # V11_REHYDRATE_VERIFY-only guard (broke L2.1/L2.2 tests that isolate
        # boot-delta/freshness by turning V11_REHYDRATE_VERIFY off).
        if [ -n "${V11_SESSION_ID:-}" ] \
           && { [ "${V11_REHYDRATE_VERIFY:-}" != "off" ] \
                || [ "${V11_LOOP_BOOT_DELTA:-on}" != "off" ] \
                || [ "${V11_HANDOFF_FRESHNESS_GATE:-on}" != "off" ]; }; then
            _RV_MARKER="$METRICS_DIR/sessions/$V11_SESSION_ID/.rehydrate-verify-done"
            _RV_BASELINE="$SESSIONS_ROOT/$V11_PROJECT/.loop-baseline.json"
            if [ ! -f "$_RV_MARKER" ] && [ -f "$_RV_BASELINE" ] && [ -s "$_RV_BASELINE" ] \
               && jq empty "$_RV_BASELINE" 2>/dev/null; then
                _RV_EXPECTED=$(jq -r '.expected_open_tasks_count // -1' "$_RV_BASELINE" 2>/dev/null || echo -1)
                [[ "$_RV_EXPECTED" =~ ^-?[0-9]+$ ]] || _RV_EXPECTED=-1

                # L2.2 (v11-handoff-cross-session-loop, sprint-02): freshness
                # gate. If handoff.md is older than V11_HANDOFF_MAX_AGE_DAYS
                # (default 7), prepend a stale-handoff warning. Emits via the
                # same additionalContext buffer as L2.1 so the receiving
                # session actually sees it. Rollback:
                # V11_HANDOFF_FRESHNESS_GATE=off (disables the check entirely,
                # keeping V11_HANDOFF_MAX_AGE_DAYS free as a tightening knob).
                _RV_FRESHNESS_WARN=""
                if [ "${V11_HANDOFF_FRESHNESS_GATE:-on}" != "off" ]; then
                    _RV_HANDOFF_MD="$SESSIONS_ROOT/$V11_PROJECT/handoff.md"
                    _RV_MAX_DAYS="${V11_HANDOFF_MAX_AGE_DAYS:-7}"
                    [[ "$_RV_MAX_DAYS" =~ ^[0-9]+$ ]] || _RV_MAX_DAYS=7
                    if [ "$_RV_MAX_DAYS" -gt 0 ] && [ -f "$_RV_HANDOFF_MD" ]; then
                        _RV_HANDOFF_AGE_S=$(( $(date +%s) - $(stat -c %Y "$_RV_HANDOFF_MD" 2>/dev/null || echo 0) ))
                        _RV_HANDOFF_AGE_DAYS=$(( _RV_HANDOFF_AGE_S / 86400 ))
                        if [ "$_RV_HANDOFF_AGE_DAYS" -gt "$_RV_MAX_DAYS" ]; then
                            _RV_FRESHNESS_WARN="⚠ STALE HANDOFF: handoff.md is ${_RV_HANDOFF_AGE_DAYS} days old (cap ${_RV_MAX_DAYS}d) — verify state before resuming."
                        fi
                    fi
                fi

                # L2.1 (v11-handoff-cross-session-loop, sprint-02): boot-delta
                # computation. Read baseline once, compute diff vs current
                # disk, build per-field lines + comma-joined field list (the
                # latter reused as L2.4 handoff_ack.baseline_delta_fields).
                # Emitted at end of hook via hookSpecificOutput.additionalContext
                # so the receiving session actually SEES it — stderr is
                # invisible to the model (learned from 2026-09-01 dogfood).
                # Rollback: V11_LOOP_BOOT_DELTA=off skips both compute + emit.
                _RV_DELTA_LINES=""
                _RV_DELTA_FIELDS=""
                _RV_B_HANDOFF_AT=$(jq -r '.handoff_at // ""' "$_RV_BASELINE" 2>/dev/null || echo "")
                if [ "${V11_LOOP_BOOT_DELTA:-on}" != "off" ]; then
                    _RV_B_GIT_HEAD=$(jq -r '.git_head // ""' "$_RV_BASELINE" 2>/dev/null || echo "")
                    _RV_B_SPEC_MTIME=$(jq -r '.spec_md_mtime // 0' "$_RV_BASELINE" 2>/dev/null || echo 0)
                    _V11_HOME_LOCAL="${V11_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")")}"
                    _RV_CUR_GIT_HEAD=$(cd "$_V11_HOME_LOCAL" 2>/dev/null && git rev-parse HEAD 2>/dev/null || echo "")
                    if [ -n "$_RV_B_GIT_HEAD" ] && [ -n "$_RV_CUR_GIT_HEAD" ] \
                       && [ "$_RV_B_GIT_HEAD" != "$_RV_CUR_GIT_HEAD" ]; then
                        _RV_DELTA_LINES="${_RV_DELTA_LINES}  - git HEAD advanced (${_RV_B_GIT_HEAD:0:7} → ${_RV_CUR_GIT_HEAD:0:7})
"
                        _RV_DELTA_FIELDS="${_RV_DELTA_FIELDS}git_head,"
                    fi
                    _RV_SPEC="$SESSIONS_ROOT/$V11_PROJECT/spec.md"
                    _RV_CUR_SPEC_MTIME=0
                    [ -f "$_RV_SPEC" ] && _RV_CUR_SPEC_MTIME=$(stat -c %Y "$_RV_SPEC" 2>/dev/null || echo 0)
                    if [ "$_RV_CUR_SPEC_MTIME" -gt 0 ] && [ "${_RV_B_SPEC_MTIME%.*}" != "$_RV_CUR_SPEC_MTIME" ]; then
                        _RV_SPEC_AGE_S=$(( $(date +%s) - _RV_CUR_SPEC_MTIME ))
                        if [ "$_RV_SPEC_AGE_S" -lt 60 ]; then _RV_SPEC_AGE_TEXT="${_RV_SPEC_AGE_S}s"
                        elif [ "$_RV_SPEC_AGE_S" -lt 3600 ]; then _RV_SPEC_AGE_TEXT="$((_RV_SPEC_AGE_S/60))m"
                        elif [ "$_RV_SPEC_AGE_S" -lt 86400 ]; then _RV_SPEC_AGE_TEXT="$((_RV_SPEC_AGE_S/3600))h"
                        else _RV_SPEC_AGE_TEXT="$((_RV_SPEC_AGE_S/86400))d"
                        fi
                        _RV_DELTA_LINES="${_RV_DELTA_LINES}  - spec.md modified ${_RV_SPEC_AGE_TEXT} ago
"
                        _RV_DELTA_FIELDS="${_RV_DELTA_FIELDS}spec_md_mtime,"
                    fi
                    if [ "$_RV_EXPECTED" -gt 0 ]; then
                        _RV_DELTA_LINES="${_RV_DELTA_LINES}  - handoff-tasks.json open_tasks length = ${_RV_EXPECTED}
"
                    fi
                fi

                # L2.3-specific: rehydrate verification + event emission.
                # Gated separately from L2.1/L2.2 so operators can disable
                # verification while keeping the boot-delta and freshness
                # banners live.
                if [ "${V11_REHYDRATE_VERIFY:-}" != "off" ]; then
                _RV_LIVE_STATE="$METRICS_DIR/sessions/$V11_SESSION_ID/task-state.json"
                _RV_ACTUAL=0
                _RV_COMPLETED=0
                if [ -f "$_RV_LIVE_STATE" ] && [ -s "$_RV_LIVE_STATE" ] && jq empty "$_RV_LIVE_STATE" 2>/dev/null; then
                    _RV_ACTUAL=$(jq -r '[(.open_tasks // {}) | to_entries[] | select(.value.status != "completed")] | length' "$_RV_LIVE_STATE" 2>/dev/null || echo 0)
                    [[ "$_RV_ACTUAL" =~ ^[0-9]+$ ]] || _RV_ACTUAL=0
                    _RV_COMPLETED=$(jq -r '.completed // 0' "$_RV_LIVE_STATE" 2>/dev/null || echo 0)
                    [[ "$_RV_COMPLETED" =~ ^[0-9]+$ ]] || _RV_COMPLETED=0
                fi

                if [ "$_RV_EXPECTED" -ge 0 ]; then
                    _RV_MARKER_SEEN_BIT=0
                    [ -f "$METRICS_DIR/sessions/$V11_SESSION_ID/.handoff-surfaced" ] && _RV_MARKER_SEEN_BIT=1
                    _RV_AUTO_ENV="unset"
                    case "${V11_AUTO_REHYDRATE-__UNSET__}" in
                        on) _RV_AUTO_ENV="on" ;;
                        off) _RV_AUTO_ENV="off" ;;
                        __UNSET__) _RV_AUTO_ENV="unset" ;;
                        *) _RV_AUTO_ENV="unset" ;;
                    esac

                    _RV_MODE=""
                    _RV_IDENTITY_DELTA=""
                    if [ "$_RV_EXPECTED" != "$_RV_ACTUAL" ]; then
                        # gate_off wins first — user explicitly disabled the
                        # mechanism, divergence is expected not a bug.
                        if [ "$_RV_AUTO_ENV" = "off" ]; then
                            _RV_MODE="gate_off"
                        # manual_override: user has evidence of activity —
                        # either completed tasks OR more open tasks than the
                        # baseline expected (added on top). Refined from
                        # the initial "any live task" heuristic which wrongly
                        # caught partial-rehydrate as manual override.
                        elif [ "$_RV_COMPLETED" -gt 0 ] || [ "$_RV_ACTUAL" -gt "$_RV_EXPECTED" ]; then
                            _RV_MODE="manual_override"
                        elif [ "$_RV_MARKER_SEEN_BIT" = "1" ] && [ "$_RV_ACTUAL" -eq 0 ]; then
                            _RV_MODE="skill_not_invoked"
                        else
                            # Fallback bucket: partial rehydrate, missing marker,
                            # any other divergence not covered above.
                            _RV_MODE="script_error"
                        fi
                    else
                        # Counts match — check identity (v11.24). Compare id sets
                        # from handoff-tasks.json.open_tasks[].id vs live state
                        # open_tasks keys. Only fires when counts equal AND expected>0.
                        if [ "$_RV_EXPECTED" -gt 0 ]; then
                            _RV_HO_TASKS="$SESSIONS_ROOT/$V11_PROJECT/handoff-tasks.json"
                            if [ -f "$_RV_HO_TASKS" ] && [ -f "$_RV_LIVE_STATE" ]; then
                                _RV_EXPECTED_IDS=$(jq -r '[(.open_tasks // [])[] | (.id // "") | tostring] | sort | @csv' "$_RV_HO_TASKS" 2>/dev/null || echo "")
                                _RV_ACTUAL_IDS=$(jq -r '[((.open_tasks // {}) | keys[])] | sort | @csv' "$_RV_LIVE_STATE" 2>/dev/null || echo "")
                                if [ -n "$_RV_EXPECTED_IDS" ] && [ "$_RV_EXPECTED_IDS" != "$_RV_ACTUAL_IDS" ]; then
                                    _RV_MODE="identity_mismatch"
                                    _RV_IDENTITY_DELTA=$(jq -n \
                                        --argjson exp "$(printf '%s' "$_RV_EXPECTED_IDS" | jq -R 'split(",") | map(gsub("\""; ""))')" \
                                        --argjson act "$(printf '%s' "$_RV_ACTUAL_IDS" | jq -R 'split(",") | map(gsub("\""; ""))')" \
                                        '{missing: ($exp - $act), extra: ($act - $exp)}' 2>/dev/null || echo "")
                                fi
                            fi
                        fi
                    fi

                    if [ -n "$_RV_MODE" ] && [ "$_RV_MODE" != "manual_override" ]; then
                        _V11_HOME_LOCAL="${V11_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")")}"
                        _RV_LOOP_EVENTS="$_V11_HOME_LOCAL/scripts/lib/loop_events.py"
                        if [ -f "$_RV_LOOP_EVENTS" ]; then
                            _RV_EXTRA_ARGS=()
                            if [ -n "$_RV_IDENTITY_DELTA" ]; then
                                _RV_EXTRA_ARGS+=(--identity-delta "$_RV_IDENTITY_DELTA")
                            fi
                            timeout 5 python3 "$_RV_LOOP_EVENTS" \
                                --project "$V11_PROJECT" \
                                --session-id "$V11_SESSION_ID" \
                                --kind rehydrate_missed \
                                --expected "$_RV_EXPECTED" \
                                --actual "$_RV_ACTUAL" \
                                --marker-seen "$_RV_MARKER_SEEN_BIT" \
                                --auto-rehydrate-env "$_RV_AUTO_ENV" \
                                --failure-mode "$_RV_MODE" \
                                "${_RV_EXTRA_ARGS[@]}" \
                                >/dev/null 2>&1 || true
                        fi
                    elif [ -z "$_RV_MODE" ] && [ "${V11_LOOP_ACK_EVENT:-on}" != "off" ]; then
                        # L2.4 (v11-handoff-cross-session-loop, sprint-02):
                        # SUCCESS path — verification passed (counts + IDs
                        # match, no divergence). Emit handoff_ack so the
                        # loop-events.jsonl carries a receipt of a healthy
                        # cross-session cycle. Reuses L2.1's _RV_DELTA_FIELDS
                        # (comma-joined) so baseline_delta_fields captures
                        # what changed since the sending session's emit
                        # without a second compute. Rollback:
                        # V11_LOOP_ACK_EVENT=off silences receipts without
                        # affecting rehydrate_missed emission.
                        _V11_HOME_LOCAL="${V11_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")")}"
                        _RV_LOOP_EVENTS="$_V11_HOME_LOCAL/scripts/lib/loop_events.py"
                        if [ -f "$_RV_LOOP_EVENTS" ] && [ -n "$_RV_B_HANDOFF_AT" ]; then
                            # baseline_delta_fields defaults to empty list when
                            # nothing changed — L2.4 contract says the field is
                            # always present so consumers can grep for '[]'.
                            _RV_ACK_DELTAS="${_RV_DELTA_FIELDS%,}"  # strip trailing comma
                            timeout 5 python3 "$_RV_LOOP_EVENTS" \
                                --project "$V11_PROJECT" \
                                --session-id "$V11_SESSION_ID" \
                                --kind handoff_ack \
                                --expected "$_RV_EXPECTED" \
                                --actual "$_RV_ACTUAL" \
                                --prev-handoff-at "$_RV_B_HANDOFF_AT" \
                                --identity-matched 1 \
                                --baseline-delta-fields "$_RV_ACK_DELTAS" \
                                >/dev/null 2>&1 || true
                        fi
                    fi

                fi
                fi  # V11_REHYDRATE_VERIFY gate close

                # Fire-once regardless of which sub-feature ran (L2.1 boot-delta,
                # L2.2 freshness, and/or L2.3 rehydrate verification). Written
                # only when the block actually entered — under all-off env the
                # outer guard already short-circuits.
                mkdir -p "$(dirname "$_RV_MARKER")" 2>/dev/null || true
                : > "$_RV_MARKER" 2>/dev/null || true
            fi
        fi
        # V11 S1 (v11-ledger-integrity): DETECT reconciliation surface.
        # Consolidates four half-wired control-loop signals into one JSON block
        # on stderr. Default off — opt-in by setting V11_DETECT_RECONCILE to
        # any non-"off" value (e.g. "on"). Mutates nothing: no writes, no
        # TaskUpdate, no enqueue. Hook count stays 17 (no new hook).
        # Rollback: unset V11_DETECT_RECONCILE or set to "off".
        if [ "${V11_DETECT_RECONCILE:-off}" != "off" ] && [ -n "${V11_PROJECT:-}" ]; then
            # Guard: ensure common.sh helpers are loaded (mirrors review-nudge pattern)
            if ! declare -f v11_fold_manifest_read >/dev/null 2>&1; then
                source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" 2>/dev/null || true
            fi

            # Signal 1: zombie/discipline — READ the existing discipline log only.
            # V11.27 review M1: invoking handoff-discipline-check here would WRITE
            # .handoff-discipline-log.json on every Read, breaking S1's read-only
            # contract (and amplifying disk writes on the hot path). The log is
            # refreshed at session-end by the V11.18 discipline detector; we accept
            # stale-by-one-session to keep DETECT strictly non-mutating.
            _DISC_LOG="$SESSIONS_ROOT/$V11_PROJECT/.handoff-discipline-log.json"
            _DC_JSON='{}'
            [ -f "$_DISC_LOG" ] && _DC_JSON=$(cat "$_DISC_LOG" 2>/dev/null || echo '{}')
            _DC_COUNT=$(printf '%s' "$_DC_JSON" | jq -r '.stale_in_progress_count // 0' 2>/dev/null || echo 0)
            [[ "${_DC_COUNT:-}" =~ ^[0-9]+$ ]] || _DC_COUNT=0
            _DC_IDS=$(printf '%s' "$_DC_JSON" | jq -c '[.nudges[]? | .id] // []' 2>/dev/null || echo '[]')

            # Signal 2: review queue — invoke pending list fresh
            _RQ_JSON=$("$V11_HOME/scripts/review-queue" pending "$V11_PROJECT" --json 2>/dev/null || echo '[]')
            _RQ_PENDING=$(printf '%s' "$_RQ_JSON" | jq 'length' 2>/dev/null || echo 0)
            [[ "${_RQ_PENDING:-}" =~ ^[0-9]+$ ]] || _RQ_PENDING=0
            _RQ_UNKNOWN=$(printf '%s' "$_RQ_JSON" | \
                jq '[.[] | select(.agent_id == "unknown")] | length' 2>/dev/null || echo 0)
            [[ "${_RQ_UNKNOWN:-}" =~ ^[0-9]+$ ]] || _RQ_UNKNOWN=0

            # Signal 3: fold families — read manifest from disk via helper
            _FM_JSON=$(v11_fold_manifest_read "$V11_PROJECT" 2>/dev/null || echo '{}')
            _FM_COUNT=$(printf '%s' "$_FM_JSON" | jq -r '.output_count // 0' 2>/dev/null || echo 0)
            [[ "${_FM_COUNT:-}" =~ ^[0-9]+$ ]] || _FM_COUNT=0
            _FM_MERGE=$(printf '%s' "$_FM_JSON" | \
                jq -r '((.input_count // 0) - (.output_count // 0)) | if . < 0 then 0 else . end' \
                2>/dev/null || echo 0)
            [[ "${_FM_MERGE:-}" =~ ^[0-9]+$ ]] || _FM_MERGE=0

            # Signal 4: retro counter — read from disk via helper
            _RC_VAL=$(v11_retro_counter_read "$V11_PROJECT" 2>/dev/null || echo 0)
            [[ "${_RC_VAL:-}" =~ ^[0-9]+$ ]] || _RC_VAL=0
            _RC_THR="${V11_RETRO_THRESHOLD:-5}"
            [[ "${_RC_THR:-}" =~ ^[0-9]+$ ]] || _RC_THR=5
            _RC_FLY="false"
            [ "$_RC_VAL" -gt $(( _RC_THR * 10 )) ] && _RC_FLY="true"

            # Emit one compact JSON object to stderr — capture first so a jq error emits nothing
            _RECONCILE_OUT=$(jq -cn \
                --argjson zombie_count "${_DC_COUNT}" \
                --argjson zombie_ids "${_DC_IDS}" \
                --argjson rq_pending "${_RQ_PENDING}" \
                --argjson rq_unknown "${_RQ_UNKNOWN}" \
                --argjson fm_count "${_FM_COUNT}" \
                --argjson fm_merge "${_FM_MERGE}" \
                --argjson rc_val "${_RC_VAL}" \
                --argjson rc_thr "${_RC_THR}" \
                --argjson rc_fly "${_RC_FLY}" \
                '{"v11_detect_reconcile": {
                    "zombie_tasks":  {"count": $zombie_count, "ids": $zombie_ids},
                    "review_queue":  {"pending": $rq_pending, "unknown_attribution": $rq_unknown},
                    "fold_families": {"count": $fm_count, "mergeable_candidates": $fm_merge},
                    "retro_counter": {"value": $rc_val, "threshold": $rc_thr, "flywheel_suspect": $rc_fly}
                }}' 2>/dev/null) && printf '%s\n' "$_RECONCILE_OUT" >&2 || true
        fi
    fi
    # else: this session is already bound to $_SESSION_BOUND_PROJECT; drift to
    # $V11_PROJECT is suppressed. Use v11-bootstrap-session to switch.
fi

# Time injection — cache Chicago timezone for skills/agents
# HS-011 (Wave 3c): defensive check that source succeeded; disown to prevent zombies
if [ -f "$(dirname "${BASH_SOURCE[0]}")/lib/get-chicago-time.sh" ]; then
  source "$(dirname "${BASH_SOURCE[0]}")/lib/get-chicago-time.sh"
  if declare -f inject_chicago_time >/dev/null 2>&1; then
    inject_chicago_time &  # Background — don't slow down hook
    disown $! 2>/dev/null || true
  fi
fi

# L2.1 / L2.2 emit (v11-handoff-cross-session-loop, sprint-02): surface
# freshness gate + boot-delta banner to the model via additionalContext.
# stderr from this hook is invisible to the model (the 2026-09-01 dogfood
# finding); stdout JSON of shape
# {"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"..."}}
# is the ONLY channel the model actually reads. Pattern mirrors
# hooks/sync-tasks:3164-3208 (S1-B1 prescope advisories). This hook has no
# other stdout producer, so no arbitration is needed here.
if [ -n "${_RV_FRESHNESS_WARN:-}" ] || [ -n "${_RV_DELTA_LINES:-}" ]; then
    _RV_ADDL_CTX=""
    if [ -n "${_RV_FRESHNESS_WARN:-}" ]; then
        _RV_ADDL_CTX="${_RV_FRESHNESS_WARN}
"
    fi
    if [ -n "${_RV_DELTA_LINES:-}" ] && [ -n "${_RV_B_HANDOFF_AT:-}" ]; then
        _RV_ELAPSED_TEXT=""
        _RV_ELAPSED_S=$(python3 -c "
import datetime, sys
try:
    a = datetime.datetime.fromisoformat(sys.argv[1])
    b = datetime.datetime.now().astimezone()
    print(int((b - a).total_seconds()))
except Exception:
    print(0)
" "$_RV_B_HANDOFF_AT" 2>/dev/null || echo 0)
        [[ "$_RV_ELAPSED_S" =~ ^[0-9]+$ ]] || _RV_ELAPSED_S=0
        if [ "$_RV_ELAPSED_S" -lt 60 ]; then _RV_ELAPSED_TEXT="${_RV_ELAPSED_S}s"
        elif [ "$_RV_ELAPSED_S" -lt 3600 ]; then _RV_ELAPSED_TEXT="$((_RV_ELAPSED_S/60))m"
        elif [ "$_RV_ELAPSED_S" -lt 86400 ]; then _RV_ELAPSED_TEXT="$((_RV_ELAPSED_S/3600))h"
        else _RV_ELAPSED_TEXT="$((_RV_ELAPSED_S/86400))d"
        fi
        _RV_ADDL_CTX="${_RV_ADDL_CTX}⚡ SINCE LAST HANDOFF (${_RV_B_HANDOFF_AT} → now, ${_RV_ELAPSED_TEXT}):
${_RV_DELTA_LINES%$'\n'}"
    fi
    if [ -n "$_RV_ADDL_CTX" ]; then
        jq -n -c --arg ctx "$_RV_ADDL_CTX" \
            '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $ctx}}' \
            2>/dev/null || true
    fi
fi

exit 0
