#!/bin/bash
# Generate CLAUDE.md section 14 from V11_AGENT_REGISTRY.json
# Usage: ./scripts/generate-agent-roster

HERCULES_ROOT="${HERCULES_ROOT:-$HOME}"
REGISTRY="$HERCULES_ROOT/v11/agents/V11_AGENT_REGISTRY.json"

if [[ ! -f "$REGISTRY" ]]; then
    echo "Error: V11_AGENT_REGISTRY.json not found at $REGISTRY" >&2
    exit 1
fi

cat <<'EOF'
## 14. Agent Roster

<!-- Auto-generated by scripts/generate-agent-roster -->

| # | Agent | Model | Effort | Default Mode | Role |
|---|-------|-------|--------|-------------|------|
EOF

i=1
jq -r '.agents | to_entries | sort_by(.key) | .[] |
    "\(.key) | \(if .value.model == "sonnet" then "Sonnet 4.6" elif .value.model == "opus" then "Opus 4.6" else .value.model end) | \(.value.effort_level // "—") | \(.value.default_mode) | \(.value.description)"' \
    "$REGISTRY" | while IFS= read -r line; do
        echo "| $i | $line |"
        ((i++))
    done

cat <<'EOF'
| — | Team Lead | Opus 4.6 | high | Main session | Orchestration (was conductor) |
EOF
