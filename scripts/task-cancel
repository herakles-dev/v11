#!/usr/bin/env bash
# V11 Script: task-cancel
#
# Sanctioned writer for appending a "cancelled" event to a project's durable
# ledger (~/.agent-metrics/ledger/$PROJECT.jsonl). Closes the tooling gap
# left by improvement #17: that fix sanctioned "append a cancelled event" as
# the remediation for mis-attributed/foreign tasks, but shipped no tooling —
# sessions hand-appended events missing subject_norm/create_seq, which broke
# replay keying (improvement #24, now fixed reader-side).
#
# This script always appends through v11_ledger_append (hooks/lib/common.sh)
# so the envelope is validated and the cancel event carries the SAME
# identity fields (subject_norm, create_seq) as the task's `created` event —
# the fold keys records by (project, subject_norm, create_seq); a cancel
# event with mismatched identity fields lands on the wrong record (or a
# phantom one).
#
# DELIBERATE: no counters_delta on the emitted event. The replay's realign
# derivation (common.sh ~§3.3, "counters realigned to per-identity set")
# re-derives pending/in_progress/completed/blocked strictly from record
# status and overwrites the additive fold on any drift — a cancelled record
# leaves the open buckets by status match alone, and `total` semantics
# (cancelled tasks REMAIN in total) are governed by the derivation, never by
# deltas. A counters_delta here would be a post-realign no-op; do not "fix"
# this by adding one.
#
# Usage:
#   task-cancel PROJECT TASK_ID SESSION_UUID [--created-seqno N] [--identity SN:CS] [--epoch E]
#               [--create-seq N] [--reason "..."] [--dry-run]
#
#   PROJECT      Project name (^[a-zA-Z0-9._-]{1,64}$)
#   TASK_ID      Session-local task id (as recorded on the `created` event)
#   SESSION_UUID Session UUID that created the task (exact match required —
#                task_id alone is reused across sessions and is not a
#                stable identity)
#   --created-seqno N
#                Pin ONE exact `created` event by its ledger seqno (unique).
#                Required whenever (task_id, session_uuid) owns more than one
#                identity — which happens in migration/fold pseudo-sessions
#                that merged older sessions' numbering. Canonical identity is
#                (project, subject_norm, create_seq) and create_seq is assigned
#                PER subject_norm, so two identities can share task_id AND
#                create_seq with different subjects; only the seqno is unique.
#                (free-llm alignment 2026-09-18: one session carried 2-3
#                identities for 15 ids; the old latest-in-file pick mis-
#                targeted 2 already-completed records.)
#   --identity SN:CS
#                Pin the task by its identity, subject_norm:create_seq (split on
#                the last ':'), as the AMBIGUOUS listing prints it (S2-T0b-3).
#   --epoch E    Narrow to the `created` events stamped with TaskList epoch E
#                (tl_epoch); still refuses if that epoch holds several.
#   --create-seq N
#                Optional narrowing filter on create_seq (NOT sufficient on its
#                own — see above; the script still refuses if ambiguous).
#   --reason     Cancellation reason (default: "task-cancel script")
#   --dry-run    Print the event that WOULD be appended; do not write
#
# Finds the `created` event for (task_id, session_uuid[, create_seq][, seqno])
# in the project's ledger, copies its v/subject_norm/create_seq, and appends a
# cancelled event via v11_ledger_append. If no matching `created` event is
# found, prints near-miss candidates (same task_id, other sessions) and
# exits 1. If the match is AMBIGUOUS (more than one distinct
# (subject_norm, create_seq) identity) it REFUSES, lists every candidate with
# its `--created-seqno`, and exits 2 — it never guesses which record to close.
# S2-T0b-3 (#113, review #19 C10): a session that resumed reuses task ids, one
# per TaskList epoch, and the zombies this script exists to close are mostly
# older epochs' tasks under a reused id. So several identities still refuse,
# never defaulting to the current epoch's (review #23). The listing gives each
# candidate's --identity, --created-seqno, TaskList epoch and last status (a
# completed or cancelled task needs no cancel), the session's current epoch's
# create first (scripts/lib/task_epoch.py resolve). V11_TASK_RESOLVER=legacy
# prints the v11.46 listing.
#
# Exit codes: 0 success (dry-run print or real append), 1 no match / usage
# error, 2 ambiguous identity (re-run with --created-seqno N).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
V11_HOME="${V11_HOME:-$(dirname "$SCRIPT_DIR")}"
HERCULES_ROOT="${HERCULES_ROOT:-$HOME}"
METRICS_DIR="${METRICS_DIR:-$HERCULES_ROOT/.agent-metrics}"

usage() {
    sed -n '/^# V11 Script: task-cancel/,/^set -euo/p' "$0" | grep -v '^set' | sed 's/^# \?//'
    exit 1
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
fi

# --- Arg parsing: 3 required positionals + optional flags ---
REASON="task-cancel script"
DRY_RUN=false
CREATE_SEQ_SEL=""
CREATED_SEQNO_SEL=""
IDENTITY_SEL=""
EPOCH_SEL=""
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        --reason)
            REASON="${2:-}"
            shift 2
            ;;
        --create-seq)
            CREATE_SEQ_SEL="${2:-}"
            if ! printf '%s' "$CREATE_SEQ_SEL" | grep -qE '^-?[0-9]+$'; then
                echo "task-cancel: --create-seq expects an integer, got '${CREATE_SEQ_SEL}'" >&2
                exit 1
            fi
            shift 2
            ;;
        --created-seqno)
            CREATED_SEQNO_SEL="${2:-}"
            if ! printf '%s' "$CREATED_SEQNO_SEL" | grep -qE '^[0-9]+$'; then
                echo "task-cancel: --created-seqno expects a non-negative integer, got '${CREATED_SEQNO_SEL}'" >&2
                exit 1
            fi
            shift 2
            ;;
        --identity)
            IDENTITY_SEL="${2:-}"
            if ! [[ "$IDENTITY_SEL" =~ ^.+:[0-9]+$ ]]; then
                echo "task-cancel: --identity expects SUBJECT_NORM:CREATE_SEQ, got '${IDENTITY_SEL}'" >&2
                exit 1
            fi
            shift 2
            ;;
        --epoch)
            EPOCH_SEL="${2:-}"
            if ! [[ "$EPOCH_SEL" =~ ^[1-9][0-9]*$ ]]; then
                echo "task-cancel: --epoch expects a TaskList epoch (a positive integer), got '${EPOCH_SEL}'" >&2
                exit 1
            fi
            shift 2
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "task-cancel: unknown option '$1'" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

if [ "${#POSITIONAL[@]}" -lt 3 ]; then
    echo "Usage: task-cancel PROJECT TASK_ID SESSION_UUID [--reason \"...\"] [--dry-run]" >&2
    exit 1
fi

PROJECT="${POSITIONAL[0]}"
TASK_ID="${POSITIONAL[1]}"
SESSION_UUID="${POSITIONAL[2]}"

# SEC-C-02 (mirrors v11_ledger_append's own guard) — validate before any
# filesystem path construction.
if ! printf '%s' "$PROJECT" | grep -qE '^[a-zA-Z0-9._-]{1,64}$'; then
    echo "task-cancel: invalid project name '$PROJECT' (must match ^[a-zA-Z0-9._-]{1,64}\$)" >&2
    exit 1
fi

if [ -z "$TASK_ID" ] || [ -z "$SESSION_UUID" ]; then
    echo "Usage: task-cancel PROJECT TASK_ID SESSION_UUID [--reason \"...\"] [--dry-run]" >&2
    exit 1
fi

LEDGER_FILE="${METRICS_DIR}/ledger/${PROJECT}.jsonl"

if [ ! -f "$LEDGER_FILE" ]; then
    echo "task-cancel: no ledger file for project '$PROJECT' at $LEDGER_FILE" >&2
    exit 1
fi

# --- Find the `created` event(s) for this exact (task_id, session_uuid) ---
# The fold keys records by (project, subject_norm, create_seq); one
# (task_id, session_uuid) pair can legitimately own several identities when a
# migration/fold pseudo-session merged older numbering. Narrow by --create-seq
# when given; otherwise refuse below if more than one distinct create_seq.
MATCHES=$(jq -c --arg tid "$TASK_ID" --arg sid "$SESSION_UUID" --arg cs "$CREATE_SEQ_SEL" \
    'select(.ev == "created" and .task_id == $tid and .session_uuid == $sid)
     | select($cs == "" or ((.create_seq|tostring) == $cs))' \
    "$LEDGER_FILE" 2>/dev/null || true)

if [ -z "$MATCHES" ] && [ -n "$CREATE_SEQ_SEL" ]; then
    echo "task-cancel: no 'created' event found for task_id='$TASK_ID' session_uuid='$SESSION_UUID' create_seq=$CREATE_SEQ_SEL" >&2
    OTHER_SEQS=$(jq -c --arg tid "$TASK_ID" --arg sid "$SESSION_UUID" \
        'select(.ev == "created" and .task_id == $tid and .session_uuid == $sid) | {create_seq, ts, subject: (.subject // .subject_norm)}' \
        "$LEDGER_FILE" 2>/dev/null || true)
    if [ -n "$OTHER_SEQS" ]; then
        echo "Identities that DO exist for this (task_id, session_uuid):" >&2
        printf '%s\n' "$OTHER_SEQS" | jq -r '"  create_seq=\(.create_seq)  ts=\(.ts)  subject=\"\(.subject)\""' >&2
    fi
    exit 1
fi

# --created-seqno pins ONE exact `created` event by its ledger seqno (unique).
if [ -n "$MATCHES" ] && [ -n "$CREATED_SEQNO_SEL" ]; then
    MATCHES=$(printf '%s\n' "$MATCHES" | jq -c --arg sq "$CREATED_SEQNO_SEL" 'select((.seqno|tostring) == $sq)')
    if [ -z "$MATCHES" ]; then
        echo "task-cancel: no 'created' event with seqno=$CREATED_SEQNO_SEL for task_id='$TASK_ID' session_uuid='$SESSION_UUID'" >&2
        exit 1
    fi
fi

# --identity / --epoch narrow the same way (S2-T0b-3).
if [ -n "$MATCHES" ] && { [ -n "$IDENTITY_SEL" ] || [ -n "$EPOCH_SEL" ]; }; then
    NARROWED=$(printf '%s\n' "$MATCHES" | jq -c --arg sn "${IDENTITY_SEL%:*}" --arg cs "${IDENTITY_SEL##*:}" \
        --arg id "$IDENTITY_SEL" --arg ep "$EPOCH_SEL" '
        select($id == "" or ((.subject_norm // "") == $sn and (.create_seq|tostring) == $cs))
        | select($ep == "" or ((.tl_epoch // "")|tostring) == $ep)')
    if [ -z "$NARROWED" ]; then
        echo "task-cancel: no 'created' event for task_id='$TASK_ID' session_uuid='$SESSION_UUID' matches${IDENTITY_SEL:+ --identity '$IDENTITY_SEL'}${EPOCH_SEL:+ --epoch $EPOCH_SEL}. Identities that DO exist:" >&2
        printf '%s\n' "$MATCHES" | jq -r '"  --identity \u0027\(.subject_norm // ""):\(.create_seq)\u0027  --created-seqno \(.seqno)  epoch=\(.tl_epoch // "-")  ts=\(.ts)  subject=\"\(.subject // .subject_norm)\""' >&2
        exit 1
    fi
    MATCHES="$NARROWED"
fi

# Canonical identity is (project, subject_norm, create_seq) — and create_seq is
# assigned PER subject_norm, so two identities can share task_id AND create_seq
# with different subjects. Ambiguity is therefore judged on distinct
# (subject_norm, create_seq) pairs, never on create_seq alone.
if [ -n "$MATCHES" ]; then
    DISTINCT_IDS=$(printf '%s\n' "$MATCHES" | jq -r '"\(.subject_norm // "")|\(.create_seq)"' | sort -u | wc -l)
    if [ "$DISTINCT_IDS" -gt 1 ] && [ "${V11_TASK_RESOLVER:-shared}" = "legacy" ]; then
        echo "task-cancel: AMBIGUOUS — task_id='$TASK_ID' session_uuid='$SESSION_UUID' matches $DISTINCT_IDS distinct identities (subject_norm, create_seq). Refusing to guess; re-run with --created-seqno N:" >&2
        printf '%s\n' "$MATCHES" | jq -r '"  --created-seqno \(.seqno)   create_seq=\(.create_seq)  ts=\(.ts)  subject=\"\(.subject // .subject_norm)\""' >&2
        exit 2
    fi
    if [ "$DISTINCT_IDS" -gt 1 ]; then
        # The session's current TaskList epoch binds which create? Listed
        # first, as a suggestion only: an older epoch's zombie is the usual
        # target of a cancel (review #23).
        RESOLVED=$(python3 "$V11_HOME/scripts/lib/task_epoch.py" resolve "--session=$SESSION_UUID" \
            "--metrics-dir=$METRICS_DIR" --format=json -- "$PROJECT" "$TASK_ID" 2>/dev/null || true)
        EPOCH_SEQNO=$(printf '%s' "$RESOLVED" | jq -r '
            select(.status == "bound" and .basis == "current_epoch" and .claim.ev == "created"
                   and .claim.session_uuid == $sid) | .claim.seqno // empty' --arg sid "$SESSION_UUID" 2>/dev/null || true)
        IDS_JSON=$(printf '%s\n' "$MATCHES" | jq -sc '[.[] | [(.subject_norm // ""), .create_seq]] | unique')
        # Each identity's last status event (created, in_progress, blocked,
        # completed, cancelled), in ledger order.
        STATUS_MAP=$(jq -cn --argjson want "$IDS_JSON" '
            reduce (inputs | select(.ev as $e | ["created","in_progress","blocked","completed","cancelled"]
                                    | index([$e]) != null)
                    | select([(.subject_norm // ""), .create_seq] as $k | $want | index([$k]) != null)) as $r
                ({}; .["\($r.subject_norm // "")|\($r.create_seq)"] = $r.ev)' "$LEDGER_FILE" 2>/dev/null || true)
        [ -n "$STATUS_MAP" ] || STATUS_MAP='{}'
        echo "task-cancel: AMBIGUOUS — task_id='$TASK_ID' session_uuid='$SESSION_UUID' matches $DISTINCT_IDS distinct identities (subject_norm, create_seq). Refusing to guess; re-run with --identity SN:CS (or --created-seqno N, or --epoch E):" >&2
        printf '%s\n' "$MATCHES" | jq -rs --arg cur "$EPOCH_SEQNO" --argjson st "$STATUS_MAP" '
            (map(select((.seqno|tostring) == $cur)) + map(select((.seqno|tostring) != $cur)))[]
            | "  --identity \u0027\(.subject_norm // ""):\(.create_seq)\u0027  --created-seqno \(.seqno)"
              + "  epoch=\(.tl_epoch // "-")\(if (.seqno|tostring) == $cur then " (current)" else "" end)"
              + "  status=\($st["\(.subject_norm // "")|\(.create_seq)"] // "?")"
              + "  ts=\(.ts)  subject=\"\(.subject // .subject_norm)\""' >&2
        exit 2
    fi
fi

if [ -z "$MATCHES" ]; then
    echo "task-cancel: no 'created' event found in $LEDGER_FILE for task_id='$TASK_ID' session_uuid='$SESSION_UUID'" >&2
    NEAR_MISSES=$(jq -c --arg tid "$TASK_ID" \
        'select(.ev == "created" and .task_id == $tid) | {session_uuid, subject: (.subject // .subject_norm), ts}' \
        "$LEDGER_FILE" 2>/dev/null | sort -u || true)
    if [ -n "$NEAR_MISSES" ]; then
        echo "" >&2
        echo "Near-miss candidates (same task_id, other sessions):" >&2
        printf '%s\n' "$NEAR_MISSES" | jq -r '"  session_uuid=" + .session_uuid + "  ts=" + .ts + "  subject=\"" + .subject + "\""' >&2
    else
        echo "  (no 'created' events found for task_id='$TASK_ID' in any session)" >&2
    fi
    exit 1
fi

# Most recent = last line in file order (ledger is append-only).
MATCH=$(printf '%s\n' "$MATCHES" | tail -n 1)

SUBJECT_NORM=$(printf '%s' "$MATCH" | jq -r '.subject_norm // ""')
CREATE_SEQ=$(printf '%s' "$MATCH" | jq -r '.create_seq // empty')
LEDGER_V=$(printf '%s' "$MATCH" | jq -r '.v // empty')

if [ -z "$CREATE_SEQ" ]; then
    echo "task-cancel: matched 'created' event has no create_seq — refusing to build an unsafe cancel event (project=$PROJECT task_id=$TASK_ID session_uuid=$SESSION_UUID)" >&2
    exit 1
fi
if [ -z "$LEDGER_V" ]; then
    LEDGER_V=1
fi

NOW="$(date -Iseconds)"

EVENT_JSON=$(jq -cn \
    --argjson v "$LEDGER_V" \
    --arg ts "$NOW" \
    --arg project "$PROJECT" \
    --arg task_id "$TASK_ID" \
    --arg session_uuid "$SESSION_UUID" \
    --arg subject_norm "$SUBJECT_NORM" \
    --argjson create_seq "$CREATE_SEQ" \
    --arg reason "$REASON" \
    '{
        v: $v,
        ev: "cancelled",
        ts: $ts,
        project: $project,
        task_id: $task_id,
        session_uuid: $session_uuid,
        subject_norm: $subject_norm,
        create_seq: $create_seq,
        reason: $reason
    }')

if [ "$DRY_RUN" = true ]; then
    echo "task-cancel: DRY RUN — would append the following event to $LEDGER_FILE:" >&2
    printf '%s\n' "$EVENT_JSON" | jq '.'
    exit 0
fi

# shellcheck source=../hooks/lib/common.sh
source "$V11_HOME/hooks/lib/common.sh"

v11_ledger_append "$PROJECT" "$EVENT_JSON" || true

echo "task-cancel: appended cancelled event — project=$PROJECT task_id=$TASK_ID subject_norm=\"$SUBJECT_NORM\""
