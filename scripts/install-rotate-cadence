#!/usr/bin/env bash
# Install/uninstall the V11 weekly rotate-metrics cadence as a user crontab entry.
#
# Mirrors scripts/install-review-cadence's install/uninstall/idempotent-marker
# contract, but simpler: rotate-metrics (scripts/rotate-metrics) is a pure
# filesystem housekeeping script with no `claude` CLI dependency, so no
# PATH-resolving run wrapper is needed — the cron line invokes rotate-metrics
# directly.
#
# Usage:
#   install-rotate-cadence [--time HH:MM] [--day 0-6]
#   install-rotate-cadence --dry-run
#   install-rotate-cadence --status
#   install-rotate-cadence --uninstall
#
# Behavior:
#   - install (default): adds/replaces a single marked crontab line:
#       <MIN> <HOUR> * * <DAY> <V11_HOME>/scripts/rotate-metrics \
#         >> ~/.agent-metrics/rotate-metrics.log 2>&1   # v11-rotate-metrics
#     Default schedule: weekly, Sunday (day=0) at 04:15. Idempotent —
#     re-running replaces the marked line, never duplicates it.
#
#     Backs up the current crontab to ~/.v11-backups/crontab.<ISO8601Z>
#     BEFORE making any change (install or uninstall) — never on --dry-run
#     or --status, since those make no change.
#
#   - --dry-run: prints the line that would be installed/replaced. Writes
#     nothing (no crontab write, no backup file).
#   - --status: prints the current marked crontab entry (if any).
#   - --uninstall: removes the marked crontab line (and only that line),
#     after backing up the crontab. Every other crontab line is left
#     byte-for-byte untouched.
#
# Marker (for idempotent replace / removal): "# v11-rotate-metrics"
#
# Rollback:
#   install-rotate-cadence --uninstall   — removes the crontab line
#   (rotate-metrics itself has no cadence-gating env var — it's a plain
#   filesystem script; uninstalling the cron entry is the only lever)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
V11_HOME="${V11_HOME:-$(dirname "$SCRIPT_DIR")}"
ROTATE_METRICS="${V11_HOME}/scripts/rotate-metrics"
METRICS_DIR="${HOME}/.agent-metrics"
CRON_LOG="${METRICS_DIR}/rotate-metrics.log"
BACKUP_DIR="${HOME}/.v11-backups"

MARKER="# v11-rotate-metrics"
TIME="04:15"
DAY="0"   # 0 = Sunday
MODE="install"

while [ $# -gt 0 ]; do
    case "$1" in
        --time)
            TIME="${2:-}"
            shift
            ;;
        --day)
            DAY="${2:-}"
            shift
            ;;
        --dry-run)
            MODE="dry-run"
            ;;
        --uninstall)
            MODE="uninstall"
            ;;
        --status)
            MODE="status"
            ;;
        -h|--help)
            sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "install-rotate-cadence: unknown argument '$1'" >&2
            exit 2
            ;;
    esac
    shift
done

if ! printf '%s' "$TIME" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$'; then
    echo "install-rotate-cadence: --time must be HH:MM (24h), got '$TIME'" >&2
    exit 1
fi

if ! printf '%s' "$DAY" | grep -qE '^[0-6]$'; then
    echo "install-rotate-cadence: --day must be 0-6 (0=Sunday), got '$DAY'" >&2
    exit 1
fi

HOUR="${TIME%%:*}"
MINUTE="${TIME##*:}"
# Strip any leading zero so cron doesn't treat e.g. "08" as octal in some parsers.
HOUR="$((10#$HOUR))"
MINUTE="$((10#$MINUTE))"

if [ ! -x "$ROTATE_METRICS" ]; then
    echo "install-rotate-cadence: WARNING — rotate-metrics not found/executable at $ROTATE_METRICS" >&2
fi

CRON_LINE="${MINUTE} ${HOUR} * * ${DAY} ${ROTATE_METRICS} >> ${CRON_LOG} 2>&1 ${MARKER}"

_backup_crontab() {
    mkdir -p "$BACKUP_DIR"
    local ts backup_path
    # Nanosecond resolution (GNU date %N) so two backups taken within the
    # same wall-clock second (e.g. install immediately followed by
    # uninstall) never collide and silently clobber an earlier backup's
    # content. Falls back to second resolution + PID if %N isn't supported.
    ts=$(date -u +%Y%m%dT%H%M%S.%NZ 2>/dev/null || echo "")
    case "$ts" in
        *%N*|"") ts="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || date +%Y%m%dT%H%M%SZ).$$" ;;
    esac
    backup_path="${BACKUP_DIR}/crontab.${ts}"
    crontab -l > "$backup_path" 2>/dev/null || : > "$backup_path"
    printf '%s' "$backup_path"
}

# ── Dry run ──────────────────────────────────────────────────────────────
if [ "$MODE" = "dry-run" ]; then
    echo "install-rotate-cadence: [DRY-RUN] would install/replace crontab line:"
    echo "  ${CRON_LINE}"
    exit 0
fi

# ── Status ───────────────────────────────────────────────────────────────
if [ "$MODE" = "status" ]; then
    _current="$(crontab -l 2>/dev/null | grep -F "$MARKER" || true)"
    if [ -z "$_current" ]; then
        echo "install-rotate-cadence: no v11-rotate-metrics entry installed."
        exit 0
    fi
    echo "install-rotate-cadence: current entry:"
    echo "$_current"
    exit 0
fi

# ── Uninstall ────────────────────────────────────────────────────────────
if [ "$MODE" = "uninstall" ]; then
    _existing="$(crontab -l 2>/dev/null || true)"
    if ! grep -qF "$MARKER" <<<"$_existing"; then
        echo "install-rotate-cadence: no v11-rotate-metrics entry found — nothing to remove."
        exit 0
    fi
    _backup_path=$(_backup_crontab)
    # NOTE: `grep -vF` exits 1 (under pipefail, that fails the whole pipeline)
    # when it filters out every line -- i.e. when the marked line was the
    # ONLY crontab entry. `|| true` keeps that a legitimate "nothing left"
    # result instead of aborting the script under `set -e`.
    _remaining="$(printf '%s\n' "$_existing" | grep -vF "$MARKER" || true)"
    if [ -z "$_remaining" ]; then
        printf '' | crontab -
    else
        printf '%s\n' "$_remaining" | crontab -
    fi
    echo "install-rotate-cadence: removed v11-rotate-metrics crontab entry."
    echo "Crontab backup: ${_backup_path}"
    exit 0
fi

# ── Install ──────────────────────────────────────────────────────────────
_backup_path=$(_backup_crontab)

_existing="$(crontab -l 2>/dev/null || true)"
if grep -qF "$MARKER" <<<"$_existing"; then
    # Same pipefail/set-e caveat as the uninstall branch above: if the
    # marked line was the only entry, grep -vF legitimately produces no
    # output and exits 1 -- `|| true` keeps that from aborting the script.
    _new="$(printf '%s\n' "$_existing" | grep -vF "$MARKER" || true)"
    if [ -z "$_new" ]; then
        printf '%s\n' "$CRON_LINE" | crontab -
    else
        printf '%s\n%s\n' "$_new" "$CRON_LINE" | crontab -
    fi
    echo "install-rotate-cadence: replaced existing v11-rotate-metrics entry."
else
    if [ -z "$_existing" ]; then
        printf '%s\n' "$CRON_LINE" | crontab -
    else
        printf '%s\n%s\n' "$_existing" "$CRON_LINE" | crontab -
    fi
    echo "install-rotate-cadence: installed v11-rotate-metrics entry."
fi

echo ""
echo "Schedule: weekly, day=${DAY} (0=Sun) at ${TIME}"
echo "Script:   ${ROTATE_METRICS}"
echo "Log:      ${CRON_LOG}"
echo "Crontab backup: ${_backup_path}"
echo ""
echo "Rollback:"
echo "  install-rotate-cadence --uninstall   — remove this crontab entry"
