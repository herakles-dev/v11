#!/usr/bin/env bash
# check-stamp-drift — mechanized version-stamp drift detection.
#
# ROOT CAUSE this defends (W2-T6): version stamps across the repo (agent registry,
# README, VERSION.md, CLAUDE.md) drift out of sync with the actual protocol version
# because nothing checks them against a ground truth — the "hand-sweep" was the only
# mechanism, and it lapsed for 8-18 versions across just 2 months before the last manual
# sweep. This closes that gap the same way check-changelog-drift closed the §17 gap.
#
# Anchor: the protocol version is derived from git commit history (git log -60, same
# pattern as the v11-coherence gate's DC1 anchor), NEVER from any in-repo string — an
# in-repo string could itself be stale, which is exactly the failure mode being guarded
# against.
#
# Checked surfaces (hardcoded list — add new surfaces here, not scattered elsewhere):
#   agents/V11_AGENT_REGISTRY.json  — metadata.version + every agents[*].version
#   README.md                       — "## Current Version: V11.x" heading
#   VERSION.md                      — newest "## v11.x" section heading
#   CLAUDE.md                       — "**Current: v11.x**" §17 pointer
#
# A surface whose claimed version's MAJOR.MINOR != anchor's MAJOR.MINOR → STAMP_DRIFT
# finding (patch-level differences are tolerated, mirroring check-changelog-drift's
# same-minor leniency — a stamp at v11.29.2 against anchor v11.29 is not drift).
#
# Soft-block: wired into scripts/run-tests --regression; surfaces but never shadows a
# pytest failure. Rollback: V11_STAMP_DRIFT=off (no-op, always exit 0).
#
# Does NOT fix stale stamps — that's W2-T7, run this tool again after that merge to verify.
set -uo pipefail

V11_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

JSON_MODE=0
for arg in "$@"; do
    case "$arg" in
        --json) JSON_MODE=1 ;;
    esac
done

say() { printf '%s\n' "$*" >&2; }

if [ "${V11_STAMP_DRIFT:-on}" = "off" ]; then
    say "check-stamp-drift: disabled (V11_STAMP_DRIFT=off) — no-op."
    exit 0
fi

# --- Checked surfaces (file paths relative to V11_ROOT) ---
SURFACES=(
    "agents/V11_AGENT_REGISTRY.json"
    "README.md"
    "VERSION.md"
    "CLAUDE.md"
)

norm() {
    # Extract MAJOR.MINOR from a version-ish string (drop leading v, drop patch).
    printf '%s' "$1" | grep -oE '[0-9]+\.[0-9]+' | head -1
}

# --- Anchor: derive from git log, NEVER trust in-repo strings ---
# --no-merges: default merge subjects embed the branch name (e.g. "into v11.28-handoff-steer"),
# which pollutes the anchor with the branch's version, not the protocol's (found live 2026-07-11).
# Recency-preserving but subject-safe: take the MOST RECENT subject containing a
# version token, then the semver-MAX token WITHIN that subject — a subject that
# mentions an old version before the current one ("stale v11.33 ref -> v11.34.4")
# must not poison the anchor (found live 2026-07-29).
ANCHOR_RAW="$(cd "$V11_ROOT" && git log -60 --no-merges --format='%s' 2>/dev/null \
    | grep -im1 -E 'V11\.[0-9]+(\.[0-9]+)?' \
    | grep -oiE 'V11\.[0-9]+(\.[0-9]+)?' | sort -Vr | head -1)"
ANCHOR="$(printf '%s' "$ANCHOR_RAW" | tr '[:upper:]' '[:lower:]')"
ANCHOR_MINOR="$(norm "$ANCHOR")"

if [ -z "$ANCHOR_MINOR" ]; then
    say "⚠ check-stamp-drift: could not derive an anchor version from git log (no V11.x commit subjects in last 60 commits). Skipping — cannot verify without an anchor."
    [ "$JSON_MODE" -eq 1 ] && printf '{"anchor":null,"findings":[],"skipped":true}\n'
    exit 0
fi

# --- Extract claimed version per surface ---
extract_registry_metadata() {
    local f="$1"
    python3 -c "
import json, sys
try:
    d = json.load(open('$f'))
except Exception:
    sys.exit(0)
v = d.get('metadata', {}).get('version', '')
print(v)
" 2>/dev/null
}

extract_registry_agent_versions() {
    local f="$1"
    python3 -c "
import json, sys
try:
    d = json.load(open('$f'))
except Exception:
    sys.exit(0)
agents = d.get('agents', {})
versions = set()
if isinstance(agents, dict):
    items = agents.values()
elif isinstance(agents, list):
    items = agents
else:
    items = []
for a in items:
    if isinstance(a, dict):
        v = a.get('version')
        if v:
            versions.add(str(v))
for v in sorted(versions):
    print(v)
" 2>/dev/null
}

extract_readme() {
    local f="$1"
    grep -oE '^## Current Version:[[:space:]]*[vV]?11\.[0-9]+(\.[0-9]+)?' "$f" 2>/dev/null | head -1 \
        | grep -oE '11\.[0-9]+(\.[0-9]+)?'
}

extract_version_md() {
    local f="$1"
    grep -m1 -oE '^## +[vV]11\.[0-9]+(\.[0-9]+)?' "$f" 2>/dev/null \
        | grep -oE '11\.[0-9]+(\.[0-9]+)?'
}

extract_claude_md() {
    local f="$1"
    grep -oE '\*\*Current:[[:space:]]*[vV]?11\.[0-9]+(\.[0-9]+)?' "$f" 2>/dev/null | head -1 \
        | grep -oE '11\.[0-9]+(\.[0-9]+)?'
}

# --- Collect findings: each row is "file<TAB>field<TAB>found" ---
ROWS=()

for rel in "${SURFACES[@]}"; do
    f="$V11_ROOT/$rel"
    [ -f "$f" ] || { say "⚠ check-stamp-drift: surface not found, skipping ($rel)"; continue; }

    case "$rel" in
        agents/V11_AGENT_REGISTRY.json)
            meta_v="$(extract_registry_metadata "$f")"
            [ -n "$meta_v" ] && ROWS+=("$rel	metadata.version	$meta_v")
            while IFS= read -r av; do
                [ -n "$av" ] && ROWS+=("$rel	agents[*].version	$av")
            done < <(extract_registry_agent_versions "$f")
            ;;
        README.md)
            v="$(extract_readme "$f")"
            [ -n "$v" ] && ROWS+=("$rel	Current Version	$v")
            ;;
        VERSION.md)
            v="$(extract_version_md "$f")"
            [ -n "$v" ] && ROWS+=("$rel	newest section heading	$v")
            ;;
        CLAUDE.md)
            v="$(extract_claude_md "$f")"
            [ -n "$v" ] && ROWS+=("$rel	§17 Current pointer	$v")
            ;;
    esac
done

# --- Compare each row against the anchor; dedupe identical (file,field,found) drift rows ---
fail=0
declare -A SEEN=()
FINDINGS_JSON="["
first_json=1
TABLE_LINES=()

for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r file field found <<<"$row"
    found_minor="$(norm "$found")"
    status="OK"
    if [ "$found_minor" != "$ANCHOR_MINOR" ]; then
        status="DRIFT"
        fail=1
        key="$file|$field|$found"
        if [ -z "${SEEN[$key]:-}" ]; then
            SEEN[$key]=1
            if [ "$first_json" -eq 1 ]; then
                first_json=0
            else
                FINDINGS_JSON+=","
            fi
            FINDINGS_JSON+="$(python3 -c "
import json
print(json.dumps({'file': '$file', 'field': '$field', 'found': '$found', 'expected': '$ANCHOR_MINOR'}))
")"
        fi
    fi
    TABLE_LINES+=("$(printf '%-45s %-22s %-12s %-12s %s' "$file" "$field" "$found" "$ANCHOR_MINOR" "$status")")
done
FINDINGS_JSON+="]"

# =====================================================================
# Independent phase (W2-T1): per-project version-file consistency via
# sessions/{project}/.stamp-drift-extra.json. NOT merged into the
# git-log anchor comparison above — an extra version file is a
# project-owned app version (e.g. an AHK client build number vs a
# Python server build number in the SAME project) with no relationship
# to the V11.x protocol anchor, so the "extract -> compare-to-anchor"
# shape above does not fit. This runs as its own self-consistency
# check instead: every successfully-extracted entry in one project's
# list must match every other entry in that same list. Per the
# runbook's 2-attempt cap ("if the extra config schema conflicts with
# the existing anchor format... add support as an additional
# independent phase (not merged into existing anchors)") — the
# semantic mismatch is decided up front rather than burning attempts
# on a merge that can't work.
#
# Absent .stamp-drift-extra.json (or absent "version_files" key) for a
# project = no-op for that project — this phase only ever ADDS rows,
# it never touches SURFACES/ROWS/TABLE_LINES/FINDINGS_JSON above, so a
# project (or a whole repo) with zero extra-config files reproduces
# check-stamp-drift's pre-W2-T1 output byte-for-byte.
# =====================================================================
SESSIONS_ROOT="${SESSIONS_ROOT:-$(cd "$V11_ROOT/.." && pwd)/sessions}"

extract_by_pattern() {
    # Extract capture group 1 (or the whole match, if the pattern has
    # no group) of $2 from file $1. argv-passed, never shell-interpolated
    # into the python source — the pattern string is untrusted-ish
    # (project-authored JSON) and must not be able to break out of a
    # quoted literal.
    local f="$1" pat="$2"
    python3 - "$f" "$pat" <<'PYEOF'
import re, sys
f, pat = sys.argv[1], sys.argv[2]
try:
    with open(f) as fh:
        content = fh.read()
except Exception:
    sys.exit(0)
try:
    m = re.search(pat, content)
except re.error:
    sys.exit(0)
if not m:
    sys.exit(0)
print(m.group(1) if m.groups() else m.group(0))
PYEOF
}

json_row() {
    # Same argv-passed contract as extract_by_pattern — avoids hand-built
    # JSON string concatenation around values that may contain quotes.
    python3 - "$@" <<'PYEOF'
import json, sys
project, label, path, version, status = sys.argv[1:6]
print(json.dumps({'project': project, 'label': label, 'path': path, 'version': version, 'status': status}))
PYEOF
}

PROJECT_TABLE_LINES=()
PROJECT_FINDINGS_JSON="["
first_project_json=1
project_fail=0

if [ -d "$SESSIONS_ROOT" ]; then
    for extra_file in "$SESSIONS_ROOT"/*/.stamp-drift-extra.json; do
        [ -f "$extra_file" ] || continue
        project_dir="$(dirname "$extra_file")"
        project="$(basename "$project_dir")"

        ENTRY_LABELS=()
        ENTRY_VERSIONS=()
        while IFS= read -r item; do
            [ -n "$item" ] || continue
            vpath="$(jq -r '.path // empty' <<<"$item")"
            vpattern="$(jq -r '.pattern // empty' <<<"$item")"
            vlabel="$(jq -r '.label // .path // empty' <<<"$item")"
            [ -n "$vpath" ] && [ -n "$vpattern" ] || continue

            # Format-validation gate: reject absolute paths and any ".."
            # traversal component BEFORE the path reaches a file sink.
            case "$vpath" in
                /*|*..*)
                    say "⚠ check-stamp-drift: rejecting unsafe path in $project/.stamp-drift-extra.json: $vpath"
                    continue
                    ;;
            esac

            target="$project_dir/$vpath"
            if [ ! -f "$target" ]; then
                say "⚠ check-stamp-drift: $project/.stamp-drift-extra.json references missing file: $vpath"
                PROJECT_TABLE_LINES+=("$(printf '%-20s %-20s %-30s %-12s %s' "$project" "$vlabel" "$vpath" "MISSING" "WARN")")
                continue
            fi

            found="$(extract_by_pattern "$target" "$vpattern")"
            if [ -z "$found" ]; then
                say "⚠ check-stamp-drift: pattern did not match in $project: $vpath"
                PROJECT_TABLE_LINES+=("$(printf '%-20s %-20s %-30s %-12s %s' "$project" "$vlabel" "$vpath" "NO-MATCH" "WARN")")
                continue
            fi

            ENTRY_LABELS+=("$vlabel|$vpath")
            ENTRY_VERSIONS+=("$found")
        done < <(jq -c '.version_files[]?' "$extra_file" 2>/dev/null)

        n="${#ENTRY_VERSIONS[@]}"
        [ "$n" -eq 0 ] && continue

        status="OK"
        if [ "$n" -ge 2 ]; then
            mismatch=0
            for v in "${ENTRY_VERSIONS[@]}"; do
                [ "$v" != "${ENTRY_VERSIONS[0]}" ] && mismatch=1
            done
            if [ "$mismatch" -eq 1 ]; then
                status="MISMATCH"
                project_fail=1
            fi
        fi

        for i in "${!ENTRY_VERSIONS[@]}"; do
            IFS='|' read -r lbl pth <<<"${ENTRY_LABELS[$i]}"
            row_status="$status"
            [ "$n" -eq 1 ] && row_status="OK (single entry)"
            PROJECT_TABLE_LINES+=("$(printf '%-20s %-20s %-30s %-12s %s' "$project" "$lbl" "$pth" "${ENTRY_VERSIONS[$i]}" "$row_status")")
            if [ "$first_project_json" -eq 1 ]; then
                first_project_json=0
            else
                PROJECT_FINDINGS_JSON+=","
            fi
            PROJECT_FINDINGS_JSON+="$(json_row "$project" "$lbl" "$pth" "${ENTRY_VERSIONS[$i]}" "$row_status")"
        done
    done
fi
PROJECT_FINDINGS_JSON+="]"

anchor_fail="$fail"
fail=$(( fail || project_fail ))

if [ "$JSON_MODE" -eq 1 ]; then
    printf '{"anchor":"%s","findings":%s,"project_extras":%s}\n' "$ANCHOR_MINOR" "$FINDINGS_JSON" "$PROJECT_FINDINGS_JSON"
else
    say "check-stamp-drift: anchor = v${ANCHOR_MINOR} (derived from git log)"
    say ""
    say "$(printf '%-45s %-22s %-12s %-12s %s' "FILE" "FIELD" "FOUND" "EXPECTED" "STATUS")"
    for line in "${TABLE_LINES[@]}"; do
        say "$line"
    done
    if [ "${#PROJECT_TABLE_LINES[@]}" -gt 0 ]; then
        say ""
        say "Per-project version-file consistency (.stamp-drift-extra.json):"
        say "$(printf '%-20s %-20s %-30s %-12s %s' "PROJECT" "LABEL" "PATH" "VERSION" "STATUS")"
        for line in "${PROJECT_TABLE_LINES[@]}"; do
            say "$line"
        done
    fi
    say ""
    if [ "$anchor_fail" -eq 0 ]; then
        say "✓ check-stamp-drift: all surfaces match anchor v${ANCHOR_MINOR}."
    else
        say "❌ STAMP_DRIFT: one or more surfaces disagree with anchor v${ANCHOR_MINOR}."
        say "   This is a report of a symptom the sweep (W2-T7) must fix — this tool does not write files."
    fi
    if [ "$project_fail" -eq 1 ]; then
        say "❌ STAMP_DRIFT (per-project): one or more sessions/{project}/.stamp-drift-extra.json version files disagree with each other."
    fi
fi

exit "$fail"
