#!/bin/bash
# Install the V11 validation-lint commit-msg hook for a git repository.
#
# Usage:
#   ./scripts/install-validation-lint-hook [--repo REPO_PATH] [--method direct|hookspath] [--dry-run]
#
# Methods:
#   direct     (default) — preservation-safe direct install of the commit-msg hook only.
#              Mirrors scripts/install-postcommit-hook's approach (H1a):
#                - No existing commit-msg hook       → symlink directly to the V11 validator.
#                - Existing commit-msg hook is itself a symlink to a tracked source file
#                  (husky/lefthook/example-project pattern)  → replace with a chain-wrapper script
#                  that delegates to BOTH the original tracked hook and the V11 validator.
#                  The tracked source file is verified byte-identical (md5) after install —
#                  it is never modified.
#                - Existing commit-msg hook is a regular file → back it up to
#                  commit-msg.pre-v11 and append a V11 shim call at the end (original
#                  content runs first; if it fails the commit is blocked before the
#                  shim ever runs, same as native git hook chaining).
#              Only the commit-msg hook is touched. Every other hook type in the repo
#              (pre-commit, pre-push, husky, etc.) is left completely alone.
#   hookspath  — sets git config core.hooksPath to the v11 hooks/git-hooks dir.
#              WARNING: this repoints git's ENTIRE hook directory for this repo,
#              silently disabling any pre-existing hook of ANY type that isn't also
#              present in hooks/git-hooks/ (pre-commit, pre-push, husky, etc). Use only
#              when you specifically want v11 to manage the full hook fleet for a repo.
#
# To uninstall:
#   direct method:     rm .git/hooks/commit-msg   (restore commit-msg.pre-v11 if present)
#   hookspath method:  git config --unset core.hooksPath
#
# Rollback env vars (both methods):
#   V11_VALIDATION_LINT=off           — disable entirely
#   V11_VALIDATION_LINT_STRICT=on     — upgrade HYPOTHESIZED failures to block
#   V11_VALIDATION_LINT_HEURISTIC=off — disable causal-language heuristic

set -euo pipefail

V11_HOME="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"
GIT_HOOKS_DIR="$V11_HOME/hooks/git-hooks"
COMMIT_MSG_HOOK="$V11_HOME/hooks/commit-msg-validation"

# Defaults
REPO_PATH="$(pwd)"
METHOD="direct"
DRY_RUN=0

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            REPO_PATH="$2"
            shift 2
            ;;
        --method)
            METHOD="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --help|-h)
            grep '^#' "$0" | sed 's/^# \?//'
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

if [ ! -f "$COMMIT_MSG_HOOK" ]; then
    echo "ERROR: V11 commit-msg validator not found at $COMMIT_MSG_HOOK" >&2
    exit 1
fi

# Validate repo
if ! git -C "$REPO_PATH" rev-parse --git-dir &>/dev/null; then
    echo "ERROR: $REPO_PATH is not a git repository" >&2
    exit 1
fi

GIT_DIR="$(git -C "$REPO_PATH" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -z "$GIT_DIR" ]; then
    # Fallback for older git without --path-format support: resolve
    # --git-common-dir (may be relative) against the repo root.
    _common="$(git -C "$REPO_PATH" rev-parse --git-common-dir)"
    GIT_DIR="$(cd "$REPO_PATH" && realpath "$_common")"
fi

case "$METHOD" in
    hookspath)
        echo "WARNING: --method hookspath sets core.hooksPath, which repoints git's" >&2
        echo "         ENTIRE hook directory for this repo. Any pre-existing hook of" >&2
        echo "         ANY type (pre-commit, pre-push, husky, etc.) not also present" >&2
        echo "         in $GIT_HOOKS_DIR will be silently disabled." >&2
        echo "" >&2

        if [ "$DRY_RUN" -eq 1 ]; then
            echo "DRY-RUN: action=set-core-hookspath target=$GIT_HOOKS_DIR"
        else
            git -C "$REPO_PATH" config core.hooksPath "$GIT_HOOKS_DIR"
            echo "[install-validation-lint-hook] method=hookspath Set core.hooksPath to $GIT_HOOKS_DIR"
            echo "[install-validation-lint-hook] All hooks in $GIT_HOOKS_DIR are now active for $REPO_PATH"
        fi
        echo ""
        echo "To uninstall: git -C '$REPO_PATH' config --unset core.hooksPath"
        ;;

    direct)
        HOOK_TARGET="$GIT_DIR/hooks/commit-msg"

        # ── core.hooksPath detection ─────────────────────────────────────────
        # git never reads $GIT_DIR/hooks when core.hooksPath is set — it reads
        # the configured dir instead (often a TRACKED working-tree path).
        # Symlinking into $GIT_DIR/hooks in that case installs a dead hook
        # silently. Detect the EFFECTIVE hooks dir and skip (don't chain) when
        # it differs. This check does NOT apply to --method hookspath, which
        # explicitly manages core.hooksPath itself.
        EFFECTIVE_HOOKS_DIR="$(git -C "$REPO_PATH" rev-parse --path-format=absolute --git-path hooks 2>/dev/null || true)"
        if [ -z "$EFFECTIVE_HOOKS_DIR" ]; then
            # Fallback for older git without --path-format support: resolve
            # --git-path hooks (may be relative) against the repo root.
            _hookspath="$(git -C "$REPO_PATH" rev-parse --git-path hooks)"
            EFFECTIVE_HOOKS_DIR="$(cd "$REPO_PATH" && realpath "$_hookspath")"
        fi

        if [ "$EFFECTIVE_HOOKS_DIR" != "$GIT_DIR/hooks" ]; then
            if [ "$DRY_RUN" -eq 1 ]; then
                echo "DRY-RUN: action=skip reason=core-hooksPath-set effective_hooks_dir=$EFFECTIVE_HOOKS_DIR"
            else
                echo "[install-validation-lint-hook] action=skip reason=core-hooksPath-set effective_hooks_dir=$EFFECTIVE_HOOKS_DIR" >&2
            fi
            echo "" >&2
            echo "core.hooksPath is set for this repo, so git never reads $GIT_DIR/hooks —" >&2
            echo "a symlink there would be dead. $EFFECTIVE_HOOKS_DIR is usually a TRACKED" >&2
            echo "working-tree path, so we skip rather than silently pollute the repo." >&2
            echo "To wire manually: ln -sf $COMMIT_MSG_HOOK $EFFECTIVE_HOOKS_DIR/commit-msg" >&2
            exit 0
        fi

        if [ "$DRY_RUN" -eq 0 ]; then
            mkdir -p "$GIT_DIR/hooks"
        fi

        # ── Idempotency check: already a direct symlink to the V11 validator ──
        if [ -L "$HOOK_TARGET" ]; then
            _current_target="$(readlink -f "$HOOK_TARGET" 2>/dev/null || true)"
            if [ "$_current_target" = "$(realpath "$COMMIT_MSG_HOOK")" ]; then
                echo "[install-validation-lint-hook] Already installed (symlink) at $HOOK_TARGET — no changes made." >&2
                if [ "$DRY_RUN" -eq 1 ]; then
                    echo "DRY-RUN: action=no-op reason=already-installed-symlink target=$HOOK_TARGET"
                fi
                exit 0
            fi
        fi

        # ── Idempotency check: file already contains a V11 marker ─────────────
        if [ -f "$HOOK_TARGET" ] && grep -q "commit-msg-validation\|V11_VALIDATION_LINT\|v11-chain-wrapper-v1" "$HOOK_TARGET" 2>/dev/null; then
            echo "[install-validation-lint-hook] V11 hook shim/wrapper already present in $HOOK_TARGET — no changes made." >&2
            if [ "$DRY_RUN" -eq 1 ]; then
                echo "DRY-RUN: action=no-op reason=marker-already-present target=$HOOK_TARGET"
            fi
            exit 0
        fi

        if [ ! -e "$HOOK_TARGET" ]; then
            # ── Case 1: No existing hook — install as symlink ──────────────────
            if [ "$DRY_RUN" -eq 1 ]; then
                echo "DRY-RUN: action=install-symlink target=$HOOK_TARGET link_to=$COMMIT_MSG_HOOK"
            else
                ln -sf "$COMMIT_MSG_HOOK" "$HOOK_TARGET"
                chmod +x "$HOOK_TARGET"
                echo "[install-validation-lint-hook] method=install-symlink Installed symlink: $HOOK_TARGET → $COMMIT_MSG_HOOK" >&2
            fi

        elif [ -L "$HOOK_TARGET" ]; then
            # ── Case 2: Symlink pointing to some OTHER file (tracked source) ──
            #
            # Resolve through all symlink layers to the final real file.
            _resolved="$(readlink -f "$HOOK_TARGET" 2>/dev/null || true)"
            if [ -z "$_resolved" ] || [ ! -f "$_resolved" ]; then
                echo "ERROR: $HOOK_TARGET is a symlink but resolves to a missing or non-regular file: $_resolved" >&2
                exit 1
            fi

            # Capture MD5 of the tracked source BEFORE we touch anything.
            _md5_before="$(md5sum "$_resolved" 2>/dev/null | awk '{print $1}' || true)"

            if [ "$DRY_RUN" -eq 1 ]; then
                echo "DRY-RUN: action=symlink-replaced-with-wrapper target=$HOOK_TARGET resolved_source=$_resolved"
                echo "DRY-RUN: wrapper will delegate to: $_resolved AND $COMMIT_MSG_HOOK"
                echo "DRY-RUN: tracked source $( [ -n "$_md5_before" ] && echo "md5=$_md5_before" || echo "(no md5)" ) will NOT be modified"
            else
                # Remove the symlink and write a real wrapper script in its place.
                rm "$HOOK_TARGET"
                cat > "$HOOK_TARGET" <<WRAPPER
#!/usr/bin/env bash
# v11-chain-wrapper-v1
# Auto-generated by install-validation-lint-hook — DO NOT EDIT MANUALLY.
# Delegates to:
#   1. Original tracked hook: $_resolved
#   2. V11 commit-msg-validation: $COMMIT_MSG_HOOK
#
# To reinstall cleanly: rm this file and re-run install-validation-lint-hook.
# Rollback: V11_VALIDATION_LINT=off

set -uo pipefail

# Delegate 1: original tracked hook — nonzero exit blocks the commit, same as
# native git commit-msg semantics, so we stop here without running delegate 2.
bash "$_resolved" "\$@"
_d1_exit=\$?
if [ \$_d1_exit -ne 0 ]; then
    exit \$_d1_exit
fi

# Delegate 2: V11 commit-msg-validation
if [ "\${V11_VALIDATION_LINT:-on}" = "off" ]; then
    exit 0
fi
if [ -x "${COMMIT_MSG_HOOK}" ]; then
    "${COMMIT_MSG_HOOK}" "\$@"
    exit \$?
elif [ -n "\${V11_HOME:-}" ] && [ -x "\${V11_HOME}/hooks/commit-msg-validation" ]; then
    "\${V11_HOME}/hooks/commit-msg-validation" "\$@"
    exit \$?
fi

exit 0
WRAPPER
                chmod +x "$HOOK_TARGET"

                # Verify the tracked source file is UNMODIFIED.
                _md5_after="$(md5sum "$_resolved" 2>/dev/null | awk '{print $1}' || true)"
                if [ -n "$_md5_before" ] && [ "$_md5_before" != "$_md5_after" ]; then
                    echo "ERROR: tracked source file was modified during install (md5 changed)!" >&2
                    echo "       Before: $_md5_before  After: $_md5_after" >&2
                    echo "       File: $_resolved" >&2
                    exit 1
                fi

                echo "[install-validation-lint-hook] method=symlink-replaced-with-wrapper target=$HOOK_TARGET" >&2
                echo "[install-validation-lint-hook] Tracked source preserved (md5=$_md5_before): $_resolved" >&2
            fi

        else
            # ── Case 3: Regular file — back up and append shim ─────────────────
            _BACKUP="${HOOK_TARGET}.pre-v11"

            if [ "$DRY_RUN" -eq 1 ]; then
                echo "DRY-RUN: action=append-shim target=$HOOK_TARGET backup=$_BACKUP"
                echo "DRY-RUN: existing content will be preserved, V11 shim appended at end"
            else
                if [ ! -f "$_BACKUP" ]; then
                    cp "$HOOK_TARGET" "$_BACKUP"
                    echo "[install-validation-lint-hook] Backed up existing hook to $_BACKUP" >&2
                fi

                # Append shim call (won't fire if hook already contains V11 marker — guarded above).
                # If the existing hook's own logic fails/exits before reaching the end, this
                # shim never runs — matching native git hook chaining semantics.
                cat >> "$HOOK_TARGET" <<'SHIM'

# --- V11 commit-msg-validation shim (appended by install-validation-lint-hook) ---
# Validates the "Validation:" tag on this commit. Rollback: V11_VALIDATION_LINT=off
if [ "${V11_VALIDATION_LINT:-on}" = "off" ]; then
    exit 0
fi
if [ -n "${V11_HOME:-}" ] && [ -x "${V11_HOME}/hooks/commit-msg-validation" ]; then
    "${V11_HOME}/hooks/commit-msg-validation" "$@"
    exit $?
elif [ -x "$HOME/v11/hooks/commit-msg-validation" ]; then
    $HOME/v11/hooks/commit-msg-validation "$@"
    exit $?
fi
SHIM

                chmod +x "$HOOK_TARGET"
                echo "[install-validation-lint-hook] method=appended-shim Appended V11 shim to existing hook at $HOOK_TARGET" >&2
            fi
        fi
        ;;

    *)
        echo "ERROR: unknown method '$METHOD'. Use direct or hookspath." >&2
        exit 1
        ;;
esac

if [ "$DRY_RUN" -eq 0 ]; then
    # Verify the validator is accessible
    if ! bash "$COMMIT_MSG_HOOK" --test &>/dev/null; then
        echo "WARNING: validator self-test failed. Check that python3 is available." >&2
    fi

    echo ""
    echo "Rollback env vars:"
    echo "  V11_VALIDATION_LINT=off           — disable entirely"
    echo "  V11_VALIDATION_LINT_STRICT=on     — upgrade HYPOTHESIZED failures to block"
    echo "  V11_VALIDATION_LINT_HEURISTIC=off — disable causal-language heuristic"
fi
