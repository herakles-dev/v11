#!/usr/bin/env python3
"""
ledger-shadow-report — Gate-1 instrument for the V11.16 shadow reconciliation.

Reads $METRICS_DIR/ledger-shadow-divergence.jsonl and summarises divergence
by project and field.  Gate-1 (task T7) asserts ZERO divergence on the live
cross-session dogfood by running this script and checking the exit code:

    scripts/ledger-shadow-report --since 2h
    # exits 0 if no divergence in the window, 1 if divergence found

Usage:
    scripts/ledger-shadow-report [--project PROJECT] [--since DURATION] [--json]

Options:
    --project PROJECT   Limit to a specific project name.
    --since DURATION    Only consider records newer than DURATION ago.
                        Accepts: Ns (seconds), Nm (minutes), Nh (hours), Nd (days).
                        Example: --since 24h, --since 30m, --since 90s.
    --json              Emit the summary as a single JSON object on stdout instead
                        of the human-readable table.  Useful for CI assertions.
    --help              Show this message and exit.

Exit codes:
    0  No divergence found in the requested window/project.
    1  Divergence found (or parse/IO error — details on stderr).
"""

import argparse
import datetime
import json
import os
import sys
from collections import defaultdict
from pathlib import Path

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

METRICS_DIR = os.environ.get(
    "METRICS_DIR",
    os.path.join(os.environ.get("HERCULES_ROOT", os.path.expanduser("~")), ".agent-metrics"),
)
DIVERGENCE_FILE = os.path.join(METRICS_DIR, "ledger-shadow-divergence.jsonl")


# ---------------------------------------------------------------------------
# Duration parsing
# ---------------------------------------------------------------------------

_DUR_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def parse_duration(s: str) -> datetime.timedelta:
    """Parse a duration string like '2h', '30m', '90s', '7d'."""
    s = s.strip()
    if not s:
        raise ValueError("empty duration string")
    unit = s[-1].lower()
    if unit not in _DUR_UNITS:
        raise ValueError(f"unknown duration unit {unit!r} (use s/m/h/d)")
    try:
        value = float(s[:-1])
    except ValueError:
        raise ValueError(f"invalid duration number in {s!r}")
    return datetime.timedelta(seconds=value * _DUR_UNITS[unit])


# ---------------------------------------------------------------------------
# Core logic
# ---------------------------------------------------------------------------

def load_divergences(path: str, project_filter: str | None, since_dt: datetime.datetime | None) -> list[dict]:
    """
    Parse the JSONL divergence log and return records matching the filters.
    Silently skips malformed lines (same defensive pattern as replay parser).
    """
    p = Path(path)
    if not p.exists():
        return []

    records = []
    try:
        text = p.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        print(f"ledger-shadow-report: cannot read {path}: {exc}", file=sys.stderr)
        return []

    for lineno, raw in enumerate(text.splitlines(), 1):
        raw = raw.strip()
        if not raw:
            continue
        try:
            rec = json.loads(raw)
        except json.JSONDecodeError:
            print(f"ledger-shadow-report: malformed line {lineno} — skipped", file=sys.stderr)
            continue
        if not isinstance(rec, dict):
            continue

        # Project filter
        if project_filter and rec.get("project") != project_filter:
            continue

        # Since filter
        if since_dt is not None:
            ts_str = rec.get("ts", "")
            if not ts_str:
                continue
            try:
                # Python < 3.11: fromisoformat does not handle +HH:MM reliably on all
                # platforms, but datetime.datetime.fromisoformat works for the ISO-8601
                # strings we produce (date -Iseconds → "2026-05-17T12:34:56+00:00").
                rec_dt = datetime.datetime.fromisoformat(ts_str)
                # Ensure tz-aware for comparison
                if rec_dt.tzinfo is None:
                    rec_dt = rec_dt.replace(tzinfo=datetime.timezone.utc)
            except ValueError:
                # Unparseable timestamp — include the record (conservative)
                rec_dt = since_dt  # passes the >= check
            if rec_dt < since_dt:
                continue

        records.append(rec)

    return records


def summarise(records: list[dict]) -> dict:
    """
    Build a summary dict:
    {
      "total_divergences": N,
      "projects": {
        "<project>": {
          "count": N,
          "fields": {
            "<field>": N   // how many times this field diverged
          },
          "first_at": "<ts>",
          "last_at":  "<ts>"
        }
      }
    }
    """
    by_project: dict[str, dict] = defaultdict(lambda: {
        "count": 0,
        "fields": defaultdict(int),
        "first_at": None,
        "last_at": None,
    })

    for rec in records:
        proj  = rec.get("project", "<unknown>")
        field = rec.get("field", "<unknown>")
        ts    = rec.get("ts", "")

        entry = by_project[proj]
        entry["count"] += 1
        entry["fields"][field] += 1  # type: ignore[index]

        if ts:
            if entry["first_at"] is None or ts < entry["first_at"]:
                entry["first_at"] = ts
            if entry["last_at"] is None or ts > entry["last_at"]:
                entry["last_at"] = ts

    # Convert defaultdicts to plain dicts for JSON serialisation
    result_projects = {}
    for proj, entry in by_project.items():
        result_projects[proj] = {
            "count":    entry["count"],
            "fields":   dict(entry["fields"]),
            "first_at": entry["first_at"],
            "last_at":  entry["last_at"],
        }

    return {
        "total_divergences": len(records),
        "projects":          result_projects,
    }


def print_human(summary: dict, project_filter: str | None, since_label: str) -> None:
    """Print a human-readable summary table."""
    total = summary["total_divergences"]
    projects = summary["projects"]

    header_parts = ["Shadow Divergence Report"]
    if project_filter:
        header_parts.append(f"project={project_filter}")
    if since_label:
        header_parts.append(f"since={since_label}")
    print(" | ".join(header_parts))
    print("-" * 60)

    if total == 0:
        print("No divergences found. Gate-1: PASS")
        return

    print(f"Total divergences: {total}")
    print()
    for proj, entry in sorted(projects.items()):
        print(f"  Project: {proj}  ({entry['count']} divergences)")
        print(f"    First:  {entry['first_at']}")
        print(f"    Last:   {entry['last_at']}")
        print(f"    Fields:")
        for field, count in sorted(entry["fields"].items(), key=lambda x: -x[1]):
            print(f"      {field}: {count}")
        print()

    print("Gate-1: FAIL — divergences present (investigate before cutover)")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(
        prog="ledger-shadow-report",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=True,
    )
    parser.add_argument("--project", default=None, help="Filter to a specific project.")
    parser.add_argument("--since",   default=None, help="Duration window (e.g. 24h, 30m).")
    parser.add_argument("--json",    action="store_true", help="Emit JSON summary.")
    args = parser.parse_args()

    since_dt: datetime.datetime | None = None
    since_label = ""
    if args.since:
        try:
            delta = parse_duration(args.since)
            # Use timezone-aware UTC now for tz-aware comparison
            since_dt = datetime.datetime.now(tz=datetime.timezone.utc) - delta
            since_label = args.since
        except ValueError as exc:
            # E3 fix: unparseable --since MUST NOT cause a false gate FAIL (exit 1
            # without reading divergences would block the gate even when there are
            # zero divergences to report).  Safe direction: log the warning and
            # proceed without the time filter rather than failing the gate.
            print(f"ledger-shadow-report: WARNING — ignoring invalid --since value ({exc!r}); proceeding without time filter", file=sys.stderr)
            since_dt = None
            since_label = ""

    records = load_divergences(DIVERGENCE_FILE, args.project, since_dt)
    summary = summarise(records)

    if args.json:
        print(json.dumps(summary, separators=(",", ":")))
    else:
        print_human(summary, args.project, since_label)

    # Exit 0 = no divergence (gate-1 PASS); exit 1 = divergences found (gate-1 FAIL)
    return 1 if summary["total_divergences"] > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
