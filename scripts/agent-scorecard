#!/bin/bash
# V11.20 Script: agent-scorecard
# Per-agent deep-dive across ALL FOUR audit layers (runtime / lite / wave / swarm)
# with orchestrator-vs-subagent split. Companion to agent-effectiveness (fleet
# view). Reads the same ledgers — no schema invention.
#
# Sources:
#   ~/.agent-metrics/autonomy-audit.jsonl   Layer 1 — runtime Write/Edit/Bash
#   ~/.agent-metrics/agent-errors.jsonl     Layers 2/3/4 — lite/wave/swarm errors
#   ~/.agent-metrics/dispatch-trace.jsonl   W3-T13 — completion-event tokens (avg/spawn)
#   ~/.agent-metrics/ledger/<project>.jsonl S1-D7 — artifacts.tokens on async task closes
#
# Usage:
#   agent-scorecard AGENT                          # all layers, all callers, all time
#   agent-scorecard AGENT --json                   # machine-readable
#   agent-scorecard AGENT --since 2026-01-01       # ISO date lower bound
#   agent-scorecard AGENT --project P              # restrict to project P
#   agent-scorecard AGENT --layer wave             # one layer only
#   agent-scorecard AGENT --caller-kind subagent   # orchestrator | subagent | unknown | daemon | all
#   agent-scorecard --routing                      # V11.32: per-agent override rate report (no AGENT needed)
#   agent-scorecard --routing --project P --since D --json
#   agent-scorecard --routing --live-window 2      # liveness window in hours (default 2)
#   agent-scorecard --test                         # self-test
#   agent-scorecard --help
#
# ADVISORY ONLY (V11.20 inherits V11.15 constraint): does NOT feed DAAO routing.
#
# Exit codes:
#   0    Success (including no-data case — empty scorecard rendered)
#   2    Bad arguments

set -euo pipefail

HERCULES_ROOT="${HERCULES_ROOT:-$HOME}"
METRICS_DIR="${METRICS_DIR:-$HERCULES_ROOT/.agent-metrics}"
# v11.44: own dir, so the Python heredoc can import scripts/lib/actor_canonical.py
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")" && pwd)"

if [ "${1:-}" == "--test" ]; then
    echo "agent-scorecard v1.0 (V11.20)"
    exit 0
fi

if [ "${1:-}" == "--help" ] || [ "${1:-}" == "-h" ]; then
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

AGENT="" JSON=false SINCE="" PROJECT="" LAYER="all" CALLER_KIND="all" ROUTING=false LIVE_WINDOW=2
while [ $# -gt 0 ]; do
    case "$1" in
        --json) JSON=true ;;
        --since) SINCE="${2:-}"; shift ;;
        --project) PROJECT="${2:-}"; shift ;;
        --layer) LAYER="${2:-all}"; shift ;;
        --caller-kind) CALLER_KIND="${2:-all}"; shift ;;
        --routing) ROUTING=true ;;
        --live-window) LIVE_WINDOW="${2:-}"; shift ;;
        --help|-h) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --*) echo "agent-scorecard: unknown flag '$1'" >&2; exit 2 ;;
        *)
            if [ -z "$AGENT" ]; then AGENT="$1"
            else echo "agent-scorecard: unexpected arg '$1'" >&2; exit 2
            fi ;;
    esac
    shift
done

# --routing is a standalone fleet-wide report and does not need an AGENT.
if [ -z "$AGENT" ] && [ "$ROUTING" != "true" ]; then
    echo "agent-scorecard: AGENT name required (try: agent-scorecard --help)" >&2
    exit 2
fi

case "$LAYER" in
    all|runtime|lite|wave|swarm|brief) ;;
    *) echo "agent-scorecard: --layer must be all|runtime|lite|wave|swarm|brief (got: $LAYER)" >&2; exit 2 ;;
esac

if ! printf '%s' "$LIVE_WINDOW" | grep -qE '^[0-9]+([.][0-9]+)?$'; then
    echo "agent-scorecard: --live-window must be a number of hours (got: $LIVE_WINDOW)" >&2; exit 2
fi

case "$CALLER_KIND" in
    all|orchestrator|subagent|unknown|daemon) ;;
    *) echo "agent-scorecard: --caller-kind must be all|orchestrator|subagent|unknown|daemon (got: $CALLER_KIND)" >&2; exit 2 ;;
esac

V11_AS_AGENT="$AGENT" V11_AS_JSON="$JSON" V11_AS_SINCE="$SINCE" \
V11_AS_PROJECT="$PROJECT" V11_AS_LAYER="$LAYER" V11_AS_CALLER_KIND="$CALLER_KIND" \
V11_AS_ROUTING="$ROUTING" V11_AS_LIVE_WINDOW_H="$LIVE_WINDOW" \
V11_AS_TRANSCRIPTS_DIR="${V11_AS_TRANSCRIPTS_DIR:-$HERCULES_ROOT/.claude/projects}" \
V11_AS_AUDIT="$METRICS_DIR/autonomy-audit.jsonl" \
V11_AS_ERRORS="$METRICS_DIR/agent-errors.jsonl" \
V11_AS_TASK_STATE_DIR="$METRICS_DIR/task-state" \
V11_AS_TRACE="$METRICS_DIR/dispatch-trace.jsonl" \
V11_AS_LEDGER_DIR="$METRICS_DIR/ledger" \
V11_AS_LIBDIR="$SCRIPT_DIR/lib" \
python3 - <<'PYEOF'
import os, sys, json, datetime, re, bisect
from collections import Counter

# v11.44: shared read-side actor canonicalization. Single source of truth is
# hooks/lib/actor-canonical.json — the SAME table the bash v11_canonical_actor reads.
# Folds the orchestrator family -> "orchestrator"; non-family names pass through.
# V11_ORCH_QUALITY=off makes _canon the identity (legacy literal-string match).
sys.path.insert(0, os.environ.get("V11_AS_LIBDIR", ""))
try:
    from actor_canonical import canonical_actor as _canon
except Exception:
    def _canon(x):
        return x
# S1-P3: the shared waived/void correction predicate (scripts/lib/review_corrections.py).
from review_corrections import superseded_review_keys, is_counted_review

def env(k, d=""):
    return os.environ.get(k, d)

agent       = _canon(env("V11_AS_AGENT"))  # v11.44: fold target so e.g. team-orchestrator == orchestrator
as_json     = env("V11_AS_JSON") == "true"
since_raw   = env("V11_AS_SINCE") or None
only_proj   = env("V11_AS_PROJECT") or None
only_layer  = env("V11_AS_LAYER")
only_caller = env("V11_AS_CALLER_KIND")
audit_path  = env("V11_AS_AUDIT")
errors_path = env("V11_AS_ERRORS")
task_state_dir = env("V11_AS_TASK_STATE_DIR")
trace_path  = env("V11_AS_TRACE")   # W3-T13

LAYERS = ["runtime", "lite", "wave", "swarm", "brief"]  # v11.44: +brief (orchestrator briefing findings)
SEV_ORDER = ["CRITICAL", "HIGH", "MEDIUM", "LOW"]

def parse_ts(s):
    try:
        dt = datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return dt

now = datetime.datetime.now(datetime.timezone.utc)

since_dt = None
if since_raw:
    since_dt = parse_ts(since_raw) or parse_ts(since_raw + "T00:00:00")
    if since_dt is None:
        print(f"agent-scorecard: bad --since '{since_raw}' (use ISO date)", file=sys.stderr)
        sys.exit(2)

def in_window(rec, ts_key="timestamp"):
    if since_dt is None:
        return True
    ts = parse_ts(rec.get(ts_key))
    return True if ts is None else ts >= since_dt

def read_jsonl(path):
    if not path or not os.path.exists(path):
        return []
    out = []
    with open(path, "r", encoding="utf-8") as fh:
        for ln in fh:
            ln = ln.strip()
            if not ln:
                continue
            try:
                out.append(json.loads(ln))
            except Exception:
                continue
    return out

# ---------------------------------------------------------------------------
# S1-T11 (#53, #99) — durable-ledger identity index, shared by --routing and
# the per-agent ledger blocks below. A task is identified by
# (subject_norm, create_seq), never by a bare task_id: ids are reused across
# sessions (#97). Each identity keeps its created.metadata.agent (the
# TaskCreate-time recommendation), its source, its last in_progress owner, its
# start (first in_progress, reset on a reopen) and end (completed/cancelled) ts,
# its status timeline (pending/active/closed, for "what was it at ts"),
# and whether it is a review task: metadata.review_of, a pair_ id, or a task
# recommended to one of V11's reviewer roles (hand-made "…-review" siblings).
# Each ledger file is parsed once.
#
# S1-T11d (#66): rotated copies are read too — ledger/<project>.jsonl.bak* and
# ledger/archive/*.jsonl (bucketed by each row's own `project`, since archive
# names do not always start with the project). A rotated row joins only when
# no live row has its event identity (ev, UTC ts, session, task_id,
# subject_norm, create_seq); a rewritten copy of one event never counts twice.
# Rotated-only rows are older, so they go first, in ts order.
# V11_AS_ROTATED=off reads the live file alone.
# Per session the index also keeps `sess_act`: the ts of its non-bookkeeping
# events (not cancelled/reconcile/sprint_archived, not migration or
# correction-* rows), which is what --routing liveness reads.
# ---------------------------------------------------------------------------
ledger_dir = env("V11_AS_LEDGER_DIR")

def _is_reconstructed(src):
    """migration / backfill-* rows were written after the fact and carry
    end-state metadata (#99 item 2), so they are not a live record."""
    src = str(src or "")
    return src == "migration" or src.startswith("backfill-")

def _rec_agents(raw):
    """Canonical agents named by a metadata.agent label, first one first. Labels
    may name several agents or carry a model tag: 'a+b', 'a (opus)',
    'a(sonnet)', 'a/haiku', 'a x3'."""
    out = []
    for part in str(raw or "").split("+"):
        name = re.sub(r"\(.*?\)|/\S*", " ", part).split()
        if name and _canon(name[0]) not in out:
            out.append(_canon(name[0]))
    return out

_REVIEWER_AGENTS = {"adversarial-lite-reviewer", "adversarial-reviewer"}

_ledger_cache = {}
_ledger_archive = None  # project -> rows from ledger/archive/*.jsonl

def _event_key(e):
    return (e.get("ev"), parse_ts(e.get("ts")), e.get("session_uuid"), str(e.get("task_id")),
            e.get("subject_norm"), e.get("create_seq"))

def _rotated_rows(project, path):
    global _ledger_archive
    if env("V11_AS_ROTATED") == "off":
        return []
    if _ledger_archive is None:
        _ledger_archive = {}
        adir = os.path.join(os.path.dirname(path), "archive")
        if os.path.isdir(adir):
            for name in sorted(os.listdir(adir)):
                if name.endswith(".jsonl"):
                    for r in read_jsonl(os.path.join(adir, name)):
                        _ledger_archive.setdefault(r.get("project"), []).append(r)
    out = list(_ledger_archive.get(project, []))
    d, bak = os.path.dirname(path), os.path.basename(path) + ".bak"
    for name in sorted(os.listdir(d)):
        if name == bak or name.startswith(bak + "."):
            out += [r for r in read_jsonl(os.path.join(d, name)) if r.get("project") in (project, None)]
    return out

def _is_bookkeeping(e):
    # backfill-* rows keep their real event times (only their metadata is
    # end-state), so they still show a session was active; migration rows are
    # stamped at import time and corrections by the session applying them.
    src = str(e.get("source") or "")
    return (e.get("ev") in ("cancelled", "reconcile", "sprint_archived")
            or src == "migration" or src.startswith("correction-"))

def _ledger_index(project, path=None):
    """Identity index for one project's ledger, or None when it has none."""
    if project in _ledger_cache:
        return _ledger_cache[project]
    if path is None and ledger_dir and project and re.match(r'^[A-Za-z0-9._-]+$', project):
        path = os.path.join(ledger_dir, f"{project}.jsonl")
    if not path or not os.path.isfile(path):
        _ledger_cache[project] = None
        return None
    live = read_jsonl(path)
    seen = {_event_key(e) for e in live}
    rotated = []
    for e in _rotated_rows(project, path):
        k = _event_key(e)
        if k not in seen:
            seen.add(k)
            rotated.append(e)
    _floor = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
    rotated.sort(key=lambda e: parse_ts(e.get("ts")) or _floor)
    rows = rotated + live
    ids, by_tid, by_sess, sess_ts, sess_act = {}, {}, {}, {}, {}
    for e in rows:
        ts = parse_ts(e.get("ts"))
        sid = e.get("session_uuid") or ""
        if ts is not None:
            sess_ts.setdefault(sid, []).append(ts)
            if not _is_bookkeeping(e):
                sess_act.setdefault(sid, []).append(ts)
        key = (e.get("subject_norm"), e.get("create_seq"))
        ev = e.get("ev")
        if ev == "created":
            md = e.get("metadata") if isinstance(e.get("metadata"), dict) else {}
            tid = str(e.get("task_id") or "")
            ident = {"key": key, "created": ts, "session": sid, "task_id": tid,
                     "rec": md.get("agent") or e.get("recommended_agent") or None,
                     "source": e.get("source") or "", "owner": None,
                     "started": None, "end": None, "timeline": [(ts, "pending")],
                     "is_review": (bool(md.get("review_of")) or tid.startswith("pair_")
                                   or bool(_REVIEWER_AGENTS.intersection(_rec_agents(
                                       md.get("agent") or e.get("recommended_agent")))))}
            ids[key] = ident
            if tid and ts is not None:
                by_tid.setdefault(tid, []).append(ident)
                by_sess.setdefault(sid, []).append(ident)
        elif key in ids:
            if ev == "in_progress":
                if ids[key]["started"] is None or ids[key]["end"] is not None:
                    ids[key]["started"] = ts  # first start, or a reopen
                ids[key]["end"] = None
                ids[key]["timeline"].append((ts, "active"))
                if e.get("owner") and isinstance(e.get("owner"), str):
                    ids[key]["owner"] = e.get("owner")
            elif ev in ("completed", "cancelled") and ts is not None:
                ids[key]["end"] = ts
                ids[key]["timeline"].append((ts, "closed"))
    for v in list(sess_ts.values()) + list(sess_act.values()):
        v.sort()
    for i in ids.values():  # status history, so --routing can ask "what was it at ts"
        i["timeline"] = sorted((x for x in i["timeline"] if x[0] is not None), key=lambda x: x[0])
    idx = {"rows": rows, "ids": ids, "by_tid": by_tid, "by_sess": by_sess, "sess_ts": sess_ts,
           "sess_act": sess_act, "rotated_rows": len(rotated)}
    _ledger_cache[project] = idx
    return idx

# ---------------------------------------------------------------------------
# V11.32 (H2) — --routing: dispatch-trace routing-field consumer.
#
# dispatch-trace.jsonl has carried recommended_agent/spawned_agent/
# override_reason since W1-2 but nothing ever read them back (write-only
# fields). This is the missing consumer: a fleet-wide override-rate report,
# independent of the AGENT positional (dispatch decisions aren't scoped to
# one agent — they're scoped to the recommendation). Reuses the exact
# iteration idiom the token-capture blocks below use against this same file:
# read_jsonl(trace_path) + only_proj filter + in_window(rec, ts_key="ts").
# Null-safe field access (`rec.get(...)` — the jq `// empty` idiom's python
# equivalent) even though every row currently carries both fields, so a
# future dispatch-trace-append change that omits one doesn't crash this.
#
# S1-T11: this raw recommended != spawned count reported 81.5% where the
# real rate is far lower (#53). It is kept only behind the rollback lever
# V11_AS_ROUTING_RAW=true; the default report is the classified one below.
# ---------------------------------------------------------------------------
routing_mode = env("V11_AS_ROUTING") == "true"

if routing_mode and env("V11_AS_ROUTING_RAW") == "true":
    per_agent = {}  # recommended_agent -> {"total", "diverged", "reasons": Counter}
    total_all = 0
    diverged_all = 0
    for rec in read_jsonl(trace_path):
        if rec.get("event") == "completion":
            continue  # completion lines are a supplementary record of an
                       # existing dispatch (same recommended_agent/spawned_agent),
                       # not a new spawn — counting both would double-count.
        ra = rec.get("recommended_agent") or None
        sa = rec.get("spawned_agent") or None
        if not ra or not sa:
            continue
        ra = _canon(ra); sa = _canon(sa)  # v11.44: fold orchestrator family into one routing bucket
        if only_proj and rec.get("project") != only_proj:
            continue
        if not in_window(rec, ts_key="ts"):
            continue
        bucket = per_agent.setdefault(ra, {"total": 0, "diverged": 0, "reasons": Counter()})
        bucket["total"] += 1
        total_all += 1
        if sa != ra:
            bucket["diverged"] += 1
            diverged_all += 1
            reason = rec.get("override_reason") or ""
            if reason:
                bucket["reasons"][reason] += 1

    routing_rows = []
    for ra, b in per_agent.items():
        rate = (b["diverged"] / b["total"] * 100.0) if b["total"] > 0 else 0.0
        top3 = b["reasons"].most_common(3)
        routing_rows.append({
            "recommended_agent": ra,
            "total_spawns": b["total"],
            "diverged": b["diverged"],
            "rate_pct": round(rate, 1),
            "top_override_reasons": [{"reason": r, "count": c} for r, c in top3],
        })
    routing_rows.sort(key=lambda r: (-r["diverged"], -r["total_spawns"], r["recommended_agent"]))

    overall_rate = (diverged_all / total_all * 100.0) if total_all > 0 else 0.0

    if as_json:
        print(json.dumps({
            "generated_at": now.isoformat(),
            "filters": {"since": since_raw, "project": only_proj},
            "advisory_only": True,
            "source": trace_path,
            "agents": routing_rows,
            "overall": {
                "total_spawns": total_all,
                "diverged": diverged_all,
                "rate_pct": round(overall_rate, 1),
            },
        }, indent=2))
        sys.exit(0)

    print("V11.32 Agent Scorecard — Routing Override Report   (ADVISORY ONLY — does not drive DAAO)")
    filt = []
    if since_raw: filt.append(f"since={since_raw}")
    if only_proj: filt.append(f"project={only_proj}")
    if filt:
        print("  filters: " + "  ".join(filt))
    print("=" * 96)
    print(f"  {'RECOMMENDED':<28}  {'SPAWNS':>7}  {'DIVERGED':>8}  {'RATE':>7}  TOP OVERRIDE REASONS")
    print("  " + "-" * 92)
    for r in routing_rows:
        top_s = "; ".join(f"{x['reason']} ({x['count']})" for x in r["top_override_reasons"]) if r["top_override_reasons"] else "—"
        print(f"  {r['recommended_agent']:<28}  {r['total_spawns']:>7}  {r['diverged']:>8}  {r['rate_pct']:>6.1f}%  {top_s}")
    print("  " + "-" * 92)
    print(f"  {'OVERALL':<28}  {total_all:>7}  {diverged_all:>8}  {overall_rate:>6.1f}%   ({diverged_all}/{total_all} diverged)")
    print()
    if total_all == 0:
        print("  No dispatch-trace data found under the current filters.")
        print(f"  Ledger: {trace_path}  ({'present' if os.path.exists(trace_path) else 'absent'})")
    sys.exit(0)

# ---------------------------------------------------------------------------
# S1-T11 (#53, #99) — --routing judged against an INDEPENDENT recommendation.
#
# A dispatch-trace row's own routing fields are not evidence of a routing
# choice: hooks/track-agents fills recommended_agent with the spawned agent
# when the task has none (forced agreement), reads it from
# active_task_ids[0] (possibly another in-flight task), and synthesises
# override_reason as "recommended=X, spawned=Y"; hooks/sync-tasks writes
# spawned_agent="orchestrator" + "unattributed-self-exec" as an attribution
# record. So each spawn is re-judged against the durable ledger.
#
#   spawns (S1-T11d, #66) one per Agent call. Since 2026-07-10 hooks/track-agents
#                   writes each call as a single event:"completion" row; rows
#                   without `event` (or with a hand-set one) come from the
#                   orchestrator's dispatch-trace-append and name the task
#                   spawned for (plus sync-tasks self-exec records). A
#                   completion row whose call started 30 min before .. 5 min
#                   after an orchestrator row for the same project and agent is
#                   that row's spawn and is dropped (1:1, nearest first).
#   task            the ledger identity for (project, task_id) live at the
#                   spawn. Per session the latest `created` at/before ts
#                   supersedes earlier ones (a session can reuse an id once the
#                   first task closed); it is live if not ended before ts and
#                   its session's last non-bookkeeping ledger event (see
#                   _ledger_index) is at most --live-window hours (default 2)
#                   before the spawn (an event up to 5 min after it counts,
#                   as for owners). Trace rows carry no session, so two live
#                   candidates from different sessions are ambiguous (#97).
#   served task     when the row's own task is not live or is ambiguous, the task
#                   the spawn served, labelled as such: the Agent call in a
#                   surviving session transcript whose prompt names "task #N"
#                   (or whose teammate name owns a task) — judged against each
#                   named task, counted only when every one gives the same
#                   bucket (a teammate name owning exactly one picks it;
#                   otherwise unknown: ambiguous_served_task) — else a task in progress
#                   at ts in a live session whose plan names the spawned agent —
#                   only if that session is the only live one or every task in
#                   progress across the live sessions plans that agent
#                   (otherwise unknown: ambiguous_served_task).
#   recommendation  the task's created.metadata.agent — written at TaskCreate,
#                   before and apart from the spawn.
#
#   self_executed   spawned_agent is the orchestrator family (no spawn), no
#                   non-orchestrator owner claimed the task, and no spawn of its
#                   planned agent is on record from 10 min before the task was
#                   created to the record.
#   agreed          spawned == the recommendation, or == the recommendation of
#                   a sibling in the same session that is in progress at ts (a
#                   start up to 5 min after the spawn counts: owners are often
#                   set right after the Agent call) or is a pending review
#                   sibling (the reviewer spawn is what activates it).
#                   Sibling matches are reported separately. A row with a
#                   hand-written override_reason names its task on purpose and
#                   is never sibling-matched (that is a diverged row).
#   companion       a different agent spawned while the recommended agent also
#                   ran for the task (review sibling, research helper), or the
#                   recommendation was the orchestrator itself. Not a reroute.
#   diverged        the task had a recommendation; a different agent was
#                   spawned and the recommended one never ran for it.
#   unknown         no independent recommendation (reason recorded).
#
# Rows whose project has no ledger at all (the #94 test-fixture leak, unwired
# projects) are excluded from every denominator and counted separately.
# Headline: rate_pct == decided_rate_pct = diverged / (agreed + companion +
# diverged), with coverage_pct = decided / ledgered rows and the bounds
# floor_pct (no unknown row diverged) .. ceiling_pct (every one did).
# Rollback: V11_AS_ROUTING_RAW=true restores the raw count above;
# V11_AS_TRANSCRIPTS=off skips the transcript lookup; V11_AS_ROTATED=off reads
# the live ledger files only.
# ---------------------------------------------------------------------------
if routing_mode:
    _SLACK = datetime.timedelta(seconds=120)
    _GRACE = datetime.timedelta(minutes=5)
    _LIVE_WINDOW_H = float(env("V11_AS_LIVE_WINDOW_H") or 2)
    _LIVE_WINDOW = datetime.timedelta(hours=_LIVE_WINDOW_H)
    _SELF_EXEC_LEAD = datetime.timedelta(minutes=10)
    _ECHO_RE = re.compile(r"^recommended=.*, spawned=.*$")
    BUCKETS = ["agreed", "diverged", "self_executed", "companion", "unknown"]

    trace_rows = read_jsonl(trace_path)

    def _dur(r):
        d = r.get("duration_ms")
        return datetime.timedelta(milliseconds=d) if isinstance(d, (int, float)) and not isinstance(d, bool) else datetime.timedelta(0)

    # --- the spawn population (#66 fix 1) -----------------------------------
    orch_rows = [r for r in trace_rows if r.get("event") != "completion"]
    comp_rows = [r for r in trace_rows if r.get("event") == "completion"]
    _comp_by_key = {}
    for i, r in enumerate(comp_rows):
        ts = parse_ts(r.get("ts"))
        if ts is not None and r.get("spawned_agent"):
            _comp_by_key.setdefault((r.get("project"), _canon(r["spawned_agent"])), []).append((ts - _dur(r), i))
    _paired = set()
    for r in sorted(orch_rows, key=lambda r: parse_ts(r.get("ts")) or datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)):
        ts, sa = parse_ts(r.get("ts")), r.get("spawned_agent")
        if ts is None or not sa or _canon(sa) == "orchestrator":
            continue
        best = None
        for start, i in _comp_by_key.get((r.get("project"), _canon(sa)), []):
            if i not in _paired and ts - datetime.timedelta(minutes=30) <= start <= ts + datetime.timedelta(minutes=5):
                if best is None or abs(start - ts) < best[0]:
                    best = (abs(start - ts), i)
        if best:
            _paired.add(best[1])
    spawn_rows = ([(r, "orchestrator_row") for r in orch_rows]
                  + [(r, "completion_only") for i, r in enumerate(comp_rows) if i not in _paired])

    # Every real spawn per (project, canonical agent), unfiltered by --since:
    # the companion and self-exec tests ask whether an agent ran at all. A
    # completion row is stamped at the call's end, so it counts from its start.
    _spawn_ts = {}
    for t in trace_rows:
        ts = parse_ts(t.get("ts"))
        if ts is not None and t.get("spawned_agent") and _canon(t["spawned_agent"]) != "orchestrator":
            start = ts - _dur(t) if t.get("event") == "completion" else ts
            _spawn_ts.setdefault((t.get("project"), _canon(t["spawned_agent"])), []).append(start)
    for v in _spawn_ts.values():
        v.sort()

    def _spawned_between(project, agent_c, lo, hi):
        lst = _spawn_ts.get((project, agent_c)) or []
        j = bisect.bisect_left(lst, lo)
        return j < len(lst) and lst[j] <= hi

    # --- liveness (#66 fix 2) ---------------------------------------------------
    def _session_live(idx, sid, ts):
        # An event up to _GRACE after the spawn counts, as for owner/in_progress
        # writes: a session resuming after >2 h often logs its first event
        # (the in_progress) minutes after the Agent call.
        st = idx["sess_act"].get(sid, [])
        j = bisect.bisect_right(st, ts + _GRACE)
        return j > 0 and ts - st[j - 1] <= _LIVE_WINDOW

    def _state_at(i, t):
        st = None
        for ets, s in i["timeline"]:
            if ets > t:
                break
            st = s
        return st

    def _closed_at(i, ts):
        """Closed at ts and already closed _SLACK before it (a reopen counts)."""
        return _state_at(i, ts - _SLACK) == "closed" and _state_at(i, ts) == "closed"

    def _is_live(idx, ident, ts):
        if _closed_at(ident, ts):
            return False
        return _session_live(idx, ident["session"], ts)

    # S2-T0b-3 (#113): a trace row's task id binds through the shared resolver
    # (scripts/lib/task_epoch.py). A row stamped with its session (S2-T0b-2)
    # binds in that session and TaskList epoch (R1, else R2 at the row ts); an
    # orchestrator row so bound skips the liveness window. A legacy row binds
    # by R3 at the row ts; the window breaks a tie between several
    # identities, and a lone identity that is not live stays task_not_live, as
    # does any hooks/track-agents row (`event` set): their ids are the
    # untrusted active_task_ids[0] of #103, and the S1-T11 blind checks label
    # a closed or idle identity's row unknown, not its task's.
    # Deviation from design §4 row 5 ("the window only breaks R3 ties"),
    # orchestrator decision 2026-09-27: the literal rule binds zombie
    # identities (s1-t11b-blind-handcheck.md:110) and fails 13 validated
    # tests, and M3 is re-measured on new, stamped rows only (G1), which bind
    # exactly without the window anyway.
    # The index is built from the rows read here (rotated included), with no
    # replay (no rehydrate aliases, as ids above).
    # Rollback: V11_TASK_RESOLVER=legacy (the window alone, every row).
    _RESOLVER_SHARED = env("V11_TASK_RESOLVER", "shared") != "legacy"
    _UUID_RE = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
    _tix_cache = {}

    def _task_index(project, idx):
        if project not in _tix_cache:
            try:
                import task_epoch
                _tix_cache[project] = task_epoch.TaskIndex.from_ledger(
                    project, events=idx["rows"], identities=[],
                    metrics_dir=os.path.dirname(ledger_dir) if ledger_dir else None)
            except Exception:
                _tix_cache[project] = None
        return _tix_cache[project]

    def _live_identity(idx, task_id, ts, row=None):
        tix = _task_index(row.get("project"), idx) if _RESOLVER_SHARED and row is not None else None
        if tix is None:
            return _live_identity_window(idx, task_id, ts)
        import task_epoch
        tid = str(task_id or "")
        res = tix.resolve(row.get("session_uuid") or None, tid, epoch=task_epoch.tl_epoch_of(row),
                          at=(ts, None))
        # Exact only when bound inside the row's own session (R1/R2): a
        # session that is no UUID, or one with no claim on the id, falls back
        # to R3 ("only"), fleet-wide, which the liveness window still vets
        # (review #23).
        exact = ("event" not in row and res.basis != "only"
                 and bool(_UUID_RE.fullmatch(str(row.get("session_uuid") or ""))))
        if res.status == task_epoch.BOUND:
            i = idx["ids"].get(res.identity)
            if i is None:
                return None, "task_not_in_ledger"
            if not exact and not _is_live(idx, i, ts):
                return None, "task_not_live"
            return i, None
        if res.status == task_epoch.UNRESOLVED:
            return None, "task_not_in_ledger"
        live = [idx["ids"][c] for c in res.candidates
                if c in idx["ids"] and _is_live(idx, idx["ids"][c], ts)]
        if not live:
            return None, "task_not_live"
        if len(live) > 1:
            return None, "ambiguous_identity"
        return live[0], None

    def _live_identity_window(idx, task_id, ts):
        latest = {}  # session -> its latest creation of this task_id at/before ts
        for i in idx["by_tid"].get(str(task_id or ""), []):
            if i["created"] <= ts + _SLACK:
                cur = latest.get(i["session"])
                if cur is None or i["created"] >= cur["created"]:
                    latest[i["session"]] = i
        if not latest:
            return None, "task_not_in_ledger"
        live = [i for i in latest.values() if _is_live(idx, i, ts)]
        if not live:
            return None, "task_not_live"
        if len(live) > 1:
            return None, "ambiguous_identity"
        return live[0], None

    def _sibling_live(i, ts):
        if i["created"] > ts + _SLACK or _closed_at(i, ts):
            return False
        return (i["is_review"] or _state_at(i, ts) == "active"
                or any(s == "active" and ts < ets <= ts + _GRACE for ets, s in i["timeline"]))

    def _ran_during(project, agent_c, ident, idx):
        st = idx["sess_act"].get(ident["session"]) or [ident["created"]]
        return _spawned_between(project, agent_c, ident["created"] - _SLACK,
                                (ident["end"] or st[-1]) + _SLACK)

    def _written_reason(row):
        """A rationale the orchestrator wrote itself — not the track-agents echo
        and not the sync-tasks self-exec sentinel (#53 item 3)."""
        reason = (row.get("override_reason") or "").strip()
        if not reason or reason == "unattributed-self-exec" or _ECHO_RE.match(reason):
            return ""
        return reason

    # --- served task: transcripts (#66 fix 4) -----------------------------------
    _tdir = env("V11_AS_TRANSCRIPTS_DIR")
    _transcripts_on = env("V11_AS_TRANSCRIPTS") != "off" and bool(_tdir) and os.path.isdir(_tdir)
    _transcript_paths = None
    _transcript_calls = {}
    _TASK_RE = re.compile(r"(?i)\btasks?\s*((?:#\s*[\w.-]+[\s,&/+]*(?:and\s+)?)+)")

    def _session_transcript(sid):
        global _transcript_paths
        if _transcript_paths is None:
            _transcript_paths = {}
            for d in sorted(os.listdir(_tdir)):
                p = os.path.join(_tdir, d)
                if os.path.isdir(p):
                    for f in os.listdir(p):
                        if f.endswith(".jsonl"):
                            _transcript_paths.setdefault(f[:-6], os.path.join(p, f))
        return _transcript_paths.get(sid)

    def _agent_calls(path):
        """(ts, subagent_type, teammate name, task ids named in the prompt) for
        every Agent/Task tool call in one session transcript. Fails open."""
        if path in _transcript_calls:
            return _transcript_calls[path]
        calls = []
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as fh:
                for ln in fh:
                    if '"tool_use"' not in ln or ('"Agent"' not in ln and '"Task"' not in ln):
                        continue
                    try:
                        d = json.loads(ln)
                    except Exception:
                        continue
                    cts = parse_ts(d.get("timestamp"))
                    for c in ((d.get("message") or {}).get("content") or []):
                        if (isinstance(c, dict) and c.get("type") == "tool_use"
                                and c.get("name") in ("Agent", "Task") and isinstance(c.get("input"), dict)):
                            inp = c["input"]
                            text = f"{inp.get('description') or ''}\n{inp.get('prompt') or ''}"
                            tids = set()
                            for m in _TASK_RE.finditer(text):
                                # 'task #7.' / 'tasks #104-#110': drop trailing punctuation
                                tids.update(t.rstrip(".-") for t in re.findall(r"#\s*([\w.-]+)", m.group(1)))
                            calls.append((cts, str(inp.get("subagent_type") or ""), inp.get("name"), tids))
        except Exception:
            calls = []
        _transcript_calls[path] = calls
        return calls

    def _transcript_served(row, idx, ts, sa):
        """Identities named by the one Agent call that matches this spawn, or None.
        A teammate name that owns exactly one of them picks that one."""
        if not _transcripts_on:
            return None
        lo, hi = ts - _dur(row) - datetime.timedelta(seconds=60), ts + datetime.timedelta(seconds=5)
        hits = []
        for sid in idx["sess_ts"]:
            st = idx["sess_ts"][sid]
            j = bisect.bisect_left(st, ts - _LIVE_WINDOW)
            if not (j < len(st) and st[j] <= ts + _LIVE_WINDOW):
                continue  # session wrote nothing near the spawn
            path = _session_transcript(sid)
            if not path:
                continue
            for cts, typ, name, tids in _agent_calls(path):
                if cts is not None and lo <= cts <= hi and _canon(typ) == sa:
                    hits.append((sid, name, tids))
        if len(hits) != 1:
            return None  # no call, or more than one candidate call
        sid, name, tids = hits[0]
        latest = {}
        for i in idx["by_sess"].get(sid, []):
            if i["created"] <= ts + _SLACK and (i["task_id"] in tids or (name and i["owner"] == name)):
                cur = latest.get(i["task_id"])
                if cur is None or i["created"] >= cur["created"]:
                    latest[i["task_id"]] = i
        owned = [i for i in latest.values() if name and i["owner"] == name]
        return (owned if len(owned) == 1 else list(latest.values())) or None

    def _in_progress(i, ts):
        return (not _closed_at(i, ts) and i["created"] <= ts + _SLACK
                and (_state_at(i, ts) == "active"
                     or any(s == "active" and ts < ets <= ts + _GRACE for ets, s in i["timeline"])))

    def _ledger_served(idx, ts, sa):
        """-> (task, None) for a task in progress at ts in a live session whose plan
        names the spawned agent; (None, "ambiguous_served_task") when a plan-name
        match exists but another live session could have made the spawn and not
        every task in progress across the live sessions plans that agent (S1-T11f:
        blind sample 2 row 41 matched a sibling session's task while the spawn
        served one with no plan); (None, None) when nothing matches."""
        live = [sid for sid in idx["by_sess"] if _session_live(idx, sid, ts)]
        match = next((i for sid in live for i in idx["by_sess"][sid]
                      if i["rec"] and not _is_reconstructed(i["source"]) and _sibling_live(i, ts)
                      and sa in _rec_agents(i["rec"])), None)
        if match is None:
            return None, None
        if len(live) == 1 or all(sa in _rec_agents(i["rec"]) for sid in live
                                 for i in idx["by_sess"][sid] if _in_progress(i, ts)):
            return match, None
        return None, "ambiguous_served_task"

    def _judge(row, sa, recs, ident, idx, ts, allow_siblings=True):
        """bucket for a real spawn against one task."""
        if sa in recs:
            return "agreed", None
        if recs and _written_reason(row):
            # A hand-written override names its task on purpose: no sibling
            # broadening, no companion — it is the declared reroute.
            return "diverged", None
        if allow_siblings:
            for i in idx["by_sess"].get(ident["session"], []):
                if (i is not ident and i["rec"] and not _is_reconstructed(i["source"])
                        and _sibling_live(i, ts) and sa in _rec_agents(i["rec"])):
                    return "agreed", ("review_sibling" if i["is_review"] else "sibling")
        if not recs:
            return "unknown", None
        if "orchestrator" in recs or any(_ran_during(row.get("project"), a, ident, idx) for a in recs):
            return "companion", None
        return "diverged", None

    def _classify(row):
        """-> (bucket, unknown_reason, canonical recommendation or None, sub-tag)"""
        sa = _canon(row["spawned_agent"])
        ts = parse_ts(row.get("ts"))
        idx = _ledger_index(row.get("project"))
        if idx is None:
            return "unknown", "no_ledger", None, None
        if ts is None:
            return "unknown", "task_not_in_ledger", None, None
        ident, why = _live_identity(idx, row.get("task_id"), ts, row)
        if ident is None:
            if sa == "orchestrator":
                return "unknown", why, None, None
            served = _transcript_served(row, idx, ts, sa)
            if served:
                served = [i for i in served if not _is_reconstructed(i["source"])]
                if served:
                    recs = []
                    for i in served:
                        recs += [a for a in _rec_agents(i["rec"]) if a not in recs]
                    # S1-T11f's rule on this path too (review #6): the verdict
                    # must not depend on which named task the spawn served.
                    bs = {_judge(row, sa, _rec_agents(i["rec"]), i, idx, ts, allow_siblings=False)[0]
                          for i in served}
                    if len(bs) > 1:
                        return "unknown", "ambiguous_served_task", None, None
                    b = bs.pop()
                    if b != "unknown":
                        return b, None, recs[0] if recs else None, "served_task_transcript"
            served, amb = _ledger_served(idx, ts, sa)
            if served is not None:
                return "agreed", None, sa, "served_task_ledger"
            return "unknown", amb or why, None, None
        if _is_reconstructed(ident["source"]):
            return "unknown", "reconstructed_row", None, None
        recs = _rec_agents(ident["rec"])
        rec_c = recs[0] if recs else None
        if sa == "orchestrator":
            if ident["owner"] and _canon(ident["owner"]) != "orchestrator":
                return "unknown", "self_exec_contradicted", None, None
            if any(_spawned_between(row.get("project"), a, ident["created"] - _SELF_EXEC_LEAD, ts + _SLACK)
                   for a in recs if a != "orchestrator"):
                return "unknown", "self_exec_spawn_in_window", None, None
            return "self_executed", None, rec_c, None
        b, sub = _judge(row, sa, recs, ident, idx, ts)
        if b == "unknown":
            return "unknown", "no_recommendation", None, None
        return b, None, rec_c, sub

    SUBS = ["agreed_sibling", "agreed_sibling_review"]
    per_agent = {}
    overall = Counter()
    unknown_reasons = Counter()
    sources = Counter()
    served = Counter()
    total_all = 0
    excluded_no_ledger = 0
    for rec, src in spawn_rows:
        if not rec.get("recommended_agent") or not rec.get("spawned_agent"):
            continue
        if only_proj and rec.get("project") != only_proj:
            continue
        if not in_window(rec, ts_key="ts"):
            continue
        total_all += 1
        sources[src] += 1
        bucket, why, rec_c, sub = _classify(rec)
        if why == "no_ledger":
            excluded_no_ledger += 1
            continue
        key = rec_c or "(no independent rec)"
        b = per_agent.setdefault(key, {"total": 0, "reasons": Counter(), **{k: 0 for k in BUCKETS + SUBS}})
        b["total"] += 1
        b[bucket] += 1
        overall[bucket] += 1
        if sub in ("sibling", "review_sibling"):
            for k in (["agreed_sibling"] + (["agreed_sibling_review"] if sub == "review_sibling" else [])):
                b[k] += 1
                overall[k] += 1
        elif sub:
            served[(sub, bucket)] += 1
        if why:
            unknown_reasons[why] += 1
        reason = _written_reason(rec)
        if reason:
            b["reasons"][reason] += 1

    def _pct(n, d):
        return round(n / d * 100.0, 1) if d else 0.0

    def _rate(n, d):
        return round(n / d * 100.0, 1) if d else None  # nothing decided -> no rate

    routing_rows = []
    for ra, b in per_agent.items():
        dec = b["agreed"] + b["companion"] + b["diverged"]
        routing_rows.append({
            "recommended_agent": ra,
            "total_spawns": b["total"],
            **{k: b[k] for k in BUCKETS + SUBS},
            "decided": dec,
            "rate_pct": _rate(b["diverged"], dec),
            "top_override_reasons": [{"reason": r, "count": c} for r, c in b["reasons"].most_common(3)],
        })
    routing_rows.sort(key=lambda r: (-r["diverged"], -r["total_spawns"], r["recommended_agent"]))
    ledgered = total_all - excluded_no_ledger
    decided = overall["agreed"] + overall["companion"] + overall["diverged"]
    served_block = {src: {k: served[(f"served_task_{src}", k)] for k in ("agreed", "companion", "diverged")}
                    for src in ("transcript", "ledger")}
    overall_block = {
        "total_spawns": total_all,
        "spawn_sources": {"orchestrator_rows": sources["orchestrator_row"],
                          "completion_only": sources["completion_only"],
                          "completion_deduped": len(_paired)},
        "excluded_no_ledger": excluded_no_ledger,
        "ledgered_rows": ledgered,
        **{k: overall[k] for k in BUCKETS + SUBS},
        "served_task": served_block,
        "decided": decided,
        "rate_pct": _rate(overall["diverged"], decided),
        "decided_rate_pct": _rate(overall["diverged"], decided),
        "coverage_pct": _pct(decided, ledgered),
        "floor_pct": _pct(overall["diverged"], ledgered),
        "ceiling_pct": _pct(overall["diverged"] + overall["unknown"], ledgered),
        "self_executed_pct": _pct(overall["self_executed"], ledgered),
        "unknown_pct": _pct(overall["unknown"], ledgered),
        "unknown_reasons": dict(unknown_reasons.most_common()),
        "liveness_window_h": _LIVE_WINDOW_H,
        "rotated_ledger_rows": sum((i or {}).get("rotated_rows", 0) for i in _ledger_cache.values()),
        "transcripts": "on" if _transcripts_on else "off",
    }

    if as_json:
        print(json.dumps({
            "generated_at": now.isoformat(),
            "filters": {"since": since_raw, "project": only_proj},
            "advisory_only": True,
            "source": trace_path,
            "method": "independent recommendation: ledger created.metadata.agent (S1-T11, #53)",
            "agents": routing_rows,
            "overall": overall_block,
        }, indent=2))
        sys.exit(0)

    def _fmt_rate(v):
        return "—" if v is None else f"{v:.1f}%"

    print("V11.32 Agent Scorecard — Routing Report   (ADVISORY ONLY — does not drive DAAO)")
    print("  S1-T11 (#53): judged against the ledger's created.metadata.agent, not the row's own")
    print("  recommended_agent/override_reason. The drop from the raw rate is a measurement fix,")
    print("  not a routing improvement. Raw count: V11_AS_ROUTING_RAW=true.")
    filt = []
    if since_raw: filt.append(f"since={since_raw}")
    if only_proj: filt.append(f"project={only_proj}")
    if filt:
        print("  filters: " + "  ".join(filt))
    print("=" * 96)
    print(f"  {'RECOMMENDED':<24} {'ROWS':>6} {'AGREED':>6} {'DIVRG':>6} {'SELF':>6} "
          f"{'COMPN':>6} {'UNKN':>6} {'DEC%':>6}  WRITTEN OVERRIDE REASONS")
    print("  " + "-" * 92)
    for r in routing_rows:
        top_s = "; ".join(f"{x['reason'][:40]} ({x['count']})" for x in r["top_override_reasons"]) or "—"
        print(f"  {r['recommended_agent'][:24]:<24} {r['total_spawns']:>6} {r['agreed']:>6} "
              f"{r['diverged']:>6} {r['self_executed']:>6} {r['companion']:>6} {r['unknown']:>6} "
              f"{_fmt_rate(r['rate_pct']):>6}  {top_s}")
    print("  " + "-" * 92)
    ob = overall_block
    ss = ob["spawn_sources"]
    print(f"  {'OVERALL':<24} {ledgered:>6} {ob['agreed']:>6} {ob['diverged']:>6} "
          f"{ob['self_executed']:>6} {ob['companion']:>6} {ob['unknown']:>6} {_fmt_rate(ob['rate_pct']):>6}")
    print(f"  HEADLINE  diverged {ob['diverged']} of {decided} decided rows = {_fmt_rate(ob['rate_pct'])}"
          f"   coverage {decided}/{ledgered} ledgered rows = {ob['coverage_pct']:.1f}%")
    print(f"  bounds over ledgered rows: {ob['floor_pct']:.1f}% if no unknown row diverged"
          f" .. {ob['ceiling_pct']:.1f}% if every one did")
    print(f"  spawns counted: {total_all} = {ss['orchestrator_rows']} orchestrator/dispatch rows"
          f" + {ss['completion_only']} completion-only hook rows"
          f"   ({ss['completion_deduped']} completion rows deduped against an orchestrator row)")
    print(f"  agreed {ob['agreed']} = own task {ob['agreed'] - ob['agreed_sibling'] - served_block['transcript']['agreed'] - served_block['ledger']['agreed']}"
          f" + in-progress sibling {ob['agreed_sibling'] - ob['agreed_sibling_review']}"
          f" + review sibling {ob['agreed_sibling_review']}"
          f" + served task {served_block['transcript']['agreed'] + served_block['ledger']['agreed']}")
    print(f"  served-task rows (own task not live): transcript "
          + ", ".join(f"{k} {v}" for k, v in served_block["transcript"].items())
          + "; ledger sibling agreed " + str(served_block["ledger"]["agreed"])
          + f"   [transcripts {ob['transcripts']}]")
    print(f"  self_executed {ob['self_executed_pct']:.1f}%   unknown {ob['unknown_pct']:.1f}%"
          + ("  — " + ", ".join(f"{k} {v}" for k, v in unknown_reasons.most_common()) if unknown_reasons else ""))
    print(f"  liveness: a task is live when its session's last non-bookkeeping ledger event is at most"
          f" {_LIVE_WINDOW_H:g} h before the spawn (--live-window)   rotated ledger rows read: {ob['rotated_ledger_rows']}")
    if excluded_no_ledger:
        print(f"  excluded from every denominator: {excluded_no_ledger} rows whose project has no ledger"
              f" (#94 test-fixture leak, unwired projects)")
    print()
    if total_all == 0:
        print("  No dispatch-trace data found under the current filters.")
        print(f"  Ledger: {trace_path}  ({'present' if os.path.exists(trace_path) else 'absent'})")
    sys.exit(0)

# ---------------------------------------------------------------------------
# Per-layer aggregation
# ---------------------------------------------------------------------------

def empty_layer():
    return {
        "actions": 0,        # autonomy-audit: total events for Layer 1; lite/wave/swarm: error count
        "errors": 0,         # actual errors (outcome=="error" for Layer 1; all lines for L2/3/4)
        "by_severity": {s: 0 for s in SEV_ORDER},
        "error_types": Counter(),
        "caller_kind": Counter(),
        "cause_kind": Counter(),   # v11.44: briefing_defect | briefing_risk | execution_defect
        "reasons": Counter(),      # v11.44: brief-layer reason tags (unscoped / no_agent_assigned / …)
        "trend": "no_data",
        "recent": [],        # last 5 errors with timestamps
    }

layers = {l: empty_layer() for l in LAYERS}

def caller_kind_pass(rec_kind):
    """Filter helper. only_caller='all' accepts everything (including missing field)."""
    if only_caller == "all":
        return True
    if rec_kind is None:  # field absent → "unknown" semantics
        return only_caller == "unknown"
    return rec_kind == only_caller

# --- Layer 1: runtime from autonomy-audit ---
if only_layer in ("all", "runtime"):
    sl = layers["runtime"]
    for rec in read_jsonl(audit_path):
        if _canon(rec.get("agent_id")) != agent:
            continue
        if not in_window(rec):
            continue
        if only_proj and rec.get("project") != only_proj:
            continue
        if not caller_kind_pass(rec.get("caller_kind")):
            continue
        sl["actions"] += 1
        if rec.get("outcome") == "error":
            sl["errors"] += 1
            # Layer 1 has no severity per-se; use risk_level as a proxy
            risk = (rec.get("risk_level") or "").upper()
            sev = "HIGH" if risk == "HIGH" else ("MEDIUM" if risk == "MEDIUM" else "LOW")
            sl["by_severity"][sev] += 1
            sl["error_types"][rec.get("action") or "unknown"] += 1
            sl["recent"].append({
                "timestamp": rec.get("timestamp"),
                "severity": sev,
                "type": rec.get("action"),
                "message": (rec.get("error") or "")[:120],
                "project": rec.get("project"),
            })
        ck = rec.get("caller_kind")
        sl["caller_kind"][ck if ck else "unknown"] += 1

# --- Layers 2/3/4: lite/wave/swarm from agent-errors ---
for rec in read_jsonl(errors_path):
    if _canon(rec.get("agent_id")) != agent:
        continue
    if not in_window(rec):
        continue
    if only_proj and rec.get("project") != only_proj:
        continue
    layer_val = rec.get("found_by_layer") or "lite"  # legacy V11.15 entries → lite
    if layer_val not in LAYERS:
        continue
    if only_layer != "all" and only_layer != layer_val:
        continue
    if not caller_kind_pass(rec.get("caller_kind")):
        continue
    sl = layers[layer_val]
    sl["errors"] += 1
    sl["actions"] += 1  # for review-derived layers, "actions" == reviewed errors
    sev = (rec.get("severity") or "LOW").upper()
    if sev in sl["by_severity"]:
        sl["by_severity"][sev] += 1
    et = rec.get("error_type") or "unknown"
    sl["error_types"][et] += 1
    # v11.44: brief-layer detail (cause_kind + reason tags) for the Brief Quality section
    _ckd = rec.get("cause_kind")
    if _ckd:
        sl["cause_kind"][_ckd] += 1
    for _rsn in (rec.get("reasons") or []):
        sl["reasons"][_rsn] += 1
    ck = rec.get("caller_kind")
    sl["caller_kind"][ck if ck else "unknown"] += 1
    sl["recent"].append({
        "timestamp": rec.get("timestamp"),
        "severity": sev,
        "type": et,
        "message": (rec.get("error_message") or "")[:120],
        "project": rec.get("project"),
    })

# --- Trend computation: last 30d vs prior 30d (per layer) ---
W = 30  # days
window_a_start = now - datetime.timedelta(days=W)
window_b_start = now - datetime.timedelta(days=2 * W)

def in_period(ts_str, start, end):
    ts = parse_ts(ts_str)
    if ts is None:
        return False
    return start <= ts < end

def count_in(records, start, end, ts_key="timestamp"):
    return sum(1 for r in records if in_period(r.get(ts_key), start, end))

# Layer 1 trend from autonomy-audit
audit_for_agent = [
    r for r in read_jsonl(audit_path)
    if _canon(r.get("agent_id")) == agent
    and r.get("outcome") == "error"
    and (not only_proj or r.get("project") == only_proj)
    and caller_kind_pass(r.get("caller_kind"))
]
# L2-L4 trend from agent-errors
errors_for_agent = [
    r for r in read_jsonl(errors_path)
    if _canon(r.get("agent_id")) == agent
    and (not only_proj or r.get("project") == only_proj)
    and caller_kind_pass(r.get("caller_kind"))
]

def trend_label(records, layer_filter=None):
    if layer_filter and layer_filter != "runtime":
        filtered = [r for r in records if (r.get("found_by_layer") or "lite") == layer_filter]
    elif layer_filter == "runtime":
        filtered = records  # already filtered to error events
    else:
        filtered = records
    a = count_in(filtered, window_a_start, now)
    b = count_in(filtered, window_b_start, window_a_start)
    if a == 0 and b == 0:
        return "no_data"
    if b == 0:
        return "no_baseline"  # we have current activity but no prior baseline
    delta_pct = (a - b) / max(b, 1)
    if delta_pct <= -0.10:
        return "improving"
    if delta_pct >= 0.10:
        return "degrading"
    return "stable"

if only_layer in ("all", "runtime"):
    layers["runtime"]["trend"] = trend_label(audit_for_agent, "runtime")
for l in ("lite", "wave", "swarm"):
    if only_layer in ("all", l):
        layers[l]["trend"] = trend_label(errors_for_agent, l)

# --- Cross-layer caller_kind split (errors only) ---
caller_split = Counter()
for l in LAYERS:
    if only_layer != "all" and only_layer != l:
        continue
    sl = layers[l]
    for k, v in sl["caller_kind"].items():
        caller_split[k] += v

# ---------------------------------------------------------------------------
# V11.21 T16 — self_review_miss calibration (INV-3 falsifiability)
#
# A "miss" is a parent task where:
#   - the executor's self_review.severity ∈ {NONE, LOW} (executor optimistic), AND
#   - the paired adversarial review's max severity ∈ {HIGH, CRITICAL} (reality bites)
#
# Calibration miss rate makes Layer A (self-review) falsifiable. Without it
# self-review is ceremony — agents could always emit severity=NONE and the
# framework would have no way to surface the dishonesty.
#
# Data sources (idempotent reads, never writes):
#   1. ~/.agent-metrics/task-state/<project>.json  task_artifacts.<id>.self_review
#      → per (project, task_id, executor agent) extract self_severity.
#   2. agent-errors.jsonl  found_by_layer="lite_adversarial"  task_id=<parent>
#      → per (project, task_id) extract MAX adversarial severity across entries.
#
# Pairing key: (project, task_id). Executor agent comes from task_artifacts
# field (preferred) or recommended_agents[task_id] (fallback).
# ---------------------------------------------------------------------------

SELF_LOW_SET = {"NONE", "LOW"}
ADV_HIGH_SET = {"HIGH", "CRITICAL"}

def _read_task_state_aggregates(dir_path):
    """Yield (project, state_dict) for each *.json in the task-state dir."""
    if not dir_path or not os.path.isdir(dir_path):
        return
    for name in os.listdir(dir_path):
        if not name.endswith(".json"):
            continue
        path = os.path.join(dir_path, name)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except Exception:
            continue
        project = data.get("project") or name[:-5]
        yield project, data

def _self_review_records_for_agent():
    """Collect (project, task_id, executor_agent, self_severity, completed_at) tuples
    for the agent under analysis. Filter by project / since_dt up front."""
    out = []
    for project, state in _read_task_state_aggregates(task_state_dir):
        if only_proj and project != only_proj:
            continue
        artifacts = state.get("task_artifacts") or {}
        rec_agents = state.get("recommended_agents") or {}
        # recent_completed gives completion timestamps per task_id
        completed_ts = {}
        for rc in state.get("recent_completed") or []:
            if not isinstance(rc, dict):
                continue
            tid = str(rc.get("id") or rc.get("task_id") or "")
            ts = rc.get("at") or rc.get("completed_at")
            if tid and ts:
                completed_ts.setdefault(tid, ts)
        for tid, arts in artifacts.items():
            if not isinstance(arts, dict):
                continue
            sr = arts.get("self_review")
            if not isinstance(sr, dict):
                continue
            sev = (sr.get("severity") or "").upper()
            if sev not in (SEV_ORDER + ["NONE"]):  # accept NONE too
                continue
            # Executor agent: self_review.agent_id → artifacts.agent_id → recommended_agents
            exec_agent = (
                sr.get("agent_id")
                or arts.get("agent_id")
                or rec_agents.get(str(tid))
                or "unknown"
            )
            if _canon(exec_agent) != agent:
                continue
            ts = completed_ts.get(str(tid))
            if since_dt is not None:
                ts_parsed = parse_ts(ts)
                if ts_parsed is None or ts_parsed < since_dt:
                    continue
            out.append({
                "project": project,
                "task_id": str(tid),
                "executor_agent": exec_agent,
                "self_severity": sev,
                "completed_at": ts,
            })
    return out

def _adversarial_max_severity_by_task():
    """Walk agent-errors.jsonl, return {(project, task_id): max_severity}
    for lite_adversarial entries. NONE>LOW<MEDIUM<HIGH<CRITICAL."""
    rank = {"NONE": 0, "LOW": 1, "MEDIUM": 2, "HIGH": 3, "CRITICAL": 4}
    out = {}
    for rec in read_jsonl(errors_path):
        layer_val = rec.get("found_by_layer")
        # Treat legacy "lite" as adversarial for backward compat — that was the
        # only review layer pre-V11.21. lite_self is explicitly self, skip.
        if layer_val == "lite_self":
            continue
        if layer_val not in ("lite_adversarial", "lite", None):
            continue
        tid = rec.get("task_id")
        if tid is None:
            continue
        project = rec.get("project")
        if only_proj and project != only_proj:
            continue
        sev = (rec.get("severity") or "LOW").upper()
        key = (project, str(tid))
        cur = out.get(key, "NONE")
        if rank.get(sev, 0) > rank.get(cur, 0):
            out[key] = sev
    return out

self_records = _self_review_records_for_agent()
adv_severity = _adversarial_max_severity_by_task()

# Compute pairs
paired_total = 0
misses = []  # list of dicts for trend computation
for sr in self_records:
    adv_sev = adv_severity.get((sr["project"], sr["task_id"]))
    if adv_sev is None:
        # Self emitted but no adversarial verdict — un-paired; not a calibration
        # data point either way (Layer A absent or in flight).
        continue
    paired_total += 1
    if sr["self_severity"] in SELF_LOW_SET and adv_sev in ADV_HIGH_SET:
        misses.append({**sr, "adversarial_severity": adv_sev})

miss_count = len(misses)
miss_rate = (miss_count / paired_total) if paired_total > 0 else 0.0

# 30-day trend on misses
def _miss_in_window(start, end):
    n = 0
    for m in misses:
        ts = parse_ts(m.get("completed_at"))
        if ts and start <= ts < end:
            n += 1
    return n

trend_30 = "no_data"
last30 = _miss_in_window(window_a_start, now)
prior30 = _miss_in_window(window_b_start, window_a_start)
if last30 == 0 and prior30 == 0:
    trend_30 = "no_data"
elif prior30 == 0:
    trend_30 = "no_baseline"
else:
    delta = (last30 - prior30) / max(prior30, 1)
    if delta <= -0.10:
        trend_30 = "improving"
    elif delta >= 0.10:
        trend_30 = "degrading"
    else:
        trend_30 = "stable"

# Calibration advisory (>50% miss rate over 30 days)
# Use last30 misses + only-last-30d paired count for the advisory.
paired_last30 = 0
for sr in self_records:
    adv_sev = adv_severity.get((sr["project"], sr["task_id"]))
    if adv_sev is None:
        continue
    ts = parse_ts(sr.get("completed_at"))
    if ts and window_a_start <= ts < now:
        paired_last30 += 1
miss_rate_30 = (last30 / paired_last30) if paired_last30 > 0 else 0.0
calibration_advisory = miss_rate_30 > 0.50 and paired_last30 >= 4  # noise floor

calibration_block = {
    "miss_count_total": miss_count,
    "miss_count_last30": last30,
    "paired_count_total": paired_total,
    "paired_count_last30": paired_last30,
    "miss_rate_total": round(miss_rate, 3),
    "miss_rate_last30": round(miss_rate_30, 3),
    "trend": trend_30,
    "advisory": calibration_advisory,
    "advisory_threshold": "> 50% over last 30d with ≥4 paired data points",
    "miss_examples": misses[:5],
}

# ---------------------------------------------------------------------------
# W3-T13 — avg tokens/spawn from dispatch-trace.jsonl completion events.
# Layer-independent (a spawn isn't scoped to runtime/lite/wave/swarm), so
# --layer does not filter this block — matches the self-review calibration
# block's pattern of always-shown regardless of --layer. Never fabricated:
# absent entirely unless at least one completion-event line with a numeric
# tokens field exists for this agent under the active --project/--since.
# ---------------------------------------------------------------------------
_token_total = 0
_token_count = 0
for t in read_jsonl(trace_path):
    if t.get("event") != "completion":
        continue
    if t.get("spawned_agent") != agent:
        continue
    tok = t.get("tokens")
    if not isinstance(tok, (int, float)) or isinstance(tok, bool):
        continue
    if only_proj and t.get("project") != only_proj:
        continue
    if not in_window(t, ts_key="ts"):
        continue
    _token_total += tok
    _token_count += 1

avg_tokens = round(_token_total / _token_count, 1) if _token_count > 0 else None

# ---------------------------------------------------------------------------
# S1-D2 — tokens-per-task: min/median/max output tokens per spawn + an honest
# capture-rate label. Builds on W3-T13's completion-event tokens but reports
# distribution (not just avg) and states the denominator explicitly — total
# spawns for this agent — so a small numerator never reads as "the agent's
# overall token usage." Additive to W3-T13's avg_tokens/token_samples fields
# (left untouched for back-compat); unlike that block, this one is ALWAYS
# present in --json output (nulls when no data) rather than omitted, per the
# "never fabricate or omit silently" requirement. Layer-independent, same as
# W3-T13 — a spawn isn't scoped to runtime/lite/wave/swarm, so --layer does
# not filter this block. Sibling task D1 owns wiring more completion events
# to carry tokens; this block only ever reads what's already on disk.
# ---------------------------------------------------------------------------
_total_spawns = 0
for t in read_jsonl(trace_path):
    if t.get("spawned_agent") != agent:
        continue
    if t.get("event") == "completion":
        continue  # completion lines are a supplementary record of an
                   # existing dispatch, not a new spawn — counting both
                   # would double the denominator.
    if only_proj and t.get("project") != only_proj:
        continue
    if not in_window(t, ts_key="ts"):
        continue
    _total_spawns += 1

_token_values = []
for t in read_jsonl(trace_path):
    if t.get("event") != "completion":
        continue
    if t.get("spawned_agent") != agent:
        continue
    tok = t.get("tokens")
    if not isinstance(tok, (int, float)) or isinstance(tok, bool):
        continue
    if only_proj and t.get("project") != only_proj:
        continue
    if not in_window(t, ts_key="ts"):
        continue
    _token_values.append(tok)

def _median(vals):
    s = sorted(vals)
    n = len(s)
    mid = n // 2
    if n % 2 == 1:
        return float(s[mid])
    return (s[mid - 1] + s[mid]) / 2.0

def _fmt_tok(v):
    if v is None:
        return None
    return f"{v/1000:.0f}k" if v >= 1000 else f"{v:.0f}"

# ---------------------------------------------------------------------------
# S1-D7 — tokens_per_task, second capture source: durable ledger completed
# events carrying numeric artifacts.tokens. Context: dispatch-trace completion
# tokens (S1-D2 above) only ever cover FOREGROUND spawns — the harness has no
# PostToolUse hook firing for an async/background spawn's own token usage.
# Instead the orchestrator records `artifacts.tokens` on the TaskUpdate that
# CLOSES an async task, and sync-tasks folds that straight into the
# ev:"completed" durable ledger row (hooks/sync-tasks ~L2044-2077,
# `--argjson arts "${ARTIFACTS:-null}"`). This block reads those rows as a
# second source and MERGES them into the same min/median/max distribution
# S1-D2 built from dispatch-trace alone.
#
# Agent attribution: a ledger row does not carry a fully reliable per-row
# agent field on its own (scripts/backfill-reviews L164: "ledger doesn't
# carry agent reliably"). Reused, not invented — this is the exact cascade
# this same script already trusts for self_review attribution in
# _self_review_records_for_agent() above (self_review.agent_id first, then
# artifacts.agent_id, then recommended_agents). Extended with one additional
# rung specific to ledger rows: the row's own top-level `executor` field
# (V11.22), which is a legitimate agent name across the fleet (spot-checked:
# spec-implementer-v11, backend-architect, Explore, ... in
# ~/.agent-metrics/ledger/*.jsonl) but which ALSO defaults to a generic
# "orchestrator"/"orchestrator-self"/"orchestrator-direct" sentinel when no
# TaskUpdate owner / recommended_agents was set at completion time (hooks/
# sync-tasks L2027-2040) — so those sentinel values are excluded here rather
# than trusted. Full cascade: self_review.agent_id -> artifacts.agent_id ->
# executor (sentinels excluded) -> recommended_agents[task_id] from
# task-state (LOWEST priority — the durable ledger is explicitly designed to
# survive task-state wipes per V11.30, so depending on task-state here is
# deliberately a last resort, never the only source). A row that resolves to
# no agent at all is skipped and counted as unattributed (_artifacts_unattributed)
# — never guessed, and never silently folded into someone else's count.
#
# Dedup: a ledger completed-event and a dispatch-trace completion event can
# describe the SAME spawn when they share a task_id. Correlated via
# (project, task_id): any ledger row whose key already produced a
# dispatch-trace-captured token sample for this agent is skipped so one spawn
# is never double-counted across both sources. Rows that can't be correlated
# this way (task_id missing on either side) are kept from both sources rather
# than dropped — per spec, prefer keeping both over silently losing data when
# correlation isn't possible.
# ---------------------------------------------------------------------------
_ORCH_SENTINELS = {"orchestrator", "orchestrator-self", "orchestrator-direct",
                    "unknown", "claude", ""}

_rec_agents_by_project = {}
for _rap_proj, _rap_state in _read_task_state_aggregates(task_state_dir):
    _rec_agents_by_project[_rap_proj] = _rap_state.get("recommended_agents") or {}

def _resolve_ledger_row_agent(rec, project_hint, idx=None):
    arts = rec.get("artifacts") or {}
    sr = arts.get("self_review") if isinstance(arts.get("self_review"), dict) else {}
    cand = sr.get("agent_id") or arts.get("agent_id")
    if not cand:
        ex = rec.get("executor")
        if isinstance(ex, str) and ex not in _ORCH_SENTINELS:
            cand = ex
    if cand:
        ident = (idx or {}).get("ids", {}).get((rec.get("subject_norm"), rec.get("create_seq")))
        cand = _map_executor(cand, ident)
    if not cand:
        rec_agents = _rec_agents_by_project.get(project_hint) or {}
        cand = rec_agents.get(str(rec.get("task_id")))
    return cand or None

# S1-T11 (#99 item 3): executor labels are mixed — teammate names (s0-t1-lock),
# agent types, orchestrator. A label that is not a known agent type (never
# spawned as a subagent_type, never a metadata.agent) is a teammate name and is
# mapped through the task's created.metadata.agent.
_agent_types = None

def _known_agent_types():
    global _agent_types
    if _agent_types is None:
        _agent_types = {"orchestrator"}
        for t in read_jsonl(trace_path):
            if t.get("spawned_agent"):
                _agent_types.add(_canon(t["spawned_agent"]))
        for _p, _path in _iter_ledger_files():
            for i in ((_ledger_index(_p, _path) or {}).get("ids") or {}).values():
                _agent_types.update(_rec_agents(i["rec"]))
    return _agent_types

def _map_executor(raw, ident):
    raw = raw if isinstance(raw, str) and raw else None  # free-form ledger data
    if raw is None or _canon(raw) in _known_agent_types():
        return raw
    recs = _rec_agents(ident["rec"]) if ident else []
    return recs[0] if recs else raw

def _iter_ledger_files():
    if not ledger_dir or not os.path.isdir(ledger_dir):
        return
    if only_proj:
        if not re.match(r'^[A-Za-z0-9._-]+$', only_proj):
            return
        p = os.path.join(ledger_dir, f"{only_proj}.jsonl")
        if os.path.isfile(p):
            yield only_proj, p
        return
    for name in sorted(os.listdir(ledger_dir)):
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(ledger_dir, name)
        if not os.path.isfile(path):
            continue
        yield name[:-len(".jsonl")], path

# Dispatch-trace spawns already captured for this agent — dedup key set.
_trace_task_keys = set()
for t in read_jsonl(trace_path):
    if t.get("event") != "completion":
        continue
    if t.get("spawned_agent") != agent:
        continue
    tok = t.get("tokens")
    if not isinstance(tok, (int, float)) or isinstance(tok, bool):
        continue
    if only_proj and t.get("project") != only_proj:
        continue
    if not in_window(t, ts_key="ts"):
        continue
    tproj, ttid = t.get("project"), t.get("task_id")
    if tproj is not None and ttid is not None:
        _trace_task_keys.add((tproj, str(ttid)))

_artifacts_token_values = []
_artifacts_captured = 0
_artifacts_unattributed = 0
for _lf_proj, _lf_path in _iter_ledger_files():
    _lf_idx = _ledger_index(_lf_proj, _lf_path)
    for rec in (_lf_idx or {}).get("rows", []):
        if rec.get("ev") != "completed":
            continue
        _arts = rec.get("artifacts") or {}
        tok = _arts.get("tokens") if isinstance(_arts, dict) else None
        if not isinstance(tok, (int, float)) or isinstance(tok, bool):
            continue
        row_project = rec.get("project") or _lf_proj
        if only_proj and row_project != only_proj:
            continue
        if not in_window(rec, ts_key="ts"):
            continue
        row_agent = _resolve_ledger_row_agent(rec, row_project, _lf_idx)
        if row_agent is None:
            _artifacts_unattributed += 1
            continue
        if row_agent != agent:
            continue
        _tid = rec.get("task_id")
        _key = (row_project, str(_tid)) if _tid is not None else None
        if _key is not None and _key in _trace_task_keys:
            continue  # same spawn already captured via dispatch-trace
        _artifacts_token_values.append(tok)
        _artifacts_captured += 1

# Merge the two sources into one distribution.
_merged_token_values = _token_values + _artifacts_token_values
_trace_captured = len(_token_values)

if _merged_token_values:
    _tpt_min = min(_merged_token_values)
    _tpt_max = max(_merged_token_values)
    _tpt_median = _median(_merged_token_values)
else:
    _tpt_min = _tpt_max = _tpt_median = None

_tpt_captured = len(_merged_token_values)
if _artifacts_captured > 0:
    _tpt_capture_rate_str = (
        f"{_tpt_captured}/{_total_spawns} spawns "
        f"({_trace_captured} trace + {_artifacts_captured} artifacts)"
    )
else:
    _tpt_capture_rate_str = f"{_tpt_captured}/{_total_spawns} spawns"

if _merged_token_values:
    _tpt_label = f"median {_fmt_tok(_tpt_median)} (capture {_tpt_capture_rate_str})"
else:
    _tpt_label = "no capture data"

tokens_per_task_block = {
    "min": _tpt_min,
    "median": _tpt_median,
    "max": _tpt_max,
    "captured_spawns": _tpt_captured,
    "total_spawns": _total_spawns,
    "capture_rate": _tpt_capture_rate_str,
    "label": _tpt_label,
    "trace_captured": _trace_captured,
    "artifacts_captured": _artifacts_captured,
}

# ---------------------------------------------------------------------------
# S1-T11 (#99 items 2+3, S1-P1) — review verdicts from the durable ledger on
# the tasks this agent executed. One verdict per reviewed task identity (the
# later row wins), from two sources:
#   - ev:"review" rows (review-queue drains), which name the reviewed identity
#     (subject_norm, create_seq);
#   - `completed` rows of a review task whose artifacts.review has the V11.21
#     lite shape {reviewer, task_id, agent_id, errors}; the reviewed task is
#     artifacts.review.task_id in the review task's own session, latest
#     creation at/before the completion (#97: never a bare task_id, and a
#     session can reuse an id once the first task closed).
# Executor = artifacts.review.agent_id, else the reviewed task's in_progress
# owner (each through _map_executor), else its created.metadata.agent.
# WAIVED/VOID (S1-P3, scripts/lib/review_corrections.py): a row a later
# waived|void row corrects (corrects_seqno + corrects_ts) is dropped, and so
# are "void" rows (a rebinding row re-files a voided verdict on the right
# parent); the correction set is built per ledger file (the key has no
# project) over the whole file, before --since. Waivers are not verdicts
# either: a waived ev:"review" row, or a review-task completion whose
# artifacts.review.verdict is WAIVED, drops the identity's earlier verdict (the
# waiver is the last word) and counts in waived_excluded. migration/backfill-*
# rows are counted but flagged: the S0 backfill is the only record of the S0
# reviews.
# ---------------------------------------------------------------------------
_SEV_RANK = {"NONE": 0, "LOW": 1, "MEDIUM": 2, "HIGH": 3, "CRITICAL": 4}
ledger_reviews_block = {"reviews": 0, "by_severity": {s: 0 for s in _SEV_RANK},
                        "backfill_flagged": 0, "waived_excluded": 0}
for _lf_proj, _lf_path in _iter_ledger_files():
    _lf_idx = _ledger_index(_lf_proj, _lf_path)
    if not _lf_idx:
        continue
    _superseded = superseded_review_keys(_lf_idx["rows"])
    _verdicts = {}
    for r in _lf_idx["rows"]:
        if r.get("ev") == "review" and not is_counted_review(r, _superseded):
            continue  # waived/voided by a later row, or a void row itself
        _rv = (r.get("artifacts") or {}).get("review") if isinstance(r.get("artifacts"), dict) else None
        if r.get("ev") == "review":
            _parent = _lf_idx["ids"].get((r.get("subject_norm"), r.get("create_seq")))
            _raw = None
            _sev = (r.get("review_severity") or "LOW").upper()
        elif (r.get("ev") == "completed" and isinstance(_rv, dict)
              and _rv.get("task_id") and _rv.get("reviewer")):
            _rts = parse_ts(r.get("ts"))
            _cands = [i for i in _lf_idx["by_tid"].get(str(_rv["task_id"]), [])
                      if i["session"] == (r.get("session_uuid") or "")
                      and (_rts is None or i["created"] <= _rts + datetime.timedelta(seconds=120))]
            _parent = max(_cands, key=lambda i: i["created"]) if _cands else None
            _raw = _rv.get("agent_id")
            _errs = [e for e in (_rv.get("errors") or []) if isinstance(e, dict)]
            _sev = max(((e.get("severity") or "LOW").upper() for e in _errs),
                       key=lambda s: _SEV_RANK.get(s, 1),
                       default="LOW" if _rv.get("error_count") else "NONE")
        else:
            continue
        _exec = _map_executor(_raw or (_parent or {}).get("owner"), _parent)
        if not _exec and _parent:
            _exec = (_rec_agents(_parent["rec"]) or [None])[0]
        _key = _parent["key"] if _parent else ("unresolved", r.get("seqno"), r.get("ts"))
        _waiver = (r.get("outcome") == "waived" if r.get("ev") == "review"
                   else str(_rv.get("verdict") or "").upper() == "WAIVED")
        if _waiver:
            _verdicts.pop(_key, None)
            if _exec and _canon(_exec) == agent and in_window(r, ts_key="ts"):
                ledger_reviews_block["waived_excluded"] += 1
            continue
        _flag = _is_reconstructed(r.get("source")) or bool(_parent and _is_reconstructed(_parent["source"]))
        _verdicts[_key] = (r, _exec, _sev, _flag)
    for r, _exec, _sev, _flag in _verdicts.values():
        if not _exec or _canon(_exec) != agent or not in_window(r, ts_key="ts"):
            continue
        ledger_reviews_block["reviews"] += 1
        if _sev in ledger_reviews_block["by_severity"]:
            ledger_reviews_block["by_severity"][_sev] += 1
        if _flag:
            ledger_reviews_block["backfill_flagged"] += 1

# --- Build output rows ---
def render_layer_row(layer_name):
    sl = layers[layer_name]
    if only_layer != "all" and only_layer != layer_name:
        return None
    sev = sl["by_severity"]
    top = sl["error_types"].most_common(3)
    top_s = ", ".join(f"{k}:{v}" for k, v in top) if top else "—"
    return {
        "layer": layer_name,
        "actions": sl["actions"],
        "errors": sl["errors"],
        "critical": sev["CRITICAL"],
        "high":     sev["HIGH"],
        "medium":   sev["MEDIUM"],
        "low":      sev["LOW"],
        "trend":    sl["trend"],
        "top_types": top_s,
    }

rows = [r for l in LAYERS for r in [render_layer_row(l)] if r]

# --- Recent errors (cross-layer, last 5) ---
all_recent = []
for l in LAYERS:
    if only_layer != "all" and only_layer != l:
        continue
    for ev in layers[l]["recent"]:
        all_recent.append({**ev, "layer": l})
all_recent.sort(key=lambda e: parse_ts(e.get("timestamp")) or datetime.datetime.min, reverse=True)
recent5 = all_recent[:5]

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

_out = {
    "generated_at": now.isoformat(),
    "agent": agent,
    "filters": {
        "since": since_raw,
        "project": only_proj,
        "layer": only_layer,
        "caller_kind": only_caller,
    },
    "advisory_only": True,
    "layers": rows,
    "caller_kind_split": dict(caller_split),
    "recent_errors": recent5,
    "self_review_calibration": calibration_block,
}
if _token_count > 0:   # W3-T13: omitted entirely when no token data
    _out["avg_tokens"] = avg_tokens
    _out["token_samples"] = _token_count
# S1-D2: always present (nulls when no data) — never omitted, never fabricated
_out["tokens_per_task"] = tokens_per_task_block
_out["ledger_reviews"] = ledger_reviews_block

# v11.44: Brief Quality — orchestrator authoring signal from found_by_layer="brief".
_bq = layers["brief"]
brief_quality_block = {
    "findings": _bq["errors"],
    "briefing_defect": _bq["cause_kind"].get("briefing_defect", 0),
    "briefing_risk": _bq["cause_kind"].get("briefing_risk", 0),
    "top_reasons": [{"reason": k, "count": v} for k, v in _bq["reasons"].most_common(5)],
    "trend": _bq["trend"],
    "detail_hint": "per-brief detail + % scoped/right-agent: scripts/grade-briefs <project>",
}
_out["brief_quality"] = brief_quality_block

if as_json:
    print(json.dumps(_out, indent=2))
    sys.exit(0)

# --- Human table ---
TREND_GLYPH = {
    "improving":  "▲ improving",
    "degrading":  "▼ degrading",
    "stable":     "= stable",
    "no_baseline":"· first 30d",
    "no_data":    "  no data",
}

print(f"V11.21 Agent Scorecard — {agent}   (ADVISORY ONLY — does not drive DAAO)")
filt = []
if since_raw:    filt.append(f"since={since_raw}")
if only_proj:    filt.append(f"project={only_proj}")
if only_layer != "all":   filt.append(f"layer={only_layer}")
if only_caller != "all":  filt.append(f"caller_kind={only_caller}")
if filt:
    print("  filters: " + "  ".join(filt))
print("=" * 96)
print(f"  {'LAYER':<8}  {'ACTIONS':>8}  {'ERRORS':>7}  {'CRIT':>4}  {'HIGH':>4}  "
      f"{'MED':>4}  {'LOW':>4}  {'TREND':<13}  TOP ERROR TYPES")
print("  " + "-" * 92)

total_actions = total_errors = 0
for r in rows:
    print(f"  {r['layer']:<8}  {r['actions']:>8}  {r['errors']:>7}  "
          f"{r['critical']:>4}  {r['high']:>4}  {r['medium']:>4}  {r['low']:>4}  "
          f"{TREND_GLYPH.get(r['trend'], r['trend']):<13}  {r['top_types']}")
    total_actions += r["actions"]
    total_errors += r["errors"]
print("  " + "-" * 92)
print(f"  {'TOTAL':<8}  {total_actions:>8}  {total_errors:>7}")
print()

# Caller-kind split
if caller_split and sum(caller_split.values()) > 0:
    print("  Caller-kind split (across selected layers):")
    grand = sum(caller_split.values())
    KNOWN_ORDER = ("orchestrator", "subagent", "unknown", "daemon")
    ordered_keys = [k for k in KNOWN_ORDER if k in caller_split]
    ordered_keys += sorted(k for k in caller_split if k not in KNOWN_ORDER)
    for k in ordered_keys:
        v = caller_split.get(k, 0)
        if v == 0:
            continue
        pct = 100.0 * v / grand
        print(f"    {k:<14} {v:>6}  ({pct:5.1f}%)")
    print()

# Recent errors (last 5)
if recent5:
    print("  Recent errors (last 5):")
    for ev in recent5:
        ts = (ev.get("timestamp") or "")[:19]
        sev = ev.get("severity", "")
        layer = ev.get("layer", "")
        typ = ev.get("type", "")
        msg = re.sub(r'[\x00-\x1f\x7f-\x9f]', '', (ev.get("message") or ""))[:80]
        proj = ev.get("project") or "-"
        print(f"    {ts}  [{layer:<7}] {sev:<8} {typ:<18} {msg}   ({proj})")
    print()

# V11.21 T16 — self_review_miss calibration block
print("  Self-review calibration (INV-3 falsifiability):")
print(f"    Paired tasks (self + adversarial verdicts): "
      f"{calibration_block['paired_count_total']} total, "
      f"{calibration_block['paired_count_last30']} last 30d")
print(f"    Misses (self=NONE/LOW + adversarial=HIGH/CRITICAL): "
      f"{calibration_block['miss_count_total']} total, "
      f"{calibration_block['miss_count_last30']} last 30d")
if calibration_block["paired_count_total"] > 0:
    print(f"    Miss rate: {calibration_block['miss_rate_total']*100:.1f}% all-time, "
          f"{calibration_block['miss_rate_last30']*100:.1f}% last 30d   "
          f"({TREND_GLYPH.get(calibration_block['trend'], calibration_block['trend'])})")
else:
    print("    Miss rate: — (no paired data; emit self_review on completion to populate)")
if calibration_block["advisory"]:
    print(f"    ⚠ CALIBRATION ADVISORY: miss rate > 50% over last 30d "
          f"({calibration_block['miss_count_last30']}/{calibration_block['paired_count_last30']}) "
          f"— agent's self-review is consistently optimistic vs adversarial findings. "
          f"Review the agent's postamble + recent miss examples below.")
    if calibration_block["miss_examples"]:
        print("    Recent miss examples:")
        for ex in calibration_block["miss_examples"][:3]:
            print(f"      • [{ex['project']}] task #{ex['task_id']}: "
                  f"self={ex['self_severity']} vs adv={ex['adversarial_severity']} "
                  f"({(ex.get('completed_at') or '')[:19]})")
print()

# S1-T11 — review verdicts from the durable ledger (WAIVED excluded, backfill flagged)
lrb = ledger_reviews_block
print('  Ledger review verdicts (ev:"review" + review-task completions; WAIVED/VOID excluded):')
print(f"    reviews: {lrb['reviews']}  ("
      + ", ".join(f"{k} {v}" for k, v in lrb["by_severity"].items())
      + f")   backfill-flagged: {lrb['backfill_flagged']}   waived excluded: {lrb['waived_excluded']}")
print()

# v11.44 — Brief Quality (orchestrator authoring signal). Shown for the orchestrator,
# or for any agent that has brief-layer findings on record.
if agent == "orchestrator" or brief_quality_block["findings"] > 0:
    bq = brief_quality_block
    print("  Brief Quality (v11.44 — orchestrator authoring signal):")
