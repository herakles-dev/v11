        print("    top reasons: " + ", ".join(f"{r['reason']}:{r['count']}" for r in bq["top_reasons"]))
    print(f"    {bq['detail_hint']}")
    print()

# W3-T13 — avg tokens/spawn (dispatch-trace completion events)
print("  Token usage (W3-T13, from dispatch-trace completion events):")
if _token_count > 0:
    avg_s = f"{avg_tokens/1000:.0f}k" if avg_tokens >= 1000 else f"{avg_tokens:.0f}"
    print(f"    Avg tokens/spawn: {avg_s} (n={_token_count})")
else:
    print("    Avg tokens/spawn: — (no completion-event token data for this agent)")
print()

# S1-D2/S1-D7 — tokens-per-task: min/median/max + source-labeled capture rate
# (trace = dispatch-trace completion events, artifacts = durable-ledger
# artifacts.tokens on async task closes)
print("  Tokens per task (S1-D2/D7, min/median/max output tokens/spawn):")
if _merged_token_values:
    print(f"    tokens/task: min {_fmt_tok(_tpt_min)}  median {_fmt_tok(_tpt_median)}  "
          f"max {_fmt_tok(_tpt_max)}  (capture {_tpt_capture_rate_str})")
else:
    print(f"    tokens/task: no capture data  (0 of {_total_spawns} spawns captured)")
print()

