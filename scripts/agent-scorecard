        print("    top reasons: " + ", ".join(f"{r['reason']}:{r['count']}" for r in bq["top_reasons"]))
    print(f"    {bq['detail_hint']}")
    print()

# W3-T13 — avg tokens/spawn (dispatch-trace completion events)
print("  Token usage (W3-T13, from dispatch-trace completion events):")
if _token_count > 0:
    avg_s = f"{avg_tokens/1000:.0f}k" if avg_tokens >= 1000 else f"{avg_tokens:.0f}"
    print(f"    Avg tokens/spawn: {avg_s} (n={_token_count})")
