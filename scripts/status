#!/bin/bash
# V10 Status - Show session progress from Tasks system
# Usage: ./scripts/status [project] [--sprint NAME]

set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
V10_HOME="${V10_HOME:-$(dirname "$SCRIPT_DIR")}"
HERCULES_ROOT="${HERCULES_ROOT:-$HOME}"
SESSIONS_ROOT="${SESSIONS_ROOT:-$HERCULES_ROOT/sessions}"

# Help
if [ "$1" == "--help" ] || [ "$1" == "-h" ]; then
    cat << 'HELP'
V10 Status - Show progress from Tasks system

USAGE:
    ./scripts/status [project]
    ./scripts/status --all
    ./scripts/status --sprint NAME
    ./scripts/status --json
    ./scripts/status --help

ARGUMENTS:
    project       Show status for specific project
    --all         Show all active sessions
    --sprint NAME Filter by sprint metadata
    --json        Output raw JSON from Tasks
    --help        Show this help

EXAMPLES:
    ./scripts/status              # Auto-detect active project
    ./scripts/status my-api       # Show my-api status
    ./scripts/status --all        # List all sessions
    ./scripts/status --sprint sprint-02-features
HELP
    exit 0
fi

PROJECT="${1:-}"
SPRINT_FILTER=""
JSON_OUTPUT=false
VIEW_MODE="grouped"   # V11.21: grouped (default) | verbose | raw

# Parse flags
while [[ $# -gt 0 ]]; do
    case $1 in
        --sprint)
            SPRINT_FILTER="$2"
            shift 2
            ;;
        --json)
            JSON_OUTPUT=true
            shift
            ;;
        --all)
            PROJECT="--all"
            shift
            ;;
        --verbose)
            VIEW_MODE="verbose"
            shift
            ;;
        --raw)
            VIEW_MODE="raw"
            shift
            ;;
        *)
            if [ -z "$PROJECT" ]; then
                PROJECT="$1"
            fi
            shift
            ;;
    esac
done

# Get task state file if it exists (synced by hook)
get_task_state() {
    local project="$1"
    local state_file="$SESSIONS_ROOT/$project/.task-state.json"
    if [ -f "$state_file" ]; then
        cat "$state_file"
    else
        echo "{}"
    fi
}

# Auto-detect active project from most recent .task-state.json
if [ -z "$PROJECT" ]; then
    STATE_FILE=$(find "$SESSIONS_ROOT" -name ".task-state.json" -mmin -60 2>/dev/null | head -1)
    if [ -n "$STATE_FILE" ]; then
        PROJECT=$(basename "$(dirname "$STATE_FILE")")
    fi
fi

# List all sessions
if [ "$PROJECT" == "--all" ]; then
    echo "=== Active Sessions ==="
    for dir in "$SESSIONS_ROOT"/*/; do
        [ -d "$dir" ] || continue
        name=$(basename "$dir")
        # Skip archive
        [ "$name" == ".archive" ] && continue

        state_file="$dir/.task-state.json"
        if [ -f "$state_file" ]; then
            completed=$(jq -r '.completed // 0' "$state_file" 2>/dev/null || echo "0")
            total=$(jq -r '.total // 0' "$state_file" 2>/dev/null || echo "0")
            phase=$(jq -r '.phase // "unknown"' "$state_file" 2>/dev/null || echo "unknown")
            modified=$(stat -c %Y "$state_file" 2>/dev/null || echo "0")
            ago=$(( ($(date +%s) - modified) / 60 ))
            echo "  $name: $phase ($completed/$total tasks, ${ago}m ago)"
        elif [ -f "$dir/spec.md" ]; then
            echo "  $name: no task state (spec.md exists)"
        fi
    done
    exit 0
fi

# Show specific project
if [ -z "$PROJECT" ]; then
    echo "No active project detected."
    echo "Usage: ./scripts/status <project>"
    echo "       ./scripts/status --all"
    exit 1
fi

SESSION_DIR="$SESSIONS_ROOT/$PROJECT"
SPEC_FILE="$SESSION_DIR/spec.md"
TASK_STATE="$SESSION_DIR/.task-state.json"

if [ ! -d "$SESSION_DIR" ]; then
    echo "Project '$PROJECT' not found"
    exit 1
fi

# JSON output mode
if [ "$JSON_OUTPUT" = true ]; then
    if [ -f "$TASK_STATE" ]; then
        cat "$TASK_STATE"
    else
        echo '{"error": "No task state found"}'
    fi
    exit 0
fi

echo "=== Session: $PROJECT ==="
echo ""

# Show task state
if [ -f "$TASK_STATE" ]; then
    echo "--- Progress ---"
    completed=$(jq -r '.completed // 0' "$TASK_STATE")
    pending=$(jq -r '.pending // 0' "$TASK_STATE")
    in_progress=$(jq -r '.in_progress // 0' "$TASK_STATE")
    blocked=$(jq -r '.blocked // 0' "$TASK_STATE")
    total=$(jq -r '.total // 0' "$TASK_STATE")
    phase=$(jq -r '.phase // "unknown"' "$TASK_STATE")

    echo "Phase: $phase"
    echo "Progress: $completed/$total completed"
    [ "$in_progress" -gt 0 ] && echo "In Progress: $in_progress"
    [ "$pending" -gt 0 ] && echo "Pending: $pending"
    [ "$blocked" -gt 0 ] && echo "Blocked: $blocked"

    # S1-T10 (#72, M6): one cost line from scripts/cost-ledger (S1-T9). A copy
    # at $METRICS_DIR/cost-ledger/$PROJECT.status.json younger than
    # V11_COST_STATUS_FRESH seconds (default 300) is used as is. Otherwise one `cost-ledger --by sprint --json` refresh runs at a time
    # per project: it is started only when the lock is free, else the call joins
    # the run in flight. Either way the wait is at most V11_COST_STATUS_TIMEOUT
    # seconds (1-3, default 3). The run is setsid-detached, so a late or
    # interrupted status call never kills it; it replaces the copy when it
    # finishes. An older copy is shown with its age and ignored once a day old.
    # Fail-open: no usable result reads "Cost: unavailable" and nothing else here
    # changes. The sprint is --sprint, else active_task_sprint, else the
    # commonest sprint among open tasks (in_progress first). The $ caveat is the
    # JSON's pricing.basis/scope. Honors V11_COST_STATUS=off.
    if [ "${V11_COST_STATUS:-on}" != "off" ]; then
        _CL_LINE=""
        if [[ "$PROJECT" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            _CL_BIN="${V11_COST_LEDGER:-$SCRIPT_DIR/cost-ledger}"
            _CL_DIR="${METRICS_DIR:-$HOME/.agent-metrics}/cost-ledger"
            _CL_CACHE="$_CL_DIR/${PROJECT}.status.json"
            _CL_LOCK="$_CL_DIR/.${PROJECT}.lock"
            _CL_WAIT="${V11_COST_STATUS_TIMEOUT:-3}"
            case "$_CL_WAIT" in [1-3]) ;; *) _CL_WAIT=3 ;; esac
            _CL_FRESH="${V11_COST_STATUS_FRESH:-300}"
            case "$_CL_FRESH" in ''|*[!0-9]*) _CL_FRESH=300 ;; esac
            _cl_age=$(( $(date +%s) - $(stat -c %Y "$_CL_CACHE" 2>/dev/null || echo 0) ))
            if [ "$_cl_age" -ge "$_CL_FRESH" ] && [ -x "$_CL_BIN" ] && mkdir -p "$_CL_DIR" 2>/dev/null; then
                # The lock is taken here, before the fork, and fd 9 is inherited
                # by the run, so it stays held until the run exits and the wait
                # below cannot miss it.
                { if flock -n 9; then
                    setsid bash -c 'tmp=$(mktemp "$3/.$2.XXXXXX") || exit 0
                        if timeout 300 "$1" "$2" --by sprint --json > "$tmp"; then mv -f "$tmp" "$4"; else rm -f "$tmp"; fi' \
                        _ "$_CL_BIN" "$PROJECT" "$_CL_DIR" "$_CL_CACHE" </dev/null >/dev/null 2>&1 &
                  fi; } 2>/dev/null 9>>"$_CL_LOCK" || true
                flock -w "$_CL_WAIT" "$_CL_LOCK" true 2>/dev/null || true
            fi
            if [ -f "$_CL_CACHE" ]; then
                _CL_LINE=$(CL_JSON="$_CL_CACHE" TASK_STATE_PATH="$TASK_STATE" CL_SPRINT="$SPRINT_FILTER" python3 - <<'PYEOF' 2>/dev/null || true
import json, os, time
from collections import Counter
from datetime import datetime

with open(os.environ["CL_JSON"], encoding="utf-8") as f:
    doc = json.load(f)
age = time.time() - datetime.fromisoformat(doc["generated_at"].replace("Z", "+00:00")).timestamp()
if doc.get("schema") != "cost-ledger/v1" or doc["filters"]["by"] != "sprint" or age > 86400:
    raise SystemExit(1)

sprint = os.environ.get("CL_SPRINT") or ""
if not sprint:
    try:
        with open(os.environ["TASK_STATE_PATH"], encoding="utf-8") as f:
            state = json.load(f)
    except Exception:
        state = {}
    sprint = state.get("active_task_sprint") or ""
    if sprint in ("null", "unknown"):
        sprint = ""
    tasks = [t for t in state.get("open_tasks") or [] if isinstance(t, dict)]
    for pool in ([t for t in tasks if t.get("status") == "in_progress"], tasks):
        if sprint:
            break
        counts = Counter((t.get("metadata") or {}).get("sprint") for t in pool)
        for bad in (None, "", "null", "unknown"):
            counts.pop(bad, None)
        if counts:
            sprint = counts.most_common(1)[0][0]

cap = doc["capture"]
line = f"Cost: ${doc['totals']['usd']:,.2f}"
if sprint:
    usd = [g["usd"] for g in doc["groups"] if g["key"] == sprint]
    line += f" (sprint {sprint}: ${sum(usd):,.2f})" if usd else f" (sprint {sprint}: n/a)"
line += f" · capture {cap['rate_str']}"
if cap["priced"] < cap["with_tokens"]:
    line += f" (priced {cap['priced']})"
pricing = doc.get("pricing") or {}
labels = {"api_list_price_equivalent": "API list-price equiv", "subagents_only": "subagents only"}
caveat = [labels.get(v, str(v).replace("_", " ")) for v in (pricing.get("basis"), pricing.get("scope")) if v]
line += " · " + (", ".join(caveat) if pricing.get("basis") else "basis unknown")
if age >= 60:
    line += f" · as of {int(age // 60)}m ago" if age < 3600 else f" · as of {age / 3600:.1f}h ago"
print(line)
PYEOF
)
            fi
        fi
        echo "${_CL_LINE:-Cost: unavailable}"
    fi
    echo ""

    # V11.21: Review-sibling grouping + plain-language summary line.
    # Reads open_tasks for tasks carrying metadata.review_of (review siblings) and
    # separates them from work tasks. Default view (grouped) shows a plain-language
    # one-liner above the work/review counters. --verbose adds telegraphic counts.
    # --raw skips grouping entirely.
    if [ "$VIEW_MODE" != "raw" ]; then
        REVIEW_STATS=$(jq -r '
            def is_review: (.metadata.review_of // "") != "" or
                           ((.metadata.agent // "") | startswith("adversarial-"));
            def parent_pending: (.metadata.parent_status // "") == "pending_parent";

            (.open_tasks // []) as $open
            | [$open[]] as $tasks
            | {
                work_pending:    [$tasks[] | select(is_review | not) | select(.status == "pending")] | length,
                work_in_prog:    [$tasks[] | select(is_review | not) | select(.status == "in_progress")] | length,
                review_waiting:  [$tasks[] | select(is_review)       | select(parent_pending)] | length,
                review_ready:    [$tasks[] | select(is_review)       | select(.status == "pending" and (parent_pending | not))] | length,
                review_in_prog:  [$tasks[] | select(is_review)       | select(.status == "in_progress")] | length,
                self_reviews:    (.task_artifacts // {} | [.[].self_review // empty] | length),
                adv_reviews:     (.task_artifacts // {} | [.[].review // empty]      | length)
              }
            | "\(.work_pending) \(.work_in_prog) \(.review_waiting) \(.review_ready) \(.review_in_prog) \(.self_reviews) \(.adv_reviews)"
        ' "$TASK_STATE" 2>/dev/null || echo "0 0 0 0 0 0 0")
        read -r work_pending work_in_prog review_waiting review_ready review_in_prog self_reviews adv_reviews <<< "$REVIEW_STATS"

        # Plain-language summary line — V11.21 INV-3 readable surface
        total_reviews=$((review_waiting + review_ready + review_in_prog))
        if [ "$total_reviews" -gt 0 ]; then
            # "blocking" = adversarial CRITICAL or HIGH from completed review siblings
            review_blocking=$(jq -r '
                def is_review: (.metadata.review_of // "") != "";
                (.open_tasks // []) as $open
                | [$open[]
                   | select(is_review)
                   | select(.status == "completed")
                   | (.metadata.artifacts.review.errors // [])
                   | map(select(.severity == "CRITICAL" or .severity == "HIGH"))
                   | length] | add // 0
            ' "$TASK_STATE" 2>/dev/null || echo 0)
            echo "Reviews: ${total_reviews} waiting, ${review_blocking} blocking"
        fi

        if [ "$VIEW_MODE" = "verbose" ]; then
            echo "  Work:    ${completed}/${total} (${work_in_prog} in-flight, ${work_pending} pending)"
            echo "  Reviews: self ${self_reviews}/${total}, adversarial ${adv_reviews}/${total} (${review_waiting} pending_parent, ${review_in_prog} in-flight)"
        fi
        echo ""
    fi

    # V11.28.1 (loop-audit): surface the DURABLE review-queue depth. The V11.21 "Reviews:"
    # line above reads in-band task-state siblings; the durable queue at
    # ~/.agent-metrics/review-queue/$PROJECT.jsonl is a separate ledger that silently piled
    # to 100s of undrained entries because drainage is a manual step nobody ran. Show the
    # open count so it can't grow invisibly. Drain: ./scripts/drain-review-queue $PROJECT.
    # S2-R4: the latest event per task_id wins (review-queue's own replay), and a parked
    # entry is counted apart: a drain never clears it, only `review-queue unpark` re-queues it.
    _RQ_FILE="${METRICS_DIR:-$HOME/.agent-metrics}/review-queue/${PROJECT}.jsonl"
    if [ -f "$_RQ_FILE" ]; then
        _RQ_OPEN=$(V11_RQ="$_RQ_FILE" python3 - <<'PYEOF' 2>/dev/null || echo "0 0 0"
import json, os
latest = {}
for line in open(os.environ["V11_RQ"], encoding="utf-8"):
    line = line.strip()
    if not line:
        continue
    try:
        r = json.loads(line)
    except Exception:
        continue
    tid = r.get("task_id")
    if not tid:
        continue
    latest[str(tid)] = r.get("ev")
s = list(latest.values())
print(s.count("pending"), s.count("done"), s.count("parked"))
PYEOF
)
        read -r _rq_open _rq_done _rq_parked <<< "$_RQ_OPEN"
        if [ "${_rq_open:-0}" -gt 0 ] || [ "${_rq_parked:-0}" -gt 0 ]; then
            _rq_warn=""
            [ "${_rq_open:-0}" -ge 20 ] && _rq_warn="  ⚠ drain: ./scripts/drain-review-queue $PROJECT"
            echo "Review queue (durable): ${_rq_open:-0} open, ${_rq_parked:-0} parked, ${_rq_done:-0} resolved${_rq_warn}"
            [ "${_rq_parked:-0}" -gt 0 ] && echo "  Parked entries are not drained: see scripts/review-queue dashboard $PROJECT; re-queue one with scripts/review-queue unpark $PROJECT TASK_ID"
            echo ""
        fi
    fi

    # improvements/10 (S1-C3): pre-scope dashboard line — surfaces adoption of the
    # S1-A1/A2 pre-scope advisory system (TaskCreate warns on missing/invalid/
    # oversized metadata.scope) directly on the status dashboard, mirroring the
    # durable review-queue line above. X = percent of OPEN (pending+in_progress)
    # tasks in .task-state.json's open_tasks carrying a valid metadata.scope
    # (small|medium|large). N = count of ev:"prescope" durable-ledger rows (S1-B2,
    # ~/.agent-metrics/ledger/$PROJECT.jsonl) whose task_id is still open. Omitted
    # (not "0%") when there are no open tasks, since a percentage is undefined —
    # matches the "graceful absence" handling used elsewhere in this script rather
    # than printing a misleading number. Honors V11_PRESCOPE_STATUS=off.
    if [ "${V11_PRESCOPE_STATUS:-on}" != "off" ]; then
        _PRESCOPE_LEDGER_FILE="${METRICS_DIR:-$HOME/.agent-metrics}/ledger/${PROJECT}.jsonl"
        _PRESCOPE_OUT=$(TASK_STATE_PATH="$TASK_STATE" LEDGER_PATH="$_PRESCOPE_LEDGER_FILE" \
            PRESCOPE_PROJECT="$PROJECT" PRESCOPE_LIB="$SCRIPT_DIR/lib" python3 - <<'PYEOF' 2>/dev/null || echo ""
import json, os, sys

state_path = os.environ["TASK_STATE_PATH"]
ledger_path = os.environ.get("LEDGER_PATH", "")

try:
    with open(state_path, encoding="utf-8") as f:
        state = json.load(f)
except Exception:
    state = {}

# improvements/18: open_tasks is now a list of self-describing records
# (each carrying its own task_id/session_uuid), not a dict keyed by bare
# task_id -- that shape silently collided across sessions sharing a project.
open_tasks = state.get("open_tasks") or []
total = len(open_tasks)
if total == 0:
    print("")
else:
    scoped = sum(
        1 for t in open_tasks
        if isinstance(t, dict) and (t.get("metadata") or {}).get("scope") in ("small", "medium", "large")
    )
    pct = round(scoped * 100 / total)

    open_ids = {t.get("task_id") for t in open_tasks if isinstance(t, dict)}
    n = 0
    # S2-T0b-3 (#113, review #19 C10): a prescope row counts when the task it
    # was written for is still open, keyed by identity, not by the bare id
    # (every TaskList of a resumed session reuses ids 1..N). A prescope row
    # fires inside its TaskCreate, before that task's `created`, so its task
    # is the first create of (session, id) at or after it (in its TaskList
    # epoch when stamped). An open record binds by the identity it carries,
    # its epoch (R1), else the latest create (scripts/lib/task_epoch.py).
    # Rollback: V11_TASK_RESOLVER=legacy (the bare-id count).
    tix = None
    if os.environ.get("V11_TASK_RESOLVER", "shared") != "legacy" and ledger_path and os.path.isfile(ledger_path):
        sys.dont_write_bytecode = True
        sys.path.insert(0, os.environ.get("PRESCOPE_LIB", ""))
        try:
            import task_epoch as te
            tix = te.TaskIndex.from_ledger(os.environ.get("PRESCOPE_PROJECT", ""), identities=[],
                                           metrics_dir=os.path.dirname(os.path.dirname(ledger_path)))
        except Exception:
            tix = None
    if tix is not None:
        open_idents, open_unbound = set(), set()
        for t in open_tasks:
            if not isinstance(t, dict):
                continue
            sess, tid = str(t.get("session_uuid") or ""), str(t.get("task_id") or "")
            ident, cl = None, tix.claims(sess, tid)
            ti = t.get("identity") if isinstance(t.get("identity"), dict) else {}
            if te.valid_identity(ti.get("subject_norm"), ti.get("create_seq")):
                ident = tix.alias((ti["subject_norm"], ti["create_seq"]))
            elif te.tl_epoch_of(t) is not None and cl:
                res = tix.resolve(sess, tid, epoch=te.tl_epoch_of(t))
                ident = res.identity if res.status == te.BOUND else None
            elif cl:
                ident = cl[-1].identity
            if ident is not None:
                open_idents.add(ident)
            else:
                open_unbound.add((sess, tid))
        for row in te.read_ledger(os.environ.get("PRESCOPE_PROJECT", ""),
                                  os.path.dirname(os.path.dirname(ledger_path))):
            if row.get("ev") != "prescope":
                continue
            sess, tle, tid = te.claim_key(row)
            pos = te.position(row)
            after = [c for c in tix.claims(sess, tid) if c.ev == "created" and c.pos >= pos]
            if tle is not None and any(c.tl_epoch == tle for c in after):
                after = [c for c in after if c.tl_epoch == tle]
            ident = after[0].identity if after else None
            if ident in open_idents or (ident is None and (sess, tid) in open_unbound):
                n += 1
        print(f"{pct} {n}")
        raise SystemExit(0)
    if ledger_path and os.path.isfile(ledger_path):
        try:
            with open(ledger_path, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        row = json.loads(line)
                    except Exception:
                        continue
                    if row.get("ev") == "prescope" and row.get("task_id") in open_ids:
                        n += 1
        except Exception:
            pass
    print(f"{pct} {n}")
PYEOF
)
        if [ -n "$_PRESCOPE_OUT" ]; then
            read -r _prescope_pct _prescope_n <<< "$_PRESCOPE_OUT"
            echo "Pre-scope: ${_prescope_pct}% scoped, ${_prescope_n} advisories open"
            echo ""
        fi
    fi

    # Improvement 16: artifact-on-complete consumer, shipped in the same change
    # as the hooks/sync-tasks producer (adoption HIGH, swarm review 2026-07-29:
    # a producer with no consumer repeats this repo's collect-heavy/consume-
    # light disease). Reports raw counts, not a percentage — there is
    # deliberately no ev row for the silent-pass case (would add ledger noise
    # on every clean completion), so a true "% of completions with evidence"
    # denominator doesn't exist. Honors V11_ARTIFACT_STATUS=off.
    if [ "${V11_ARTIFACT_STATUS:-on}" != "off" ]; then
        _ARTIFACT_LEDGER_FILE="${METRICS_DIR:-$HOME/.agent-metrics}/ledger/${PROJECT}.jsonl"
        if [ -f "$_ARTIFACT_LEDGER_FILE" ]; then
            _ARTIFACT_OUT=$(LEDGER_PATH="$_ARTIFACT_LEDGER_FILE" python3 - <<'PYEOF' 2>/dev/null || echo ""
import json, os

ledger_path = os.environ.get("LEDGER_PATH", "")
warn = 0
exempt = 0
if ledger_path and os.path.isfile(ledger_path):
    try:
        with open(ledger_path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                ev = row.get("ev")
                if ev == "artifact_warn":
                    warn += 1
                elif ev == "artifact_exempt":
                    exempt += 1
print(f"{warn} {exempt}")
PYEOF
)
            if [ -n "$_ARTIFACT_OUT" ]; then
                read -r _artifact_warn _artifact_exempt <<< "$_ARTIFACT_OUT"
                if [ "${_artifact_warn:-0}" -gt 0 ] 2>/dev/null || [ "${_artifact_exempt:-0}" -gt 0 ] 2>/dev/null; then
                    echo "Artifact evidence: ${_artifact_warn:-0} advisory(ies) recorded, ${_artifact_exempt:-0} exempt"
                    echo ""
                fi
            fi
        fi
    fi

    # W1-5: unattributed-findings.jsonl is a dead-letter file that nothing surfaced,
    # contradicting CLAUDE.md's "never silently dropped" claim for wave/swarm findings
    # that can't be mapped to an attribution_key. Always-print (mirrors the Progress
    # lines above) so a growing dead-letter count can't hide.
    _UF_FILE="${METRICS_DIR:-$HOME/.agent-metrics}/unattributed-findings.jsonl"
    _UF_COUNT=0
    [ -f "$_UF_FILE" ] && _UF_COUNT=$(wc -l < "$_UF_FILE" 2>/dev/null | tr -d '[:space:]')
    echo "Unattributed findings: ${_UF_COUNT:-0}"
    echo ""

    # v11-loop-keystone T4 ("Fix 2"): surface the improve-subagent calibration-
    # miss trigger, exactly parallel to the review-queue depth line above. The
    # check itself (dedup/cooldown, threshold read) lives in
    # scripts/check-improve-subagent-triggers — this only prints its output.
    # Silent when V11_IMPROVE_SUBAGENT_TRIGGER=off or when no agent crosses
    # the >50%/30d calibration-miss threshold.
    _CIST_OUT=$("$SCRIPT_DIR/check-improve-subagent-triggers" "$PROJECT" 2>/dev/null || true)
    if [ -n "$_CIST_OUT" ]; then
        echo "$_CIST_OUT"
        echo ""
    fi

    # Show active tasks
    active_task=$(jq -r '.active_task // empty' "$TASK_STATE")
    if [ -n "$active_task" ] && [ "$active_task" != "null" ]; then
        echo "--- Active Task ---"
        echo "$active_task"
        echo ""
    fi

    # Show recent completions
    recent=$(jq -r '.recent_completed // [] | .[:5] | .[]' "$TASK_STATE" 2>/dev/null)
    if [ -n "$recent" ]; then
        echo "--- Recent Completions ---"
        echo "$recent"
        echo ""
    fi

    # Sprint filter
    if [ -n "$SPRINT_FILTER" ]; then
        echo "--- Sprint: $SPRINT_FILTER ---"
        jq -r ".sprints[\"$SPRINT_FILTER\"] // \"No tasks in this sprint\"" "$TASK_STATE"
        echo ""
    fi
else
    echo "No task state found. Use TaskCreate to add tasks."
    echo ""
fi

# V11.27 T2: Retro flywheel sanity guard (read-only; NO auto-reset).
# The retro counter increments on every session-end CLOSE and is reset only by
# `scripts/v11-retro PROJECT --reset` after a retrospective runs. A counter far
# past threshold means the reset half of the flywheel (F4) was never wired/run —
# surface it loudly so the operator runs the retro or repairs the reset path.
# Threshold mirrors v11-retro (default 5). Honors V11_RETRO_SANITY_GUARD=off.
if [ "${V11_RETRO_SANITY_GUARD:-on}" != "off" ]; then
    RETRO_FILE="$SESSION_DIR/.retro-counter"
    if [ -f "$RETRO_FILE" ]; then
        RETRO_COUNT=$(tr -dc '0-9' < "$RETRO_FILE" 2>/dev/null || echo 0)
        RETRO_COUNT="${RETRO_COUNT:-0}"
        RETRO_LIMIT=$(( ${V11_RETRO_THRESHOLD:-5} * 10 ))
        if [ "$RETRO_COUNT" -gt "$RETRO_LIMIT" ]; then
            echo "--- Retro Flywheel ---"
            echo "⚠ retro flywheel likely broken (counter=$RETRO_COUNT ≫ 10× threshold, never reset)"
            echo "  Run: scripts/v11-retro $PROJECT  &&  scripts/v11-retro $PROJECT --reset"
            echo ""
        fi
    fi
fi

# V11.27 T3: A4 high_risk_history dead-gate legibility (read-only).
# Status-side mirror of the track-autonomy warn so an always-block A4 gate is
# visible at-a-glance, not only at tool-time. Honors V11_A4_DEADGATE_WARN=off.
if [ "${V11_A4_DEADGATE_WARN:-on}" != "off" ]; then
    AUTONOMY_FILE="$SESSION_DIR/.autonomy-state"
    if [ -f "$AUTONOMY_FILE" ]; then
        # V11.34.3: strip a display-form prefix ("A3" -> 3) and any float tail
        # before the integer test below. Inlined rather than delegated to
        # common.sh's v11_normalize_autonomy_level because this script does not
        # source the hook library; keep the two in sync if either changes.
        A_LEVEL=$(jq -r '.level // 0' "$AUTONOMY_FILE" 2>/dev/null || echo 0)
        A_LEVEL="${A_LEVEL#[Aa]}"; A_LEVEL="${A_LEVEL%%.*}"
        case "$A_LEVEL" in ''|*[!0-9]*) A_LEVEL=0 ;; esac
        HRH_LEN=$(jq -r '.high_risk_history // [] | length' "$AUTONOMY_FILE" 2>/dev/null || echo 0)
        if [ "${A_LEVEL:-0}" -ge 4 ] 2>/dev/null && [ "${HRH_LEN:-0}" -eq 0 ] 2>/dev/null; then
            echo "--- Autonomy ---"
            echo "⚠ A$A_LEVEL but high_risk_history empty — high-risk gate is effectively always-block (no auto-approve path)"
            echo ""
        fi
    fi
fi

# Show spec summary (intent only, no task list in V10)
if [ -f "$SPEC_FILE" ]; then
    echo "--- Spec Summary ---"
    # Show Intent and Stack sections only
    sed -n '/^## Intent/,/^## /p' "$SPEC_FILE" | head -10 || echo "(no intent found)"
    echo ""
fi

# Show related services (if docker available)
if command -v docker &> /dev/null; then
    RUNNING=$(docker ps --filter "name=$PROJECT" --format "{{.Names}}: {{.Status}}" 2>/dev/null)
    if [ -n "$RUNNING" ]; then
        echo "--- Docker Services ---"
        echo "$RUNNING"
        echo ""
    fi
fi

# Agent Teams status (V10)
TEAMS_DIR="$HOME/.claude/teams"
if [ -d "$TEAMS_DIR" ] && [ "$(ls -A "$TEAMS_DIR" 2>/dev/null)" ]; then
    echo ""
    echo "## Active Teams"
    for team_dir in "$TEAMS_DIR"/*/; do
        [ -d "$team_dir" ] || continue
        team_name=$(basename "$team_dir")
        member_count=$(ls "$team_dir" 2>/dev/null | wc -l)
        echo "  - $team_name ($member_count members)"
    done
fi

echo ""
echo "Updated: $(date -Iseconds)"
echo ""
echo "Tip: Use TaskList in Claude to see full task details"

# V11.21: First-run onboarding nudge — fires once per project when paired
# review siblings first appear in task-state. Marker prevents repeat firing.
if [ -f "$TASK_STATE" ] && [ "${V11_AUTO_PAIR_REVIEW:-on}" != "off" ]; then
    HAS_PAIRED=$(jq -r '
        [(.open_tasks // [])[] | select((.metadata.review_of // "") != "")] | length
    ' "$TASK_STATE" 2>/dev/null || echo 0)
    MARKER="$SESSIONS_ROOT/$PROJECT/.auto-pair-onboarded"
    if [ "${HAS_PAIRED:-0}" -gt 0 ] && [ ! -f "$MARKER" ]; then
        echo ""
        echo "[V11.21] Review siblings enabled — each work task now has a paired review task."
        echo "         See --verbose for the work/review breakdown. To disable: V11_AUTO_PAIR_REVIEW=off"
        # Set marker so the nudge fires once per project
        mkdir -p "$(dirname "$MARKER")" 2>/dev/null
        touch "$MARKER" 2>/dev/null || true
    fi
fi
