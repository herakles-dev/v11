    "swebench-solver": {
      "teammates": [
        "spec-architect-v11",
        "spec-implementer-v11",
        "spec-tester-v11"
      ],
      "roles": [
        "investigator",
        "implementer",
        "validator"
      ],
      "when": "SWE-bench Lite instance resolution — 3-wave pipeline with feedback loop",
      "mode": "sequential-waves",
      "wave_structure": [
        {
          "wave": 0,
          "role": "investigator",
          "output": "hypothesis + target_files + files_explored",
          "type": "agentic",
          "max_steps": 10
        },
        {
          "wave": 1,
          "role": "implementer",
          "output": "FIND/REPLACE patch"
        },
        {
          "wave": 2,
          "role": "validator",
          "output": "test pass/fail + error_log"
        }
      ],
      "max_iterations": 3,
      "feedback_loop": "validator → implementer (on test failure, up to max_iterations)",
      "cost_estimate": {
        "per_instance_tokens": 56000,
        "per_instance_usd": 0.17,
        "five_instance_usd": 0.4,
        "fifty_instance_usd": 4,
        "three_hundred_instance_usd": 25,
        "note": "Wave 0 agentic: ~10 tool calls x 2K tokens each; Wave 1+2: ~3 x 12K tokens"
      },
      "artifact_schema": {
        "investigator": [
          "hypothesis",
          "target_files",
          "complexity",
          "reasoning",
          "steps_used",
          "files_explored"
        ],
        "implementer": [
          "patch",
          "confidence",
          "reasoning"
        ],
        "validator": [
          "resolved",
          "f2p_tested",
          "f2p_passed",
          "error_log",
          "final_patch"
        ]
      },
      "tool_policies": {
        "defaults": {
          "profile": "coding",
          "deny": [
            "group:deploy"
          ]
        },
        "per_role": {
          "investigator": {
            "profile": "readonly"
          },
          "implementer": {
            "profile": "coding",
            "deny": [
              "group:deploy"
            ]
          },
          "validator": {
            "profile": "testing",
            "deny": [
              "Write",
              "Edit",
              "group:deploy"
            ]
          }
        }
      },
      "agents": [],
      "benchmark_script": "scripts/swe_v11.py",
      "baseline_script": "scripts/swe_claude_baseline.py",
      "output_dir": "swebench-predictions/v11-formation",
      "traces_dir": "swebench-predictions/v11-formation/trajs"
